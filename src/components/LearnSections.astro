---
// หน้าความรู้ (ชันโรงขนเงิน / น้ำผึ้งชันโรง): แต่ละหัวข้อ ## ใน Markdown เป็นหนึ่งส่วนของหน้า
// frontmatter `sections` บอกว่าหัวข้อไหนมีรูป (สลับซ้าย-ขวาบนคอม) · กรอบเน้นสีเขียว (highlight) · กรอบข้อควรรู้ (notice)
// `slot: ชื่อ` = วางเนื้อหาจากหน้า (<Fragment slot="ชื่อ">) ข้างข้อความ เช่น การ์ดสินค้า ตัวเลขฟาร์ม
import CreditPhoto from './CreditPhoto.astro';
import Icon from './Icon.astro';
import type { MdSection } from '../lib/content.ts';
import { learnPhotos } from '../lib/learn-photos.ts';

export interface SectionCfg {
  heading: string;
  photo?: keyof typeof learnPhotos;
  style?: 'highlight' | 'notice';
  slot?: string;
}
interface Props {
  sections: MdSection[];
  config?: SectionCfg[];
}
const { sections, config = [] } = Astro.props;
let sideCount = 0;
const items = [];
for (const s of sections) {
  const cfg: SectionCfg = config.find((c) => s.title.startsWith(c.heading)) ?? { heading: s.title };
  const photo = cfg.photo ? learnPhotos[cfg.photo] : undefined;
  const aside = !photo && cfg.slot && Astro.slots.has(cfg.slot) ? await Astro.slots.render(cfg.slot) : '';
  const side = !!(photo || aside);
  // รูปสลับซ้าย-ขวาเฉพาะส่วนที่มีของข้างข้อความ
  const flip = side ? sideCount++ % 2 === 1 : false;
  items.push({ s, cfg, photo, aside, side, flip });
}
---

<div class="mt-12 space-y-14 md:space-y-20">
  {items.map(({ s, cfg, photo, aside, side, flip }) => (
    <section id={s.id} aria-labelledby={`${s.id}-h`} class:list={[
      'scroll-mt-24',
      cfg.style === 'highlight' && 'rounded-3xl bg-palm-50 p-5 sm:p-8 md:p-10',
      cfg.style === 'notice' && 'rounded-3xl border-2 border-honey-400 bg-honey-50 p-5 sm:p-8',
      side && 'grid items-center gap-6 lg:grid-cols-2 lg:gap-12',
    ]}>
      <div class:list={['min-w-0', flip && 'lg:order-2']}>
        <h2 id={`${s.id}-h`} class="flex items-start gap-3 text-2xl font-bold leading-snug text-palm-900 md:text-3xl">
          {cfg.style === 'notice' && <Icon name="info" class="mt-1 size-7 shrink-0 text-honey-700" />}
          <span set:html={s.titleHtml} />
        </h2>
        <div class="prose-mf mt-4" set:html={s.html} />
      </div>
      {photo && <CreditPhoto crop photo={photo} sizes="(min-width: 1024px) 480px, 100vw" class:list={[flip && 'lg:order-1']} />}
      {aside && <div class:list={['min-w-0', flip && 'lg:order-1']} set:html={aside} />}
    </section>
  ))}
</div>
