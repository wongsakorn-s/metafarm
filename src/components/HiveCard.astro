---
import { formatPrice } from '../lib/products.ts';
import { formatThaiDate } from '../lib/thai-date.ts';
import { placeholder } from '../lib/placeholders.ts';
import { photoSrcset } from '../lib/media.ts';
import { originText } from '../lib/labels.ts';
import { site } from '../config/site.ts';
import type { SaleHiveCard } from '../server/public.ts';

interface Props { hive: SaleHiveCard; /** รูปที่เห็นทันทีเมื่อเปิดหน้า (ไม่ lazy) */ eager?: boolean }
const { hive, eager = false } = Astro.props;
const origin = originText(hive.origin, hive.province, site.name);
---

<a href={`/products/hives/${hive.code}`} class="card-link overflow-hidden !p-0">
  <img src={hive.coverKey ? `/img/${hive.coverKey}` : placeholder.hive} srcset={hive.coverKey ? photoSrcset(`/img/${hive.coverKey}`) : undefined} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" alt={`รังชันโรงขนเงิน ${hive.code}`} loading={eager ? 'eager' : 'lazy'} width="800" height="600" class="aspect-[4/3] w-full bg-palm-50 object-cover" />
  <div class="p-4">
    <div class="flex items-baseline justify-between gap-2">
      <h3 class="text-lg font-bold">รัง {hive.code}</h3>
      <p data-num class="text-xl font-bold text-palm-700">{formatPrice(hive.priceThb)}</p>
    </div>
    <p class="text-sm text-muted">{hive.species}{origin ? ` · ${origin}` : ''}</p>
    {hive.queenBornOn && <p class="text-sm text-muted">นางพญาเกิด {formatThaiDate(hive.queenBornOn)}</p>}
  </div>
</a>
