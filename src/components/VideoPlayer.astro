---
// วิดีโอบนหน้าสาธารณะ: ไฟล์ของฟาร์ม (/video/*) เล่นในหน้าเลย (แตะเพื่อเล่น ไม่เล่นเอง ไม่โหลดทั้งไฟล์ล่วงหน้า) หรือฝัง YouTube (โหมดความเป็นส่วนตัว)
import type { PublicVideo } from '../server/public.ts';
import { posterKeyOf } from '../lib/video.ts';

/** ambient = เล่นเองแบบไม่มีเสียง วนซ้ำ ไม่มีแถบควบคุม มีปุ่มเปิด/ปิดเสียงปุ่มเดียว (ใช้กับวิดีโอแนะนำหน้าแรก; YouTube ใช้แบบปกติ) */
interface Props { video: PublicVideo; title: string; class?: string; ambient?: boolean }
const { video, title, class: cls = '', ambient = false } = Astro.props;
---

{video.key && ambient ? (
  <div class="relative" data-ambient>
    <video class={['block w-full max-h-[75svh] rounded-2xl bg-black', cls].join(' ')} muted loop autoplay playsinline preload="auto" poster={`/video/${posterKeyOf(video.key)}`} aria-label={title}>
      <source src={`/video/${video.key}`} type="video/mp4" />
    </video>
    <button type="button" data-sound aria-pressed="false" aria-label="เปิดเสียงวิดีโอ" class="absolute bottom-3 right-3 grid size-11 place-items-center rounded-full bg-black/60 text-white backdrop-blur hover:bg-black/75 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
      <svg data-off xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="m22 9-6 6M16 9l6 6" /></svg>
      <svg data-on xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="hidden size-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z" /><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14" /></svg>
    </button>
  </div>
) : video.key ? (
  // วิดีโอไฟล์: คงสัดส่วนจริงของคลิป (แนวตั้ง/จัตุรัสไม่โดนบีบหรือมีแถบดำใหญ่) แต่ไม่สูงเกินจอ
  <video class={['block w-full max-h-[75svh] rounded-2xl bg-black', cls].join(' ')} controls playsinline preload="metadata" poster={`/video/${posterKeyOf(video.key)}`} aria-label={title}>
    <source src={`/video/${video.key}`} type="video/mp4" />
    เบราว์เซอร์นี้เล่นวิดีโอไม่ได้
  </video>
) : (
  <div class:list={['aspect-video overflow-hidden rounded-2xl bg-black', cls]}>
    <iframe class="size-full" src={`https://www.youtube-nocookie.com/embed/${video.youtubeId}`} title={title} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </div>
)}
{video.youtubeId && <p class="hint"><a class="underline" href={`https://www.youtube.com/watch?v=${video.youtubeId}`} target="_blank" rel="noopener noreferrer">เปิดใน YouTube</a></p>}

<script>
  // วิดีโอเล่นเอง (ไม่มีเสียง): เล่นเฉพาะตอนเห็นบนจอ · แตะที่ภาพเพื่อหยุด/เล่น · ถ้าเบราว์เซอร์ห้ามเล่นเอง หรือผู้ใช้ตั้งลดการเคลื่อนไหว → แสดงแถบควบคุมปกติแทน
  for (const box of document.querySelectorAll<HTMLElement>('[data-ambient]')) {
    const v = box.querySelector('video')!;
    const btn = box.querySelector<HTMLButtonElement>('[data-sound]')!;
    const showControls = () => { v.controls = true; v.removeAttribute('loop'); btn.hidden = true; };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { v.pause(); v.removeAttribute('autoplay'); showControls(); continue; }
    const play = () => v.play().catch(showControls);
    new IntersectionObserver(([e]) => { if (userPaused) return; if (e!.isIntersecting) play(); else v.pause(); }, { threshold: 0.4 }).observe(v);
    let userPaused = false;
    v.addEventListener('click', () => { userPaused = !v.paused; if (v.paused) play(); else v.pause(); });
    btn.addEventListener('click', () => {
      v.muted = !v.muted;
      btn.setAttribute('aria-pressed', String(!v.muted));
      btn.setAttribute('aria-label', v.muted ? 'เปิดเสียงวิดีโอ' : 'ปิดเสียงวิดีโอ');
      btn.querySelector('[data-off]')!.classList.toggle('hidden', !v.muted);
      btn.querySelector('[data-on]')!.classList.toggle('hidden', v.muted);
      if (v.paused && !userPaused) play();
    });
  }
</script>
