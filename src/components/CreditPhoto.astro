---
// ภาพประกอบพร้อมเครดิต (ผู้ถ่าย · สัญญาอนุญาต · ลิงก์ต้นทาง) — ดู src/lib/learn-photos.ts
import { LICENSE_URL, type LearnPhoto } from '../lib/learn-photos.ts';

interface Props {
  photo: LearnPhoto;
  /** ภาพแรกของหน้า: โหลดทันที */
  priority?: boolean;
  /** ความกว้างที่แสดงโดยประมาณ (สำหรับ sizes) */
  sizes?: string;
  class?: string;
  /** แกลเลอรี: ตัดทุกภาพเป็น 4:3 ให้แถวเท่ากัน (ภาพแนวตั้งถูกตัดบน-ล่าง) */
  crop?: boolean;
}
const { photo: p, priority = false, sizes = '(min-width: 1024px) 60vw, 100vw', class: cls, crop = false } = Astro.props;
const src = (w: number) => `/photos/learn/${p.id}-${w}.webp`;
---

<figure class:list={['overflow-hidden rounded-3xl border border-line bg-surface', cls]}>
  <img src={src(1200)} srcset={`${src(640)} 640w, ${src(1200)} 1200w`} sizes={sizes} width={p.w} height={p.h} alt={p.alt}
    loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async"
    class:list={['w-full bg-palm-50 object-cover', p.h > p.w && !crop ? 'aspect-[4/5]' : 'aspect-[4/3]']} />
  <figcaption class="space-y-1 p-3 text-sm">
    <span class="block">{p.caption}</span>
    <span class="block text-[0.8125rem] text-muted">ภาพประกอบ: <a class="underline" href={p.sourceUrl} rel="noopener" target="_blank">{p.author}</a> · <a class="underline" href={LICENSE_URL[p.license]} rel="noopener license" target="_blank">{p.license}</a> · Wikimedia Commons</span>
  </figcaption>
</figure>
