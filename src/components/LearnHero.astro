---
// หัวหน้าความรู้: ข้อความ + ปุ่ม ด้านซ้าย รูปด้านขวา (คอม) · มือถือ: ข้อความก่อน รูปตามมา
// ใต้หัว: ข้อเท็จจริงสั้น ๆ (frontmatter `facts`) และชิป "ในหน้านี้" กระโดดไปแต่ละหัวข้อ
import CreditPhoto from './CreditPhoto.astro';
import Icon from './Icon.astro';
import type { MdSection } from '../lib/content.ts';
import type { IconName } from '../lib/icons.ts';
import type { LearnPhoto } from '../lib/learn-photos.ts';

export interface Fact {
  icon: IconName;
  title: string;
  text: string;
}
interface Props {
  eyebrow: string;
  eyebrowIcon: IconName;
  title: string;
  subtitle?: string;
  lead: string;
  photo: LearnPhoto;
  facts?: Fact[];
  sections?: MdSection[];
}
const { eyebrow, eyebrowIcon, title, subtitle, lead, photo, facts = [], sections = [] } = Astro.props;
---

<header class="grid items-center gap-8 lg:grid-cols-[1fr_1.1fr] lg:gap-12">
  <div>
    <p class="inline-flex items-center gap-2 rounded-full bg-palm-50 px-3 py-1 text-sm font-medium text-palm-700">
      <Icon name={eyebrowIcon} class="size-4" />{eyebrow}
    </p>
    <h1 class="mt-3 text-[2rem] font-bold leading-tight text-palm-900 sm:text-4xl md:text-5xl">{title}</h1>
    {subtitle && <p class="mt-1 italic text-muted">{subtitle}</p>}
    <p class="mt-4 text-lg leading-relaxed">{lead}</p>
    <div class="mt-6 flex flex-wrap gap-3"><slot /></div>
  </div>
  <CreditPhoto photo={photo} priority sizes="(min-width: 1024px) 560px, 100vw" />
</header>

{/* ข้อมูลน่ารู้: มือถือ 2 คอลัมน์ (จำนวนคี่: ใบสุดท้ายเต็มแถว) · คอม 3–4 คอลัมน์ */}
{facts.length > 0 && (
  <ul class:list={['mt-8 grid grid-cols-2 gap-3 md:mt-10 md:gap-4 max-lg:[&>li:last-child:nth-child(odd)]:col-span-2', facts.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3']} aria-label="ข้อมูลน่ารู้">
    {facts.map((f) => (
      <li class="card flex flex-col gap-2 md:gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-palm-50 text-palm-700 md:size-12 md:rounded-2xl"><Icon name={f.icon} class="size-5 md:size-6" /></span>
        <span>
          <span class="block font-semibold">{f.title}</span>
          <span class="mt-0.5 block text-sm text-muted md:text-[0.9375rem]">{f.text}</span>
        </span>
      </li>
    ))}
  </ul>
)}

{sections.length >= 3 && (
  <nav aria-label="ในหน้านี้" class="mt-8">
    <p class="text-sm font-semibold text-muted">ในหน้านี้</p>
    <ul class="scroll-fade -mx-4 mt-2 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:flex-wrap md:overflow-visible md:px-0 md:[mask-image:none]">
      {sections.map((s) => (
        <li class="shrink-0"><a class="inline-flex min-h-11 items-center rounded-full border border-line bg-surface px-4 text-[0.9375rem] text-palm-700 transition-colors duration-(--duration-fast) hover:border-palm-500 hover:bg-palm-50" href={`#${s.id}`}>{s.title}</a></li>
      ))}
    </ul>
  </nav>
)}
