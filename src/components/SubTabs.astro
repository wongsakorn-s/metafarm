---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons.ts';

export interface TabItem {
  key: string;
  href: string;
  icon: IconName;
  short: string;
  label: string;
  count?: number;
}

interface Props {
  label: string;
  active: string;
  tabs: readonly TabItem[] | TabItem[];
}

const { label, active, tabs } = Astro.props;
const gridCols = tabs.length === 2 ? 'grid-cols-2' : tabs.length === 3 ? 'grid-cols-3' : 'grid-cols-4';
---

<nav aria-label={label} class:list={['-mt-1 mb-4 grid border-b border-line md:flex md:gap-1', gridCols]}>
  {tabs.map((t) => (
    <a
      href={t.href}
      aria-current={active === t.key ? 'page' : undefined}
      class:list={[
        '-mb-px flex min-h-14 flex-col items-center justify-center gap-0.5 border-b-2 px-1 text-xs font-medium md:min-h-11 md:flex-row md:gap-2 md:px-3 md:text-base',
        active === t.key ? 'border-palm-600 text-palm-700' : 'border-transparent text-muted hover:text-ink',
      ]}
    >
      <Icon name={t.icon} class="size-5 md:size-4" />
      <span class="inline-flex items-center gap-1">
        <span class="md:hidden">{t.short}</span>
        <span class="hidden md:inline">{t.label}</span>
        {typeof t.count === 'number' && t.count > 0 && (
          <span class="rounded-full bg-honey-100 px-1.5 py-0.5 text-[11px] font-bold text-honey-700">{t.count}</span>
        )}
      </span>
    </a>
  ))}
</nav>
