---
import ContactButtons from './ContactButtons.astro';
import { channelName, contactActions } from '../lib/contact.ts';
import { SHIPPING_NOTE } from '../lib/products.ts';

// ขั้นตอนสั่งซื้อ/สมัครอบรม — ทักแชต (LINE/Messenger) หรือโทร ตามช่องทางที่เจ้าของเปิดไว้ (ช่องทางหลักก่อน)
// kind="training" ใช้ถ้อยคำของหลักสูตร ไม่ใช่การซื้อสินค้า
// buttons={false}: หน้าที่มีปุ่มสั่งซื้อของตัวเองอยู่แล้ว (หน้าสินค้า/รังที่ขาย) — แสดงแค่ขั้นตอน ไม่ซ้ำปุ่ม
interface Props { message?: string; kind?: 'order' | 'training'; buttons?: boolean }
const { kind = 'order', buttons = true, message = kind === 'training' ? 'สนใจหลักสูตรอบรม' : 'สนใจสั่งซื้อสินค้า' } = Astro.props;
const channels = contactActions(Astro.locals.settings!.contact, message).map((a) => channelName[a.channel]);
// เจ้าของเรียกช่องทางนี้ว่า "Facebook" (ทักข้อความหาโปรไฟล์ แล้วคุยต่อใน Messenger)
const named = channels.map((c) => (c === channelName.messenger ? 'Facebook' : c));
const via = named.length ? named.join(' / ') : 'ช่องทางติดต่อ';
const primaryVia = named[0] ?? 'ช่องทางติดต่อ';
const copy = {
  // สั่งซื้อ (ถ้อยคำของเจ้าของฟาร์ม 2026-10-10): ทักข้อความเป็นหัวข้อ แล้วเหลือ 2 ขั้น
  order: {
    title: 'วิธีสั่งซื้อ',
    lead: `ทักข้อความผ่าน ${primaryVia}`,
    steps: [
      ['ยืนยันรายละเอียด', 'แจ้งรายละเอียดสินค้าที่ต้องการ'],
      ['ชำระเงินและรับสินค้า', `สินค้าจะจัดส่งให้หลังลูกค้าชำระเงิน (ราคา${SHIPPING_NOTE})`],
    ],
  },
  training: {
    title: 'วิธีสมัครอบรม',
    lead: '',
    steps: [
      ['ทักแชตหรือโทร', `ติดต่อทาง ${via} บอกหลักสูตรที่สนใจ`],
      ['เลือกรอบอบรม', 'แจ้งวันที่สะดวกและจำนวนผู้เรียน ฟาร์มจะยืนยันรอบและค่าอบรม'],
      ['ชำระเงินและมาเรียนที่ฟาร์ม', 'ชำระค่าอบรมตามที่ตกลง แล้วมาเรียนที่ฟาร์มตามวันนัด'],
    ],
  },
}[kind];
---

<section class="rounded-3xl bg-palm-50 p-6" aria-labelledby="order-h">
  <h2 id="order-h" class="text-xl font-bold text-palm-900">{copy.title}</h2>
  {copy.lead && <p class="mt-1 font-semibold">{copy.lead}</p>}
  <ol class:list={['mt-3 grid gap-3', copy.steps.length === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3']}>
    {copy.steps.map(([t, d], i) => (
      <li class="flex gap-3">
        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-palm-600 font-bold text-white" aria-hidden="true">{i + 1}</span>
        <div><p class="font-semibold">{t}</p><p class="text-sm text-muted">{d}</p></div>
      </li>
    ))}
  </ol>
  {buttons && <ContactButtons class="mt-4" intent={kind === 'training' ? 'training' : 'order'} message={message} />}
</section>
