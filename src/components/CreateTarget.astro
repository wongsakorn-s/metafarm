---
// รังปลายทาง (แยกรัง/ไข่นางพญา) ยังไม่มีในทะเบียน → ปุ่มสร้างรังนั้นจากรังนี้ (กรอกรหัส ที่มา รังแม่ และวันที่ไว้ให้)
// ระบบบันทึกการแยกในรังแม่ให้เองตอนสร้างรัง (createHive) — จึงบอกให้ไม่ต้องกลับมาบันทึกซ้ำ (กันนับการแยกรังสองครั้ง)
interface Props {
  t: { code: string; href: string } | null;
  /** รังแม่ (รังที่กำลังบันทึก) */
  from: string;
}
const { t, from } = Astro.props;
---

{t && (
  <div class="rounded-xl bg-honey-50 p-3">
    <p class="text-sm">รัง <strong>{t.code}</strong> ยังไม่มีในทะเบียน — ถ้าเป็นกล่องใหม่ ลงทะเบียนได้เลย</p>
    <a class="btn-primary mt-2 w-full" href={t.href}>สร้างรัง {t.code} (แยกจาก {from})</a>
    <p class="hint">ระบบบันทึกการแยกในรัง {from} ให้เอง ไม่ต้องกลับมาบันทึกซ้ำ</p>
  </div>
)}
