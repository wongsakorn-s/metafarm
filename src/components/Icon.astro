---
// ไอคอนชุดเดียวทั้งเว็บ (Lucide) — ตารางชื่ออยู่ที่ src/lib/icons.ts
// SVG ถูกฝังลงหน้าเว็บตอน build (ไม่มี JavaScript เพิ่ม) และ bundle เฉพาะไอคอนที่อยู่ในรายชื่อด้านล่าง
import { ICONS, type IconName } from '../lib/icons.ts';

// โหลดเฉพาะไฟล์ที่ระบุ (รายชื่อต้องตรงกับค่าในตาราง ICONS) — ไม่ดึงไอคอนทั้ง 2,000 ตัวเข้ามา
const files = import.meta.glob<string>(
  '/node_modules/lucide-static/icons/{layout-dashboard,hexagon,plus,shopping-cart,menu,chevron-left,chevron-right,x,house,search,search-x,log-out,globe,droplets,crown,egg,sticky-note,refresh-cw,notebook-tabs,book-open,graduation-cap,trees,sprout,camera,image,video,square-pen,pencil,tag,trash-2,rotate-ccw,settings,key-round,lock,list-checks,message-circle,phone,map-pin,map,thumbs-up,circle-check,triangle-alert,circle-alert,circle-help,info,circle-dashed,party-popper,cloud-rain,thermometer,chart-column,receipt,users,copy,wallet,truck,ban,trending-up,download,messages-square}.svg',
  { query: '?raw', import: 'default', eager: true },
);

interface Props {
  name: IconName;
  class?: string;
  /** ใส่เมื่อไอคอนมีความหมายเอง (ไม่มีข้อความกำกับข้าง ๆ) — ไม่ใส่ = ไอคอนตกแต่ง ซ่อนจากโปรแกรมอ่านหน้าจอ */
  label?: string;
}
const { name, class: cls = 'size-6', label } = Astro.props;
const raw = files[`/node_modules/lucide-static/icons/${ICONS[name]}.svg`];
if (!raw) throw new Error(`ไม่พบไอคอน ${name} (${ICONS[name]}) — เพิ่มชื่อไฟล์ใน import.meta.glob ของ Icon.astro`);
const inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
---

<svg class:list={['shrink-0', cls]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
  focusable="false" aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} set:html={inner} />
