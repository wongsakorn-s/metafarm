---
import '../styles/global.css';
import { site } from '../config/site.ts';
import { lineChatUrl, telHref } from '../lib/settings.ts';
import { ldJson } from '../lib/seo.ts';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  /** ข้อความที่จะใส่ในแชต LINE เมื่อกดปุ่มลอย (เช่น "สนใจรัง A25") */
  lineMessage?: string;
  active?: 'home' | 'stingless-bee' | 'honey' | 'products' | 'training' | 'passport' | 'contact';
  noindex?: boolean;
  /** พาธหลักของหน้า (เช่น /passport/A25) — ใช้เมื่อ URL ที่เข้ามาอาจต่างกัน */
  canonical?: string;
  /** รูปตอนแชร์ลิงก์ (พาธหรือ URL เต็ม) — ไม่ใส่ = โลโก้ฟาร์ม */
  ogImage?: string;
  /** ข้อมูลโครงสร้างสำหรับ Google (สร้างด้วย src/lib/seo.ts) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = site.description, lineMessage, active, noindex = false, canonical, ogImage: ogImageProp, jsonLd } = Astro.props;

const fullTitle = title === site.name ? `${site.name} · ${site.tagline}` : `${title} · ${site.name}`;
const ogImage = new URL(ogImageProp ?? '/brand/og.jpg', Astro.url).href;
const pageUrl = new URL(canonical ?? Astro.url.pathname, Astro.url.origin).href;
const c = Astro.locals.settings!.contact;
const line = lineChatUrl(c, lineMessage);
const tel = telHref(c.phone);

const nav = [
  { key: 'home', href: '/', label: 'หน้าแรก', icon: '🏡' },
  { key: 'stingless-bee', href: '/stingless-bee', label: 'ชันโรงขนเงิน', icon: '🐝' },
  { key: 'honey', href: '/honey', label: 'น้ำผึ้ง', icon: '🍯' },
  { key: 'products', href: '/products', label: 'สินค้า', icon: '🛒' },
  { key: 'training', href: '/training', label: 'อบรม', icon: '📚' },
  { key: 'passport', href: '/passport', label: 'สมุดพกรัง', icon: '📒' },
  { key: 'contact', href: '/contact', label: 'ติดต่อเรา', icon: '📍' },
] as const;
const current = nav.find((n) => n.key === active);
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b7a3e" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!ogImageProp && <meta property="og:image:width" content="1200" />}
    {!ogImageProp && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />
    {/* หน้า noindex (เช่น 404) ไม่ต้องมี canonical */}
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <meta property="og:url" content={pageUrl} />
    {jsonLd && !noindex && <script type="application/ld+json" set:html={ldJson(jsonLd)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={['flex min-h-dvh flex-col', (line || tel) && 'pb-[calc(4.5rem+env(safe-area-inset-bottom))] md:pb-0']}>
    {!c.confirmed && (
      <p class="bg-honey-400 px-4 py-1.5 text-center text-sm font-medium text-ink" role="note">
        ⚠️ ช่องทางติดต่อเป็น<strong>ข้อมูลตัวอย่าง</strong><span class="hidden sm:inline"> (เว็บกำลังจัดทำ)</span>
      </p>
    )}

    {/* หัวเว็บ: มือถือ = แถวเดียว (โลโก้ + ปุ่มเมนู) · คอม = เมนูแนวนอนเต็ม
        เดิมมือถือมีเมนู 7 รายการเลื่อนข้าง ตัวท้าย ๆ ถูกตัด ("สมุด…") และหัวเว็บสูง 2 แถว */}
    <header class="sticky top-0 z-30 border-b border-line bg-surface/95 backdrop-blur">
      <div class="relative mx-auto flex max-w-5xl items-center justify-between gap-6 px-4 py-2 md:py-3">
        <a href="/" class="flex min-h-11 min-w-11 items-center" aria-label={`${site.name} หน้าแรก`}>
          <img src="/brand/logo.webp" alt={site.name} width="140" height="38" class="h-9 w-auto" />
        </a>
        <nav aria-label="เมนูหลัก" class="hidden md:flex md:gap-1">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
              class:list={['flex min-h-11 shrink-0 items-center whitespace-nowrap rounded-xl px-3 font-medium', active === n.key ? 'bg-palm-50 text-palm-700' : 'text-ink hover:bg-canvas']}>{n.label}</a>
          ))}
        </nav>
        {/* เมนูมือถือ: <details> เปิด/ปิดได้แม้ไม่มี JavaScript */}
        <details class="group md:hidden" data-site-menu>
          <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-xl border border-line px-3 font-medium [&::-webkit-details-marker]:hidden" data-menu-toggle>
            <span class="group-open:hidden"><Icon name="menu" class="size-5" /></span>
            <span class="hidden group-open:inline"><Icon name="close" class="size-5" /></span>
            <span>{current && current.key !== 'home' ? current.label : 'เมนู'}</span>
          </summary>
          <div class="absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-line bg-surface shadow-lg">
            <nav aria-label="เมนูหลัก (มือถือ)" class="px-4 py-2">
              <ul class="divide-y divide-line">
                {nav.map((n) => (
                  <li>
                    <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
                      class:list={['flex min-h-13 items-center gap-3 rounded-xl px-2 text-lg', active === n.key ? 'font-semibold text-palm-700' : 'text-ink active:bg-canvas']}>
                      <span class="w-7 text-center" aria-hidden="true">{n.icon}</span><span class="flex-1">{n.label}</span>
                      {active === n.key && <span class="size-2 rounded-full bg-palm-600" aria-hidden="true"></span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </details>
      </div>
    </header>

    <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-6 md:py-10"><slot /></main>

    <footer class="border-t border-line bg-surface">
      <div class="mx-auto grid max-w-5xl gap-6 px-4 py-8 md:grid-cols-2">
        <div>
          <img src="/brand/logo-round-sm.webp" alt="" width="72" height="67" class="mb-3 h-[67px] w-[72px] object-contain" loading="lazy" />
          <p class="font-semibold">{site.name} <span class="font-normal text-muted">· {site.tagline}</span></p>
          <p class="text-sm text-muted">{site.address}</p>
          <p class="mt-2 text-sm text-muted">เลี้ยงชันโรงขนเงินในรังไม้สักที่ออกแบบเองตั้งแต่ปี พ.ศ. {site.foundedYearBE}</p>
        </div>
        <div>
          <h2 class="mb-2 font-semibold">ติดต่อเรา</h2>
          <ul class="text-sm">
            {line && <li><a class="inline-flex min-h-11 items-center text-palm-700 underline" href={line} rel="noopener">LINE: {c.lineId}</a></li>}
            {tel && <li><a class="inline-flex min-h-11 items-center text-palm-700 underline" href={tel}>โทร {c.phone}</a></li>}
            {c.facebookUrl && <li><a class="inline-flex min-h-11 items-center text-palm-700 underline" href={c.facebookUrl} rel="noopener noreferrer">Facebook</a></li>}
            {c.mapUrl && <li><a class="inline-flex min-h-11 items-center text-palm-700 underline" href={c.mapUrl} rel="noopener noreferrer">แผนที่ฟาร์ม</a></li>}
          </ul>
        </div>
      </div>
      <p class="border-t border-line py-1 text-center text-xs text-muted">© {site.name} · สงวนลิขสิทธิ์ · <a class="inline-flex min-h-11 items-center underline" href="/privacy">นโยบายความเป็นส่วนตัว</a></p>
    </footer>

    {/* ติดต่อ: มือถือ = แถบล่างเต็มความกว้าง (ไม่ลอยทับเนื้อหา) · คอม = ปุ่มลอยมุมขวา */}
    {line && (
      <a href={line} rel="noopener" aria-label="ทักไลน์สอบถาม"
        class="fixed bottom-4 right-4 z-20 hidden min-h-12 items-center gap-2 rounded-full bg-[#05803a] px-5 font-semibold text-white shadow-lg transition hover:brightness-95 md:inline-flex">
        <Icon name="line" class="size-5" /> ทักไลน์
      </a>
    )}
    {(line || tel) && (
      <div class="fixed inset-x-0 bottom-0 z-20 border-t border-line bg-surface/95 px-3 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] backdrop-blur md:hidden">
        <div class:list={['mx-auto grid max-w-md gap-2', line && tel ? 'grid-cols-[1fr_auto]' : 'grid-cols-1']}>
          {line && <a href={line} rel="noopener" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl bg-[#05803a] font-semibold text-white active:brightness-95"><Icon name="line" class="size-5" /> ทักไลน์สอบถาม</a>}
          {tel && <a href={tel} class="inline-flex min-h-12 items-center justify-center gap-2 rounded-xl border border-line px-5 font-semibold text-ink active:bg-canvas" aria-label={`โทร ${c.phone}`}><Icon name="phone" class="size-5" /> โทร</a>}
        </div>
      </div>
    )}
  </body>
</html>

<script>
  // ปิดเมนูมือถือเมื่อแตะนอกเมนู หรือกด Esc (เปิด/ปิดด้วยปุ่มได้เองโดยไม่ต้องมีสคริปต์นี้)
  const menu = document.querySelector<HTMLDetailsElement>('[data-site-menu]');
  if (menu) {
    document.addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
    });
  }
</script>
