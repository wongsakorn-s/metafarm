---
import '../styles/global.css';
import { site } from '../config/site.ts';
import { lineChatUrl, telHref } from '../lib/settings.ts';
import { actionLabel, contactActions, messengerBase, shortLabel } from '../lib/contact.ts';
import { ldJson } from '../lib/seo.ts';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
  /** ข้อความที่จะใส่ในแชตเมื่อกดปุ่มติดต่อ (LINE ใส่ให้ · Messenger คัดลอกไว้ให้วาง) เช่น "สนใจรัง A25" */
  lineMessage?: string;
  active?: 'home' | 'stingless-bee' | 'honey' | 'products' | 'training' | 'passport' | 'gallery' | 'contact';
  noindex?: boolean;
  /** พาธหลักของหน้า (เช่น /passport/A25) — ใช้เมื่อ URL ที่เข้ามาอาจต่างกัน */
  canonical?: string;
  /** รูปตอนแชร์ลิงก์ (พาธหรือ URL เต็ม) — ไม่ใส่ = โลโก้ฟาร์ม */
  ogImage?: string;
  /** ข้อมูลโครงสร้างสำหรับ Google (สร้างด้วย src/lib/seo.ts) */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = site.description, lineMessage, active, noindex = false, canonical, ogImage: ogImageProp, jsonLd } = Astro.props;

const fullTitle = title === site.name ? `${site.name} · ${site.tagline}` : `${title} · ${site.name}`;
const ogImage = new URL(ogImageProp ?? '/brand/og.jpg', Astro.url).href;
const pageUrl = new URL(canonical ?? Astro.url.pathname, Astro.url.origin).href;
const c = Astro.locals.settings!.contact;
const line = lineChatUrl(c, lineMessage);
const tel = telHref(c.phone);
const messenger = messengerBase(c);
// ปุ่มติดต่อ: ช่องทางหลักก่อน (เจ้าของเลือกในหลังบ้าน) — ดู src/lib/contact.ts
const actions = contactActions(c, lineMessage);
const iconTone = { line: 'text-brand-line', messenger: 'text-brand-messenger', phone: 'text-palm-700' } as const;
const copyOf = (ch: string) => (ch === 'messenger' ? lineMessage : undefined);

// "สินค้า" ต่อจากหน้าแรก — ลูกค้าที่มาจาก Facebook/LINE มาเพื่อดูของและราคา (เดิมอยู่ลำดับ 4 หลังหน้าบทความ)
const nav = [
  { key: 'home', href: '/', label: 'หน้าแรก', icon: 'home' },
  { key: 'products', href: '/products', label: 'สินค้า', icon: 'cart' },
  { key: 'stingless-bee', href: '/stingless-bee', label: 'ชันโรงขนเงิน', icon: 'hive' },
  { key: 'honey', href: '/honey', label: 'น้ำผึ้ง', icon: 'honey' },
  { key: 'training', href: '/training', label: 'อบรม', icon: 'training' },
  { key: 'passport', href: '/passport', label: 'สมุดพกรัง', icon: 'passport' },
  { key: 'gallery', href: '/gallery', label: 'แกลเลอรี', icon: 'image' },
  { key: 'contact', href: '/contact', label: 'ติดต่อเรา', icon: 'pin' },
] as const;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0b7a3e" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="th_TH" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    {!ogImageProp && <meta property="og:image:width" content="1200" />}
    {!ogImageProp && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={title} />
    {/* หน้า noindex (เช่น 404) ไม่ต้องมี canonical */}
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <meta property="og:url" content={pageUrl} />
    {jsonLd && !noindex && <script type="application/ld+json" set:html={ldJson(jsonLd)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={['flex min-h-dvh flex-col', actions.length > 0 && 'pb-[calc(4.5rem+env(safe-area-inset-bottom))] md:pb-0']}>
    <a class="skip-link" href="#main">ข้ามไปเนื้อหาหลัก</a>
    {!c.confirmed && (
      <p class="bg-honey-400 px-4 py-1.5 text-center text-sm font-medium text-ink" role="note">
        <Icon name="warning" class="inline-block size-[1.15em] align-[-0.2em]" /> ช่องทางติดต่อเป็น<strong>ข้อมูลตัวอย่าง</strong><span class="hidden sm:inline"> (เว็บกำลังจัดทำ)</span>
      </p>
    )}

    {/* หัวเว็บ: มือถือ = แถวเดียว (โลโก้ + ปุ่มเมนู) · คอม = เมนูแนวนอนเต็ม
        เดิมมือถือมีเมนู 7 รายการเลื่อนข้าง ตัวท้าย ๆ ถูกตัด ("สมุด…") และหัวเว็บสูง 2 แถว */}
    <header class="sticky top-0 z-30 border-b border-line bg-surface/95 backdrop-blur">
      <div class="relative mx-auto flex max-w-5xl items-center justify-between gap-6 px-4 py-2 md:py-3">
        <a href="/" class="flex min-h-11 min-w-11 items-center" aria-label={`${site.name} หน้าแรก`}>
          <img src="/brand/logo.webp" alt={site.name} width="140" height="38" class="h-9 w-auto" />
        </a>
        <nav aria-label="เมนูหลัก" class="hidden md:flex md:gap-1">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
              class:list={['flex min-h-11 shrink-0 items-center whitespace-nowrap rounded-xl px-3 font-medium', active === n.key ? 'bg-palm-50 text-palm-700' : 'text-ink hover:bg-canvas']}>{n.label}</a>
          ))}
        </nav>
        {/* เมนูมือถือ: <details> เปิด/ปิดได้แม้ไม่มี JavaScript */}
        <details class="group md:hidden" data-site-menu>
          <summary class="flex min-h-11 items-center gap-2 rounded-xl border border-line px-3 font-medium transition-colors duration-(--duration-fast) hover:bg-palm-50 active:bg-palm-100 group-open:border-palm-500 group-open:bg-palm-50" data-menu-toggle>
            <span class="group-open:hidden"><Icon name="menu" class="size-5" /></span>
            <span class="hidden group-open:inline"><Icon name="close" class="size-5" /></span>
            <span>เมนู</span>
          </summary>
          <div class="absolute inset-x-0 top-full max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-line bg-surface shadow-lg">
            <nav aria-label="เมนูหลัก (มือถือ)" class="px-4 py-2">
              <ul class="divide-y divide-line">
                {nav.map((n) => (
                  <li>
                    <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
                      class:list={['flex min-h-13 items-center gap-3 rounded-xl px-2 text-lg', active === n.key ? 'font-semibold text-palm-700' : 'text-ink active:bg-canvas']}>
                      <span class="grid w-7 place-items-center text-palm-700"><Icon name={n.icon} class="size-5" /></span><span class="flex-1">{n.label}</span>
                      {active === n.key && <span class="size-2 rounded-full bg-palm-600" aria-hidden="true"></span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </details>
      </div>
    </header>

    <main id="main" tabindex="-1" class="mx-auto w-full max-w-5xl flex-1 px-4 py-6 outline-none md:py-10"><slot /></main>

    <footer class="border-t border-line bg-surface">
      {/* มือถือ: ตัดโลโก้และเมนูที่ซ้ำกับเมนูด้านบน · ช่องทางติดต่อ 2 คอลัมน์ (เดิมส่วนท้ายยาวเกือบเต็มจอ) */}
      <div class="mx-auto grid max-w-5xl gap-6 px-4 py-6 sm:grid-cols-2 md:gap-8 md:py-10 lg:grid-cols-[1.5fr_1fr_1.2fr]">
        <div class="sm:col-span-2 lg:col-span-1">
          <img src="/brand/logo-round-sm.webp" alt="" width="72" height="67" class="mb-3 hidden h-[67px] w-[72px] object-contain md:block" loading="lazy" />
          <p class="font-semibold">{site.name} <span class="font-normal text-muted">· {site.tagline}</span></p>
          <p class="text-sm text-muted">{site.address}</p>
        </div>
        <nav aria-label="เมนูท้ายเว็บ" class="hidden md:block">
          <h2 class="mb-2 text-sm font-semibold text-muted">เมนู</h2>
          <ul class="grid grid-cols-2 gap-x-6">
            {nav.map((n) => <li><a class="flex min-h-11 min-w-11 items-center hover:text-palm-700 hover:underline md:min-h-9" href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div>
          <h2 class="mb-2 text-sm font-semibold text-muted">ติดต่อเรา</h2>
          <ul class="grid grid-cols-2 gap-x-4 md:block">
            {line && <li><a class="inline-flex min-h-11 items-center gap-2 text-palm-700 hover:underline md:min-h-9" href={line} rel="noopener"><Icon name="line" class="size-4" />LINE {c.lineId}</a></li>}
            {messenger && <li><a class="inline-flex min-h-11 items-center gap-2 text-palm-700 hover:underline md:min-h-9" href={messenger} rel="noopener"><Icon name="messenger" class="size-4" />Messenger</a></li>}
            {tel && <li><a class="inline-flex min-h-11 items-center gap-2 text-palm-700 hover:underline md:min-h-9" href={tel}><Icon name="phone" class="size-4" />โทร {c.phone}</a></li>}
            {c.facebookUrl && <li><a class="inline-flex min-h-11 items-center gap-2 text-palm-700 hover:underline md:min-h-9" href={c.facebookUrl} rel="noopener noreferrer"><Icon name="thumbs" class="size-4" />Facebook</a></li>}
            {c.mapUrl && <li><a class="inline-flex min-h-11 items-center gap-2 text-palm-700 hover:underline md:min-h-9" href={c.mapUrl} rel="noopener noreferrer"><Icon name="map" class="size-4" />แผนที่ฟาร์ม</a></li>}
          </ul>
        </div>
      </div>
      <div class="border-t border-line">
        <p class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-4 px-4 text-xs text-muted">
          <span class="py-2">© {new Date().getFullYear() + 543} {site.name} · สงวนลิขสิทธิ์</span>
          <a class="inline-flex min-h-11 items-center underline" href="/privacy">นโยบายความเป็นส่วนตัว</a>
        </p>
      </div>
    </footer>

    {/* ติดต่อ: มือถือ = แถบล่างเต็มความกว้าง (ไม่ลอยทับเนื้อหา) · คอม = ปุ่มลอย "ติดต่อเรา" ปุ่มเดียว แตะแล้วกางช่องทาง
        (เดิม 3 ปุ่มกว้าง ~350px บังเนื้อหาขวาล่าง) · ปุ่มหลักสีเขียวแบรนด์ สีของแอปแชตอยู่ที่ไอคอน
        Messenger คัดลอกข้อความให้ก่อนเปิดแชต (scripts/contact-copy.ts) */}
    {actions.length > 0 && (
      <details class="group fixed bottom-4 right-4 z-20 hidden md:block" data-contact-buttons data-contact-pop>
        <summary class="inline-flex min-h-12 cursor-pointer list-none items-center gap-2 rounded-full bg-palm-600 px-5 font-semibold text-white shadow-lg transition hover:bg-palm-700 [&::-webkit-details-marker]:hidden">
          <Icon name="messenger" class="size-5" /> ติดต่อเรา
          <Icon name="chevron" class="size-4 -rotate-90 transition group-open:rotate-90" />
        </summary>
        <div class="absolute bottom-14 right-0 w-80 rounded-2xl border border-line bg-surface p-2 shadow-raised">
          <p class="px-3 pb-1 pt-2 text-sm text-muted">ทักแชตหรือโทรหาเราได้เลย</p>
          {actions.map((a) => (
            <a href={a.href} rel={a.channel === 'phone' ? undefined : 'noopener'} data-channel={a.channel} data-copy={copyOf(a.channel)}
              class="flex min-h-12 items-center gap-3 rounded-xl px-3 font-medium hover:bg-canvas">
              <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-canvas"><Icon name={a.channel} class:list={['size-5', iconTone[a.channel]]} /></span>
              <span class="flex-1">{actionLabel(a.channel)}{a.channel === 'phone' && <span class="block text-sm font-normal text-muted">{c.phone}</span>}</span>
              {a.primary && <span class="badge bg-palm-100 text-palm-900">หลัก</span>}
            </a>
          ))}
        </div>
      </details>
    )}
    {actions.length > 0 && (
      <div class="fixed inset-x-0 bottom-0 z-20 border-t border-line bg-surface/95 px-3 pt-2 pb-[calc(0.5rem+env(safe-area-inset-bottom))] backdrop-blur transition-transform duration-(--duration-fast) md:hidden" data-contact-buttons data-contact-bar>
        <div class="mx-auto flex max-w-md gap-2">
          {actions.map((a) => a.primary ? (
            <a href={a.href} rel={a.channel === 'phone' ? undefined : 'noopener'} data-channel={a.channel} data-copy={copyOf(a.channel)}
              class="inline-flex min-h-12 flex-1 items-center justify-center gap-2 rounded-xl bg-palm-600 font-semibold text-white active:bg-palm-700"><Icon name={a.channel} class="size-5" /> {actionLabel(a.channel)}</a>
          ) : (
            <a href={a.href} rel={a.channel === 'phone' ? undefined : 'noopener'} data-channel={a.channel} data-copy={copyOf(a.channel)} aria-label={actionLabel(a.channel)}
              class="inline-flex min-h-12 min-w-12 flex-col items-center justify-center rounded-xl border border-line px-2 text-xs font-semibold text-ink active:bg-canvas"><Icon name={a.channel} class:list={['size-5', iconTone[a.channel]]} />{shortLabel[a.channel]}</a>
          ))}
        </div>
      </div>
    )}
  </body>
</html>

<script>
  import '../scripts/contact-copy';
  import '../scripts/lightbox';
  // ปิดเมนูมือถือเมื่อแตะนอกเมนู หรือกด Esc (เปิด/ปิดด้วยปุ่มได้เองโดยไม่ต้องมีสคริปต์นี้)
  // ปุ่มลอย "ติดต่อเรา" (คอม): ปิดเมื่อแตะนอกกล่อง หรือกด Esc
  const pop = document.querySelector<HTMLDetailsElement>('[data-contact-pop]');
  if (pop) {
    document.addEventListener('click', (e) => { if (pop.open && !pop.contains(e.target as Node)) pop.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && pop.open) { pop.open = false; pop.querySelector('summary')?.focus(); } });
  }
  // หน้าที่มีปุ่มสั่งซื้อในเนื้อหา (สินค้า/อบรม): ระหว่างที่ปุ่มนั้นอยู่บนจอ ซ่อนแถบติดต่อล่างจอ
  // เดิมเห็นปุ่ม Messenger สีเขียวสองปุ่มพร้อมกัน ข้อความต่างกัน ("สั่งทาง…" กับ "สอบถามทาง…") — ไม่รู้จะกดอันไหน
  const bar = document.querySelector<HTMLElement>('[data-contact-bar]');
  const inline = [...document.querySelectorAll<HTMLElement>('#main [data-contact-buttons]')];
  if (bar && inline.length && 'IntersectionObserver' in window) {
    const seen = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? seen.add(e.target) : seen.delete(e.target);
      const hide = seen.size > 0;
      bar.classList.toggle('translate-y-full', hide);
      bar.inert = hide;
    }, { threshold: 0.6 });
    inline.forEach((el) => io.observe(el));
  }

  const menu = document.querySelector<HTMLDetailsElement>('[data-site-menu]');
  if (menu) {
    document.addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
    });
  }
</script>
