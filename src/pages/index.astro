---
import ContactButtons from '../components/ContactButtons.astro';
import FarmStats from '../components/FarmStats.astro';
import Icon from '../components/Icon.astro';
import VideoPlayer from '../components/VideoPlayer.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { businessLd } from '../lib/seo.ts';
import { getDb } from '../server/db.ts';
import { getFarmStats, getHeroPhoto, getPublicProducts, getSaleHives } from '../server/public.ts';
import SampleBadge from '../components/SampleBadge.astro';
import { formatPrice, SHIPPING_NOTE } from '../lib/products.ts';
import { photoSrcset } from '../lib/media.ts';
import { placeholder } from '../lib/placeholders.ts';
import { site } from '../config/site.ts';

export const prerender = false;

const db = getDb();
const [stats, hero, products, saleHives] = await Promise.all([getFarmStats(db), getHeroPhoto(db, Astro.locals.settings!.heroHive), getPublicProducts(db), getSaleHives(db)]);
// ราคาเริ่มต้นของแต่ละสินค้า (หน้าแรกโชว์ "เริ่ม …" ไม่ต้องแจกทุกขนาด)
const from = (prices: number[]) => (prices.length ? `เริ่ม ${formatPrice(Math.min(...prices))}` : '');
const askMessage = 'สนใจสอบถามรังและผลิตภัณฑ์ชันโรง';
// รังที่เปิดขาย: มีรังเดียว → ลิงก์ไปหน้ารังนั้นเลย (ไม่ต้องผ่านหน้ารายการ 1 รัง)
const hivesHref = saleHives.length === 1 ? `/products/hives/${saleHives[0]!.code}` : '/products/hives';
Astro.response.headers.set('Cache-Control', 'public, max-age=300');

const highlights = [
  { icon: 'wood' as const, title: `รังไม้สัก ${site.name}`, text: 'รัง 2 ห้องแนวนอน เคลือบโพลียูรีเทนสูตรน้ำเพื่อยืดอายุการใช้งาน' },
  { icon: 'queen' as const, title: 'พัฒนาสายพันธุ์ขนเงิน', text: 'ให้เหมาะกับภูมิอากาศของภาคตะวันออกโดยเฉพาะ' },
  { icon: 'passport' as const, title: 'ทุกรังมีสมุดพก', text: 'จดบันทึกที่มาของนางพญา วันเกิด และกิจกรรมต่าง ๆ ของแต่ละรัง' },
];
const homeVideo = Astro.locals.settings!.homeVideo;
const homeSecs = homeVideo?.seconds;
const homeSec = homeSecs ? (homeSecs < 60 ? `${homeSecs} วินาที` : `${Math.round(homeSecs / 60)} นาที`) : '';
---

<PublicLayout title={site.name} active="home" jsonLd={businessLd(site, Astro.locals.settings!.contact, Astro.url.origin)}>
  <section class="grid items-center gap-6 md:grid-cols-[1.2fr_1fr] md:gap-8">
    {/* มือถือวางแบบเดียวกับคอม (เจ้าของขอ 2026-10-10): ข้อความชิดซ้าย · โลโก้อยู่ขวาของหัวข้อ (คอม: คอลัมน์ขวา) */}
    <div>
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="font-medium text-palm-700">{site.tagline}</p>
          <h1 class="mt-1 text-[2rem] font-bold leading-tight sm:text-4xl md:text-5xl">ชันโรงขนเงิน<br />เลี้ยงในสวนปาล์ม จ.ระยอง</h1>
        </div>
        {!hero && <img src="/brand/logo-round.webp" alt="" width="360" height="334" fetchpriority="high" class="mt-1 w-24 shrink-0 sm:w-28 md:hidden" />}
      </div>
      <p class="mt-4 max-w-xl text-lg text-muted">
        {site.name} เป็นสวนปาล์มน้ำมัน 50 ไร่ ที่ {site.address} เริ่มเลี้ยงผึ้งชันโรงตั้งแต่ปี พ.ศ. {site.foundedYearBE}
      </p>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
        <a class="btn-primary" href="/products"><Icon name="hive" class="inline-block size-[1.15em] align-[-0.2em]" /> ดูสินค้า</a>
        <a class="btn-ghost" href="/passport"><Icon name="passport" class="inline-block size-[1.15em] align-[-0.2em]" /> สมุดพกรัง</a>
        {/* มือถือมีแถบติดต่อด้านล่างอยู่แล้ว */}
        <ContactButtons class="hidden md:flex" show="primary" message={askMessage} />
      </div>
    </div>
    {/* รูปจริงจากสวน (เจ้าของเลือกในตั้งค่า) แทนโลโก้ — มือถือก็เห็น (ใต้ข้อความ) · ยังไม่เลือกรูป = โลโก้กลม (มือถือ: เล็กข้างหัวข้อ ด้านบน) */}
    {hero ? (
      <figure class="relative">
        <a href={`/img/${hero.key}`} data-zoom data-caption={`รังชันโรงขนเงิน ${hero.code}`} aria-label={`ดูรูปขยาย: รังชันโรงขนเงิน ${hero.code}`} class="block">
          <img src={`/img/${hero.key}`} srcset={photoSrcset(`/img/${hero.key}`)} sizes="(min-width: 768px) 40vw, 100vw" width="900" height="675" fetchpriority="high"
            alt={`รังชันโรงขนเงิน ${hero.code} ที่ ${site.name}`} class="aspect-[4/3] w-full rounded-3xl bg-palm-50 object-cover shadow-card" />
        </a>
        <figcaption class="absolute bottom-3 left-3">
          <a class="inline-flex min-h-11 items-center gap-1 rounded-full bg-surface/90 px-4 text-sm font-medium text-palm-700 backdrop-blur" href={`/passport/${hero.code}`}><Icon name="passport" class="size-4" />รัง {hero.code} · ดูสมุดพก</a>
        </figcaption>
      </figure>
    ) : (
      <img src="/brand/logo-round.webp" alt={`โลโก้ ${site.name} ${site.tagline}`} width="360" height="334" class="hidden md:block md:w-full md:max-w-sm md:justify-self-center" />
    )}
  </section>

  {/* ตัวเลขจริงจากทะเบียนรัง — ความน่าเชื่อถือก่อนเล่าเรื่อง (Trust & Authority) */}
  <FarmStats stats={stats} href="/passport" class="mt-8" />

  {/* สินค้าพร้อมราคาตั้งแต่หน้าแรก (รีวิว UX: เดิมต้องกดเข้าหน้าสินค้าก่อนถึงเห็นว่าขายอะไร ราคาเท่าไร) */}
  {(products.length > 0 || saleHives.length > 0) && (
    <section class="mt-12" aria-labelledby="shop-h">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="shop-h" class="text-2xl font-bold">สินค้าจากฟาร์ม</h2>
        <a class="inline-flex min-h-11 items-center font-medium text-palm-700 underline" href="/products">ดูสินค้าทั้งหมด</a>
      </div>
      <ul class:list={['mt-4 grid gap-4 sm:grid-cols-2', (products.length + (saleHives.length ? 1 : 0)) >= 3 && 'lg:grid-cols-3']}>
        {saleHives.length > 0 && (
          <li>
            <a href={hivesHref} class="card-link flex h-full flex-col overflow-hidden !p-0">
              <img src={saleHives[0]!.coverKey ? `/img/${saleHives[0]!.coverKey}` : placeholder.hive} alt="" width="800" height="450" loading="lazy" class="aspect-[16/9] w-full bg-palm-50 object-cover" />
              <div class="p-4">
                <h3 class="text-lg font-bold">รังสมบูรณ์ชันโรงขนเงิน</h3>
                <p data-num class="text-xl font-bold text-palm-700">{from(saleHives.map((h) => h.priceThb))} <span class="text-sm font-normal text-muted">({SHIPPING_NOTE})</span></p>
                <p class="text-sm text-muted">เปิดขาย {saleHives.length} รัง · ทุกรังมีสมุดพก</p>
              </div>
            </a>
          </li>
        )}
        {products.map((p) => (
          <li>
            <a href={`/products/${p.slug}`} class="card-link flex h-full flex-col overflow-hidden !p-0">
              <img src={p.imageKey ? `/img/${p.imageKey}` : p.category === 'honey' ? placeholder.honey : placeholder.hiveBox} alt="" width="800" height="450" loading="lazy" class="aspect-[16/9] w-full bg-palm-50 object-cover" />
              <div class="p-4">
                <h3 class="text-lg font-bold">{p.name}</h3>
                <p data-num class="text-xl font-bold text-palm-700">{from(p.variants.map((v) => v.priceThb))} <span class="text-sm font-normal text-muted">({SHIPPING_NOTE})</span></p>
                {p.variants.some((v) => v.priceIsSample) && <p class="mt-1"><SampleBadge /></p>}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* เรื่องราว + จุดเด่น 3 ข้อ (ซ้าย) · วิดีโอแนะนำฟาร์ม (ขวา สูงเท่าฝั่งซ้าย) บนคอม · มือถือ: เรื่องราว → วิดีโอ → จุดเด่น · ยังไม่มีวิดีโอ = เรื่องราว (ซ้าย) + จุดเด่น (ขวา) */}
  {homeVideo ? (
    <section class="mt-12 grid gap-8 lg:grid-cols-2 lg:items-stretch" aria-labelledby="story-h">
      <div class="contents lg:block">
        <div class="order-1">
        <h2 id="story-h" class="text-2xl font-bold">เรื่องราวของฟาร์ม</h2>
        <div class="mt-3 space-y-3 text-lg">
          <p>เราเริ่มจากการทดลองเลี้ยงชันโรงหลายสายพันธุ์ ทั้งขนเงิน ถ้วยดำ จิ่วดุ ปากแตร อิตาม่า และบิงฮามี่</p>
          <p>แต่ภูมิอากาศที่ จ.ระยอง ค่อนข้างร้อน และบางช่วงฝนไม่ตกต่อเนื่องหลายเดือน ทำให้หลายสายพันธุ์อยู่ไม่รอด</p>
          <p><strong>ชันโรงขนเงิน</strong> (<em>Tetragonula pagdeni</em>) คือสายพันธุ์ที่เราพบว่าเหมาะกับอากาศที่นี่ที่สุด เราจึงพัฒนารังเลี้ยงสำหรับขนเงินโดยเฉพาะ</p>
        </div>
        </div>
        <ul class="order-3 grid gap-3 lg:mt-6" aria-label="จุดเด่น">
        {highlights.map((h) => (
        <li class="card flex gap-4">
          <div class="grid size-12 shrink-0 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name={h.icon} class="size-6" /></div>
          <div><h3 class="text-lg font-semibold">{h.title}</h3>
          <p class="mt-1 text-muted">{h.text}</p></div>
        </li>
      ))}
        </ul>
      </div>
      {/* วิดีโอ: มือถือสูงตามสัดส่วนคลิป · คอมเต็มความสูงของฝั่งซ้าย (ไม่ครอป ขอบที่เหลือเป็นสีดำ) */}
      <div class="order-2 flex flex-col">
        <h3 class="mb-2 flex items-center gap-2 text-lg font-semibold"><Icon name="video" class="size-5 text-palm-700" />ชมวิดีโอแนะนำฟาร์ม{homeSec && <span class="text-sm font-normal text-muted">({homeSec})</span>}</h3>
        <div class="relative lg:min-h-0 lg:flex-1"><VideoPlayer video={homeVideo} title="วิดีโอแนะนำฟาร์ม" ambient fill /></div>
      </div>
    </section>
  ) : (
    <section class="mt-12 grid gap-8 lg:grid-cols-[1.15fr_1fr] lg:items-start" aria-labelledby="story-h">
      <div>
      <h2 id="story-h" class="text-2xl font-bold">เรื่องราวของฟาร์ม</h2>
      <div class="mt-3 space-y-3 text-lg">
        <p>เราเริ่มจากการทดลองเลี้ยงชันโรงหลายสายพันธุ์ ทั้งขนเงิน ถ้วยดำ จิ่วดุ ปากแตร อิตาม่า และบิงฮามี่</p>
        <p>แต่ภูมิอากาศที่ จ.ระยอง ค่อนข้างร้อน และบางช่วงฝนไม่ตกต่อเนื่องหลายเดือน ทำให้หลายสายพันธุ์อยู่ไม่รอด</p>
        <p><strong>ชันโรงขนเงิน</strong> (<em>Tetragonula pagdeni</em>) คือสายพันธุ์ที่เราพบว่าเหมาะกับอากาศที่นี่ที่สุด เราจึงพัฒนารังเลี้ยงสำหรับขนเงินโดยเฉพาะ</p>
      </div>
      </div>
      <ul class="grid gap-3" aria-label="จุดเด่น">
      {highlights.map((h) => (
        <li class="card flex gap-4">
          <div class="grid size-12 shrink-0 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name={h.icon} class="size-6" /></div>
          <div><h3 class="text-lg font-semibold">{h.title}</h3>
          <p class="mt-1 text-muted">{h.text}</p></div>
        </li>
      ))}
      </ul>
    </section>
  )}

  <section class="mt-12" aria-labelledby="learn-h">
    <h2 id="learn-h" class="text-2xl font-bold">เรียนรู้และเลือกซื้อ</h2>
    <ul class="mt-4 grid gap-4 md:grid-cols-3">
      {/* มือถือ: ไอคอนซ้าย ข้อความขวา (การ์ดเตี้ย เลื่อนน้อย) · คอม: 3 คอลัมน์ ไอคอนบน */}
      {([
        ['/stingless-bee', 'hive', 'รู้จักชันโรงขนเงิน', 'ลักษณะ โครงสร้างรัง กล่องเลี้ยงที่เหมาะสมและได้มาตรฐาน'],
        ['/honey', 'honey', 'น้ำผึ้งชันโรง', 'สรรพคุณ และวิธีการบริโภค'],
        ['/training', 'training', 'อบรม', 'การแยกขยายรัง การกรองน้ำผึ้งและการแปรรูป'],
      ] as const).map(([href, icon, title, text]) => (
        <li><a href={href} class="card-link group flex h-full items-center gap-4 md:block">
          <div class="grid size-12 shrink-0 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name={icon} class="size-6" /></div>
          <div class="flex-1"><h3 class="text-lg font-semibold md:mt-2">{title}</h3><p class="text-muted">{text}</p></div>
          <Icon name="chevron" class="size-5 text-muted transition-transform duration-(--duration-fast) group-hover:translate-x-0.5 md:hidden" />
        </a></li>
      ))}
    </ul>
  </section>
  <section class="mt-12 rounded-3xl bg-palm-50 p-6 md:p-8" aria-labelledby="pp-h">
    <div class="grid items-center gap-6 md:grid-cols-[1fr_auto]">
      <div>
        <h2 id="pp-h" class="text-2xl font-bold text-palm-900"><Icon name="passport" class="inline-block size-[1.15em] align-[-0.2em]" /> สมุดพกชันโรง {site.name}</h2>
        <p class="mt-2 max-w-2xl">ประวัติ และกิจกรรมต่าง ๆ ของแต่ละรัง</p>
      </div>
      <a class="btn-primary" href="/passport">เปิดสมุดพก</a>
    </div>
  </section>
</PublicLayout>
