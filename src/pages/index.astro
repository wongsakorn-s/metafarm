---
import '../styles/global.css';
import { site } from '../config/site.ts';
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{site.name} · {site.tagline}</title>
    <meta name="description" content={site.description} />
  </head>
  <body class="grid min-h-dvh place-items-center px-4 text-center">
    <main>
      <div class="text-6xl" aria-hidden="true">🐝</div>
      <h1 class="mt-3 text-4xl font-bold text-palm-700">{site.name}</h1>
      <p class="mt-1 text-lg text-muted">{site.tagline}</p>
      <p class="mx-auto mt-4 max-w-md">{site.description}</p>
      <p class="mt-6 text-sm text-muted">เว็บไซต์กำลังจัดทำ · {site.address}</p>
    </main>
  </body>
</html>
