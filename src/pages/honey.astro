---
import PageHeader from '../components/PageHeader.astro';
import Article from '../components/Article.astro';
import Icon from '../components/Icon.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { getPage } from '../lib/content.ts';

export const prerender = false;

const page = getPage('honey')!;
const { Content, frontmatter: fm } = page;
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
---

<PublicLayout title={fm.title} description={fm.description} active="honey" lineMessage="สนใจน้ำผึ้งชันโรงขนเงิน">
  <Article headings={page.getHeadings()}>
    <Fragment slot="header">
      <PageHeader title={fm.title} lead={fm.lead} />
      {/* รูปจริงของฟาร์ม (เจ้าของส่งมา 2026-10-11) แทนรูป Wikimedia — ไม่ต้องมีเครดิต */}
      <a href="/photos/farm/honey-hive.webp" data-zoom aria-label="ดูรูปขยาย: น้ำผึ้งชันโรงในขวดหมีสามขวด" class="mt-6 block">
        <img src="/photos/farm/honey-hive.webp" srcset="/photos/farm/honey-hive-700.webp 700w, /photos/farm/honey-hive.webp 1400w" sizes="(min-width: 1024px) 740px, 100vw" width="1400" height="1045"
          alt="น้ำผึ้งชันโรงในขวดหมีสามขวด วางข้างถ้วยน้ำหวานในรังไม้ของ MetaFarm" fetchpriority="high" decoding="async" class="aspect-[4/3] w-full rounded-3xl border border-line bg-palm-50 object-cover" />
      </a>
    </Fragment>
    <Content />
  </Article>

  {/* ภาพประกอบชุดใต้บทความ (Wikimedia) ตัดออกตามที่เจ้าของขอ (2026-10-10) — เหลือรูปหลักใต้หัวข้อ */}
  {/* แผงราคา "น้ำผึ้งชันโรงขนเงิน ปี 2569" ตัดออกตามที่เจ้าของขอ (2026-10-10) — ราคา/สั่งซื้ออยู่ที่หน้าสินค้า */}
  <a href="/learn/research" class="card-link mt-10 flex items-center gap-4">
    <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name="book" class="size-6" /></span>
    <span class="min-w-0 flex-1">
      <span class="block font-semibold text-palm-700">น้ำผึ้งชันโรงในงานวิจัย</span>
      <span class="block text-[0.9375rem] text-muted">สรุปงานวิจัยที่ศึกษาน้ำผึ้งชันโรง พร้อมแหล่งอ้างอิง</span>
    </span>
    <Icon name="chevron" class="size-5 shrink-0 text-palm-700" />
  </a>
</PublicLayout>
