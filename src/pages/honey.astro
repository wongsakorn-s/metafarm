---
import Article from '../components/Article.astro';
import Icon from '../components/Icon.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import SampleBadge from '../components/SampleBadge.astro';
import { getPage } from '../lib/content.ts';
import CreditPhoto from '../components/CreditPhoto.astro';
import { learnPhotos as P } from '../lib/learn-photos.ts';
import { site } from '../config/site.ts';
import { getDb } from '../server/db.ts';
import { getPublicProducts } from '../server/public.ts';
import { formatPrice, sizeLabel } from '../lib/products.ts';

export const prerender = false;

const page = getPage('honey')!;
const { Content, frontmatter: fm } = page;
const product = (await getPublicProducts(getDb(), 'stingless-honey'))[0];
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
---

<PublicLayout title={fm.title} description={fm.description} active="honey" lineMessage="สนใจน้ำผึ้งชันโรงขนเงิน">
  <h1 class="text-3xl font-bold md:text-4xl">{fm.title}</h1>
  <CreditPhoto photo={P.honeyPots} priority class="mt-5 max-w-3xl" />
  <Article headings={page.getHeadings()}><Content /></Article>

  <section class="mt-10" aria-labelledby="pics-h">
    <h2 id="pics-h" class="text-2xl font-bold">การเก็บน้ำผึ้งชันโรง</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <CreditPhoto crop photo={P.honeyBox} sizes="(min-width: 640px) 50vw, 100vw" />
      <CreditPhoto crop photo={P.honeyHarvest} sizes="(min-width: 640px) 50vw, 100vw" />
    </div>
    <p class="mt-3 text-sm text-muted">ภาพประกอบจาก Wikimedia Commons ใช้ตามสัญญาอนุญาตของผู้ถ่าย — ไม่ใช่ภาพจากฟาร์ม {site.name} (รูปจากฟาร์มจะทยอยเพิ่ม)</p>
  </section>

  {product && (
    <section class="mt-10" aria-labelledby="buy-h">
      <h2 id="buy-h" class="text-2xl font-bold">{product.name}</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {product.variants.map((v) => (
          <li class="card">
            <p class="font-semibold">{v.label}{sizeLabel(v.sizeMl) ? ` · ${sizeLabel(v.sizeMl)}` : ''}</p>
            <p class="text-2xl font-bold text-palm-700">{formatPrice(v.priceThb)} {v.priceIsSample && <SampleBadge />}</p>
          </li>
        ))}
      </ul>
      <a class="btn-primary mt-4" href="/products/stingless-honey">ดูรายละเอียดและสั่งซื้อ →</a>
    </section>
  )}
  <p class="mt-8"><a class="text-palm-700 underline" href="/learn/research"><Icon name="book" class="inline-block size-[1.15em] align-[-0.2em]" /> น้ำผึ้งชันโรงในงานวิจัย</a></p>
</PublicLayout>
