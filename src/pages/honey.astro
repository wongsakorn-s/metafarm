---
import Icon from '../components/Icon.astro';
import LearnHero from '../components/LearnHero.astro';
import LearnSections from '../components/LearnSections.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import SampleBadge from '../components/SampleBadge.astro';
import { getPage, sectionsOf } from '../lib/content.ts';
import { learnPhotos as P } from '../lib/learn-photos.ts';
import { site } from '../config/site.ts';
import { getDb } from '../server/db.ts';
import { getPublicProducts } from '../server/public.ts';
import { formatPrice, sizeLabel } from '../lib/products.ts';

export const prerender = false;

const page = getPage('honey')!;
const fm = page.frontmatter;
const [{ sections }, [product]] = await Promise.all([sectionsOf(page), getPublicProducts(getDb(), 'stingless-honey')]);
Astro.response.headers.set('Cache-Control', 'public, max-age=120');
---

<PublicLayout title={fm.title} description={fm.description} active="honey" lineMessage="สนใจน้ำผึ้งชันโรงขนเงิน">
  <LearnHero eyebrow="จากรังในสวนปาล์ม" eyebrowIcon="honey" title={fm.title} lead={fm.lead} photo={P.honeyPots} facts={fm.facts} sections={sections}>
    {product && <a class="btn-primary" href="#buy-h"><Icon name="cart" class="size-5" /> ดูขนาดและสั่งซื้อ</a>}
    <a class="btn-ghost" href="/learn/research"><Icon name="book" class="size-5" /> น้ำผึ้งชันโรงในงานวิจัย</a>
  </LearnHero>

  <LearnSections sections={sections} config={fm.sections} />

  {product && (
    <section class="mt-16 scroll-mt-24 rounded-3xl bg-palm-50 p-5 sm:p-8 md:p-10" aria-labelledby="buy-h">
      <h2 id="buy-h" class="scroll-mt-24 text-2xl font-bold text-palm-900 md:text-3xl">{product.name}</h2>
      <ul class:list={['mt-5 grid gap-3 sm:grid-cols-2 md:gap-4', product.variants.length >= 3 && 'lg:grid-cols-3']}>
        {product.variants.map((v) => (
          <li class="card flex items-center gap-3">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-honey-50 text-honey-700"><Icon name="honey" class="size-6" /></span>
            <span>
              <span class="block font-semibold">{v.label}{sizeLabel(v.sizeMl) ? ` · ${sizeLabel(v.sizeMl)}` : ''}</span>
              <span data-num class="block text-2xl font-bold text-palm-700">{formatPrice(v.priceThb)} {v.priceIsSample && <SampleBadge />}</span>
            </span>
          </li>
        ))}
      </ul>
      <a class="btn-primary mt-5" href="/products/stingless-honey">ดูรายละเอียดและสั่งซื้อ <Icon name="chevron" class="size-5" /></a>
    </section>
  )}

  <a href="/learn/research" class="card-link mt-8 flex items-center gap-4">
    <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name="book" class="size-6" /></span>
    <span class="min-w-0 flex-1">
      <span class="block font-semibold text-palm-700">น้ำผึ้งชันโรงในงานวิจัย</span>
      <span class="block text-[0.9375rem] text-muted">สรุปงานวิจัยที่ศึกษาน้ำผึ้งชันโรง พร้อมแหล่งอ้างอิง</span>
    </span>
    <Icon name="chevron" class="size-5 shrink-0 text-palm-700" />
  </a>
  <p class="mt-6 text-sm text-muted">ภาพในหน้านี้เป็นภาพประกอบจาก Wikimedia Commons ใช้ตามสัญญาอนุญาตของผู้ถ่าย (ดูเครดิตใต้ภาพ) ไม่ใช่ภาพจากฟาร์ม {site.name} — รูปจากฟาร์มจะทยอยเพิ่ม</p>
</PublicLayout>
