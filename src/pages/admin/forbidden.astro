---
// พนักงานเปิดหน้าที่เฉพาะเจ้าของ (middleware ส่งมาที่นี่ด้วย rewrite — URL เดิมยังอยู่ในแถบที่อยู่)
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';

export const prerender = false;
Astro.response.status = 403;
---

<AdminLayout title="ไม่มีสิทธิ์เข้าหน้านี้">
  <div class="flex max-w-xl flex-col items-center gap-3 rounded-3xl border border-dashed border-line bg-surface px-5 py-8 text-center">
    <span class="grid size-12 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name="lock" class="size-6" /></span>
    <p class="font-semibold">หน้านี้สำหรับเจ้าของฟาร์มเท่านั้น</p>
    <p class="text-sm text-muted">เรื่องการขาย ราคา ต้นทุน และการตั้งค่าเว็บ — ถ้าต้องการข้อมูลส่วนนี้ ติดต่อเจ้าของฟาร์ม</p>
    <a class="btn-primary" href="/admin">กลับหน้าภาพรวม</a>
  </div>
</AdminLayout>
