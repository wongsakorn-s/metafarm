---
import Icon from '../../components/Icon.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../server/db.ts';
import { codesByNumber, hivePrefixes, recentHiveCodes } from '../../server/hives.ts';
import { bareNumber, normalizeHiveCode } from '../../lib/hive-code.ts';
import { isOwner } from '../../lib/permissions.ts';

// บันทึกด่วนในสวน: พิมพ์เลขรัง (เช่น 25) แล้วเลือกงาน → ไปที่ฟอร์มนั้นของรังทันที ไม่ต้องค้นในรายการ 150 รัง
export const prerender = false;

const db = getDb();
const ACTIONS = {
  honey: { label: 'เก็บน้ำหวาน', icon: 'honey', to: (c: string) => `/admin/hives/${c}?do=honey#form-honey` },
  queen: { label: 'เก็บไข่นางพญา', icon: 'queen', to: (c: string) => `/admin/hives/${c}?do=queen#form-queen` },
  brood: { label: 'แยกรัง', icon: 'brood', to: (c: string) => `/admin/hives/${c}?do=brood#form-brood` },
  note: { label: 'หมายเหตุ', icon: 'note', to: (c: string) => `/admin/hives/${c}?do=note#form-note` },
  photo: { label: 'ถ่ายรูป', icon: 'camera', to: (c: string) => `/admin/hives/${c}/media` },
  view: { label: 'เปิดหน้ารัง', icon: 'search', to: (c: string) => `/admin/hives/${c}` },
} as const;
type Action = keyof typeof ACTIONS;

const sp = Astro.url.searchParams;
const raw = (sp.get('code') ?? '').trim();
// ชุดตัวอักษรของรหัสรัง (A, B, G …) — เลือกชุดแล้วพิมพ์แค่เลขด้วยแป้นตัวเลข · พิมพ์รหัสเต็ม (B12) ก็ได้
const prefixes = await hivePrefixes(db);
const prefix = (sp.get('prefix') ?? '').toUpperCase() || prefixes[0] || 'A';
const act = (sp.get('do') ?? 'view') as Action;
let error = '';
let choices: string[] = [];
if (raw) {
  const n = bareNumber(raw);
  const code = normalizeHiveCode(raw) ?? (n ? normalizeHiveCode(`${prefix}${n}`) : null);
  if (!code) error = 'พิมพ์เลขรัง เช่น 25 หรือรหัสเต็ม เช่น B12';
  else {
    const hive = await db.query.hives.findFirst({ where: (h, { eq }) => eq(h.code, code), columns: { code: true } });
    if (hive) return Astro.redirect((ACTIONS[act] ?? ACTIONS.view).to(code), 303);
    // ไม่เจอในชุดที่เลือก → เสนอรังเลขเดียวกันในชุดอื่น
    choices = n ? await codesByNumber(db, n) : [];
    if (choices.length === 1 && !normalizeHiveCode(raw)) return Astro.redirect((ACTIONS[act] ?? ACTIONS.view).to(choices[0]!), 303);
    error = choices.length ? `ไม่พบรัง ${code} — หมายถึงรังไหน?` : `ไม่พบรัง ${code}`;
  }
}
const recent = await recentHiveCodes(db, 8);
---

<AdminLayout title="บันทึก" active="quick">
  <form method="get" class="card space-y-4" role="search">
    <div>
      <label class="label text-base" for="code">เลขรัง</label>
      <div class="flex items-stretch">
        {prefixes.length > 1 ? (
          <>
            <label class="sr-only" for="prefix">ชุดตัวอักษร</label>
            <select id="prefix" name="prefix" class="min-w-16 rounded-l-xl border border-r-0 border-line bg-canvas px-3 text-xl font-bold text-ink">
              {prefixes.map((p) => <option value={p} selected={p === prefix}>{p}</option>)}
            </select>
          </>
        ) : (
          <span class="grid place-items-center rounded-l-xl border border-r-0 border-line bg-canvas px-4 text-xl font-bold text-muted" aria-hidden="true">{prefix}</span>
        )}
        <input class="field rounded-l-none text-2xl font-bold tracking-wide" id="code" name="code" inputmode="numeric" autocomplete="off" enterkeyhint="go"
          placeholder="25" value={raw} required autofocus aria-describedby={error ? 'code-err' : 'code-hint'} aria-invalid={error ? 'true' : undefined} />
      </div>
      {error && <p id="code-err" class="error" role="alert">{error}</p>}
      {choices.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-2">
          {choices.map((c) => <li><a class="inline-flex min-h-11 min-w-16 items-center justify-center rounded-full border border-palm-600 bg-surface px-4 font-semibold text-palm-700" href={(ACTIONS[act] ?? ACTIONS.view).to(c)}>{c}</a></li>)}
        </ul>
      )}
      <p id="code-hint" class="hint">ดูเลขที่ป้ายบนตัวรัง{prefixes.length > 1 ? ' เลือกตัวอักษรหน้าเลขก่อน' : ''} แล้วเลือกงานด้านล่าง</p>
    </div>
    <div class="grid grid-cols-2 gap-3">
      {(Object.entries(ACTIONS) as [Action, (typeof ACTIONS)[Action]][]).map(([k, a], i) => (
        <button class:list={['flex min-h-16 flex-col items-center justify-center gap-1 rounded-2xl text-base font-semibold', i === 0 ? 'bg-palm-600 text-white active:bg-palm-700' : 'border border-line bg-surface text-ink active:bg-canvas']} type="submit" name="do" value={k}>
          <Icon name={a.icon} class="size-7" />{a.label}
        </button>
      ))}
    </div>
  </form>

  {recent.length > 0 && (
    <section class="mt-5" aria-labelledby="recent-h">
      <h2 id="recent-h" class="mb-2 text-sm font-semibold text-muted">รังที่เพิ่งบันทึก — แตะเพื่อเปิด</h2>
      <ul class="flex flex-wrap gap-2">
        {recent.map((c) => <li><a class="inline-flex min-h-11 min-w-16 items-center justify-center rounded-full border border-line bg-surface px-4 font-semibold active:bg-palm-50" href={`/admin/hives/${c}`}>{c}</a></li>)}
      </ul>
    </section>
  )}

  {/* งานอื่นเป็นปุ่มรองทั้งหมด — ปุ่มหลักของหน้านี้มีปุ่มเดียว (เก็บน้ำหวาน) */}
  <section class="mt-6 grid grid-cols-2 gap-3" aria-label="งานอื่น">
    <h2 class="col-span-2 text-sm font-semibold text-muted">งานอื่น</h2>
    {isOwner(Astro.locals.user)
      ? <a class="btn-ghost col-span-2" href="/admin/orders/new"><Icon name="receipt" class="size-5" />จดออเดอร์ใหม่</a>
      : <a class="btn-ghost col-span-2" href="/admin/lots"><Icon name="honey" class="size-5" />ล็อตน้ำผึ้ง (บรรจุขวด / ฉลาก)</a>}
    <a class="btn-ghost" href="/admin/hives/new"><Icon name="plus" class="inline-block size-[1.15em] align-[-0.2em]" /> เพิ่มรังใหม่</a>
    <a class="btn-ghost" href="/admin/photos"><Icon name="camera" class="inline-block size-[1.15em] align-[-0.2em]" /> คิวถ่ายรูป</a>
  </section>
</AdminLayout>

<script>
  // จำชุดตัวอักษรที่เลือกล่าสุดไว้ในเครื่องนี้ — เดินบันทึกแถวรัง B ไม่ต้องเลือก B ใหม่ทุกครั้งที่กลับมาหน้านี้
  // ลิงก์ที่ระบุชุดมาเอง (?prefix=) ใช้ตามลิงก์ · เก็บในเครื่องไม่ได้ (โหมดส่วนตัว) = ใช้ชุดที่มีรังมากที่สุดตามเดิม
  const KEY = 'metafarm:quick-prefix';
  const sel = document.getElementById('prefix') as HTMLSelectElement | null;
  if (sel) {
    if (!new URLSearchParams(location.search).get('prefix')) {
      try {
        const saved = localStorage.getItem(KEY);
        if (saved && [...sel.querySelectorAll('option')].some((o) => o.value === saved)) sel.value = saved;
      } catch {
        /* เก็บในเครื่องไม่ได้ */
      }
    }
    const remember = () => {
      try {
        localStorage.setItem(KEY, sel.value);
      } catch {
        /* เก็บในเครื่องไม่ได้ */
      }
    };
    sel.addEventListener('change', remember);
    sel.form?.addEventListener('submit', remember);
  }
</script>
