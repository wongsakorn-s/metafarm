---
import Icon from '../../components/Icon.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import { getDb, getMedia } from '../../server/db.ts';
import { getSettings, saveContact, saveCourse, saveHero, saveLocation, savePayment, settingsVersion } from '../../server/settings.ts';
import { getHeroPhoto } from '../../server/public.ts';
import { setHomeVideo } from '../../server/video.ts';
import VideoUploader from '../../components/VideoUploader.astro';
import { imageWidth, MIN_HERO_WIDTH, thumbUrl } from '../../lib/media.ts';
import { listTraining } from '../../lib/content.ts';
import { contactSchema, courseSchema, effectiveCourse, heroSchema, lineChatUrl, locationSchema, paymentSchema, telHref } from '../../lib/settings.ts';
import { messengerBase } from '../../lib/contact.ts';
import { fieldErrors, type FieldErrors } from '../../lib/validation.ts';
import { formatPrice } from '../../lib/products.ts';

export const prerender = false;

const db = getDb();
const user = Astro.locals.user!;
// รูปหน้าแรกต้องกว้างพอ (รูปจาก Excel กว้าง ~200 px ขยายเต็มจอมือถือแล้วเบลอ ดูไม่น่าเชื่อถือ)
// อ่านแค่ต้นไฟล์จาก R2 เพื่อหาความกว้าง · อ่านไม่ได้ = ไม่ห้าม
let heroSmallMsg = '';
async function heroTooSmall(code: string): Promise<boolean> {
  const hero = await getHeroPhoto(db, code);
  const obj = hero ? await getMedia().get(hero.key, { range: { offset: 0, length: 65_536 } }) : null;
  const w = obj ? imageWidth(new Uint8Array(await obj.arrayBuffer())) : null;
  if (w == null || w >= MIN_HERO_WIDTH) return false;
  heroSmallMsg = `รูปของรัง ${code} เล็กเกินไป (กว้าง ${w} พิกเซล) ขยายเต็มจอมือถือแล้วจะเบลอ — ถ่ายรูปใหม่ที่หน้ารัง (ระบบย่อให้เหลือกว้างพอดี) หรือเลือกรังอื่น`;
  return true;
}
let errors: FieldErrors = {};
let errorWhere = '';
let values: Record<string, string> = {};
const saved = Astro.url.searchParams.get('saved');
const notice = Astro.url.searchParams.get('msg');
/** มีคนบันทึกการตั้งค่าไปก่อน (เวอร์ชันไม่ตรง) — ค่าที่กรอกยังอยู่ในฟอร์ม กดบันทึกอีกครั้งเพื่อยืนยัน */
let conflict = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
  const intent = String(form.get('intent') ?? '');
  const version = values.version;
  if (intent === 'contact') {
    const p = contactSchema.safeParse(values);
    if (p.success && (await saveContact(db, user, p.data, version))) return Astro.redirect('/admin/settings?saved=contact', 303);
    if (p.success) conflict = true; else errors = fieldErrors(p.error);
    errorWhere = 'contact';
  } else if (intent === 'course') {
    const p = courseSchema.safeParse(values);
    if (p.success && (await saveCourse(db, user, p.data, version))) return Astro.redirect(`/admin/settings?saved=course#c-${p.data.slug}`, 303);
    if (p.success) conflict = true; else errors = fieldErrors(p.error);
    errorWhere = `course:${values.slug}`;
  } else if (intent === 'payment') {
    const p = paymentSchema.safeParse(values);
    if (p.success && (await savePayment(db, user, p.data, version))) return Astro.redirect('/admin/settings?saved=payment#payment', 303);
    if (p.success) conflict = true; else errors = fieldErrors(p.error);
    errorWhere = 'payment';
  } else if (intent === 'hero') {
    const p = heroSchema.safeParse(values);
    if (!p.success) { errors = fieldErrors(p.error); errorWhere = 'hero'; }
    else if (p.data.heroHive && !(await getHeroPhoto(db, p.data.heroHive))) { errors = { heroHive: `รัง ${p.data.heroHive} ยังไม่มีรูปสมุดพก (หรือไม่มีรังนี้) — เลือกรังที่มีรูป` }; errorWhere = 'hero'; }
    else if (p.data.heroHive && (await heroTooSmall(p.data.heroHive))) { errors = { heroHive: heroSmallMsg }; errorWhere = 'hero'; }
    else if (await saveHero(db, user, p.data.heroHive, version)) return Astro.redirect('/admin/settings?saved=hero#hero', 303);
    else { conflict = true; errorWhere = 'hero'; }
  } else if (intent === 'homeVideo') {
    // ลิงก์ YouTube แทนไฟล์ · ว่าง = เอาวิดีโอออก (ไฟล์ที่อัปโหลดจะส่งผ่าน PUT /admin/settings/video แยกต่างหาก)
    const r = await setHomeVideo(db, getMedia(), user, { youtube: String(form.get('youtube') ?? '') });
    if (r.ok) return Astro.redirect(`/admin/settings?msg=${encodeURIComponent(String(form.get('youtube') ?? '').trim() ? 'ตั้งวิดีโอ YouTube หน้าแรกแล้ว' : 'เอาวิดีโอหน้าแรกออกแล้ว')}#home-video`, 303);
    errors = { youtube: r.error };
    errorWhere = 'homeVideo';
  } else if (intent === 'location') {
    const p = locationSchema.safeParse(values);
    if (p.success && (await saveLocation(db, user, p.data, version))) return Astro.redirect('/admin/settings?saved=location#location', 303);
    if (p.success) conflict = true; else errors = fieldErrors(p.error);
    errorWhere = 'location';
  }
}

const settings = await getSettings(db);
// ทุกฟอร์มส่งเวอร์ชันนี้กลับมา (ชนกัน = ได้เวอร์ชันล่าสุดแล้ว กดบันทึกอีกครั้งเพื่อยืนยันค่าของคุณ)
const version = await settingsVersion(db);
const hero = await getHeroPhoto(db, settings.heroHive);
const c = settings.contact;
const courses = listTraining().map((x) => ({ ...x, eff: effectiveCourse(x, settings.courses[x.slug]) }));
// ค่าที่แสดงในฟอร์ม: ค่าที่เพิ่งส่งมา (กรณีมี error) ไม่งั้นค่าปัจจุบัน
const cv = (k: 'lineId' | 'phone' | 'facebookUrl' | 'messengerUrl' | 'mapUrl' | 'primary') => (errorWhere === 'contact' ? (values[k] ?? '') : c[k]);
const confirmedChecked = errorWhere === 'contact' ? values.confirmed === 'on' : c.confirmed;
const err = (k: string, where: string) => (errorWhere === where ? errors[k] : undefined);
const line = lineChatUrl(c, 'ทดสอบข้อความจากหลังบ้าน');
const messenger = messengerBase(c);
// แปลงจากลิงก์ Facebook ไม่ได้ (เช่นลิงก์แชร์) และไม่ได้ใส่ลิงก์ Messenger เอง → เตือน
const messengerMissing = !!c.facebookUrl && !messenger;
---

<AdminLayout back={{ href: '/admin/more', label: 'เมนู' }} title="ตั้งค่า" active="settings">
  {conflict && <p role="alert" class="mb-4 rounded-xl border-2 border-honey-400 bg-honey-50 p-3 font-medium">ยังไม่ได้บันทึก — มีคนบันทึกการตั้งค่าไปก่อนระหว่างที่คุณแก้อยู่ ตรวจค่าในฟอร์มอีกครั้ง แล้วกดบันทึกเพื่อยืนยัน</p>}
  {notice && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900"><Icon name="check" class="inline-block size-[1.15em] align-[-0.2em]" /> {notice}</p>}
  {saved && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900"><Icon name="check" class="inline-block size-[1.15em] align-[-0.2em]" /> บันทึกแล้ว — ลูกค้าบางคนอาจเห็นค่าเก่าอีกไม่เกิน 5 นาที</p>}

  <div class="grid gap-6 lg:grid-cols-2 lg:items-start">
  <form method="post" class="card space-y-4" id="contact">
    <input type="hidden" name="intent" value="contact" /><input type="hidden" name="version" value={version} />
    <div>
      <h2 class="text-lg font-semibold">ช่องทางติดต่อ</h2>
      <p class="hint">ลูกค้ากดปุ่มบนเว็บแล้วเปิดแชต/โทรหาคุณ · <strong>เว้นว่าง = ไม่แสดง</strong></p>
    </div>
    {!c.confirmed && <p class="rounded-xl bg-honey-50 p-3 text-sm"><strong>ตอนนี้เป็นข้อมูลตัวอย่าง</strong> เว็บจึงแสดงแถบเหลือง "ข้อมูลตัวอย่าง" ให้ลูกค้าเห็น กรอกข้อมูลจริงแล้วติ๊ก "ยืนยัน" ด้านล่างเพื่อเอาแถบออก</p>}

    <div><label class="label" for="lineId">LINE ID หรือ LINE Official Account</label><input class="field" id="lineId" name="lineId" value={cv('lineId')} placeholder="เช่น @metafarm" autocomplete="off" />{err('lineId', 'contact') && <p class="error">{err('lineId', 'contact')}</p>}<p class="hint">LINE OA ขึ้นต้นด้วย @</p></div>
    <div><label class="label" for="phone">เบอร์โทรศัพท์</label><input class="field" id="phone" name="phone" type="tel" value={cv('phone')} placeholder="เช่น 081-234-5678" />{err('phone', 'contact') && <p class="error">{err('phone', 'contact')}</p>}</div>
    <div><label class="label" for="facebookUrl">ลิงก์ Facebook (เพจ หรือโปรไฟล์ส่วนตัว)</label><input class="field" id="facebookUrl" name="facebookUrl" type="url" value={cv('facebookUrl')} placeholder="https://www.facebook.com/…" />{err('facebookUrl', 'contact') && <p class="error">{err('facebookUrl', 'contact')}</p>}<p class="hint">คัดลอกจากแถบที่อยู่ของหน้าเพจ/โปรไฟล์ · ปุ่ม Messenger สร้างจากลิงก์นี้</p></div>
    <div><label class="label" for="messengerUrl">ลิงก์ Messenger (ไม่บังคับ)</label><input class="field" id="messengerUrl" name="messengerUrl" type="url" value={cv('messengerUrl')} placeholder="https://m.me/…" />{err('messengerUrl', 'contact') && <p class="error">{err('messengerUrl', 'contact')}</p>}
      {messengerMissing ? <p class="hint font-medium text-honey-700">สร้างลิงก์ Messenger จากลิงก์ Facebook นี้ไม่ได้ (เช่นลิงก์แบบ "แชร์") — ใส่ลิงก์ m.me ที่นี่ หรือใช้ลิงก์ facebook.com/ชื่อเพจ แทน</p>
        : <p class="hint">เว้นว่างได้ ถ้าปุ่มทดสอบด้านล่างเปิดแชตถูกคน</p>}</div>
    <fieldset>
      <legend class="label">ช่องทางหลัก (ปุ่มใหญ่บนเว็บ)</legend>
      <div class="grid gap-2 sm:grid-cols-3">
        {([['messenger', 'Messenger'], ['line', 'LINE'], ['phone', 'โทรศัพท์']] as const).map(([k, label]) => (
          <label class="flex min-h-11 items-center gap-2 rounded-xl border border-line px-3"><input class="size-5 accent-palm-600" type="radio" name="primary" value={k} checked={cv('primary') === k} />{label}</label>
        ))}
      </div>
      <p class="hint">ช่องทางอื่นที่กรอกไว้เป็นปุ่มรอง</p>
      {err('primary', 'contact') && <p class="error">{err('primary', 'contact')}</p>}
    </fieldset>
    <div><label class="label" for="mapUrl">ลิงก์แผนที่ฟาร์ม (Google Maps)</label><input class="field" id="mapUrl" name="mapUrl" type="url" value={cv('mapUrl')} placeholder="https://maps.app.goo.gl/…" />{err('mapUrl', 'contact') && <p class="error">{err('mapUrl', 'contact')}</p>}<p class="hint">Google Maps → แชร์ → คัดลอกลิงก์</p></div>

    <label class="flex min-h-11 items-start gap-2 rounded-xl border border-line p-3">
      <input class="mt-1 size-5 accent-palm-600" type="checkbox" name="confirmed" checked={confirmedChecked} />
      <span><strong>ยืนยันว่าเป็นข้อมูลจริงแล้ว</strong><span class="block text-sm text-muted">ติ๊กแล้วแถบ "ข้อมูลตัวอย่าง" บนเว็บจะหายไป (ต้องมี LINE, Facebook/Messenger หรือเบอร์โทรอย่างน้อยหนึ่งช่อง)</span></span>
    </label>
    {err('confirmed', 'contact') && <p class="error">{err('confirmed', 'contact')}</p>}

    <div class="flex flex-wrap items-center gap-3">
      <button class="btn-primary" type="submit">บันทึกช่องทางติดต่อ</button>
      {line && <a class="inline-flex min-h-11 items-center text-sm underline" href={line} target="_blank" rel="noopener noreferrer">ทดสอบลิงก์ LINE ที่บันทึกไว้</a>}
      {messenger && <a class="inline-flex min-h-11 items-center text-sm underline" href={messenger} target="_blank" rel="noopener noreferrer">ทดสอบลิงก์ Messenger</a>}
      {telHref(c.phone) && <a class="inline-flex min-h-11 items-center text-sm underline" href={telHref(c.phone)!}>ทดสอบเบอร์โทร</a>}
      <a class="inline-flex min-h-11 items-center text-sm underline" href="/contact" target="_blank" rel="noopener">ดูหน้า "ติดต่อเรา" บนเว็บ</a>
    </div>
  </form>

  <div class="space-y-6">
  <form method="post" class="card space-y-3 scroll-mt-20" id="hero">
    <input type="hidden" name="intent" value="hero" /><input type="hidden" name="version" value={version} />
    <h2 class="text-lg font-semibold">รูปหัวหน้าแรกของเว็บ</h2>
    <p class="hint">ใส่รหัสรังที่รูปสมุดพกสวยที่สุด (รูปเก่าจาก Excel เล็กเกินไป ต้องถ่ายใหม่) · เว้นว่าง = ใช้โลโก้</p>
    <div class="flex flex-wrap items-end gap-3">
      {hero && <a href={`/img/${hero.key}`} data-zoom data-caption={`รูปหน้าแรก: รัง ${hero.code}`} aria-label={`ดูรูปรัง ${hero.code} ขยาย`} target="_blank" rel="noopener"><img src={thumbUrl(`/img/${hero.key}`)} alt={`รูปรัง ${hero.code} ที่ใช้อยู่`} width="96" height="72" class="h-[72px] w-24 rounded-xl bg-palm-50 object-cover" /></a>}
      <div class="min-w-40 flex-1">
        <label class="label" for="heroHive">รหัสรัง</label>
        <input class="field" id="heroHive" name="heroHive" autocomplete="off" placeholder="เช่น A25" value={errorWhere === 'hero' ? (values.heroHive ?? '') : settings.heroHive} />
        {err('heroHive', 'hero') && <p class="error">{err('heroHive', 'hero')}</p>}
      </div>
      <button class="btn-primary" type="submit">บันทึกรูปหน้าแรก</button>
    </div>
  </form>

  <section class="card space-y-3 scroll-mt-20" id="home-video" aria-labelledby="home-video-h">
    <h2 id="home-video-h" class="text-lg font-semibold"><Icon name="video" class="inline-block size-[1.15em] align-[-0.2em]" /> วิดีโอแนะนำฟาร์ม (หน้าแรก)</h2>
    <p class="hint">แสดงใต้ "เรื่องราวของฟาร์ม" บนหน้าแรก · ลูกค้าแตะเพื่อเล่น (ไม่เล่นเอง) · อัปโหลดอันใหม่จะแทนอันเดิม</p>
    {settings.homeVideo?.key && <video class="block w-full max-h-[60svh] rounded-2xl bg-black" controls playsinline preload="metadata" src={`/video/${settings.homeVideo.key}`} aria-label="วิดีโอแนะนำฟาร์ม"></video>}
    {settings.homeVideo?.youtubeId && <p>▶ <a class="text-palm-700 underline" href={`https://www.youtube.com/watch?v=${settings.homeVideo.youtubeId}`} target="_blank" rel="noopener noreferrer">https://www.youtube.com/watch?v={settings.homeVideo.youtubeId}</a></p>}
    {!settings.homeVideo && <p class="text-muted">ยังไม่มีวิดีโอ — หน้าแรกจะไม่แสดงส่วนวิดีโอ</p>}
    <VideoUploader id="home-video-file" action="/admin/settings/video" />
    <details open={!!settings.homeVideo?.youtubeId || errorWhere === 'homeVideo'}>
      <summary class="min-h-11 cursor-pointer py-2 font-medium">หรือวางลิงก์ YouTube แทน</summary>
      <form method="post" class="mt-2 space-y-3">
        <input type="hidden" name="intent" value="homeVideo" />
        <div>
          <label class="label" for="home-youtube">ลิงก์ YouTube</label>
          <input class="field" id="home-youtube" name="youtube" inputmode="url" placeholder="https://youtu.be/…" value={errorWhere === 'homeVideo' ? (values.youtube ?? '') : settings.homeVideo?.youtubeId ? `https://www.youtube.com/watch?v=${settings.homeVideo.youtubeId}` : ''} />
          {err('youtube', 'homeVideo') && <p class="error">{err('youtube', 'homeVideo')}</p>}
        </div>
        <button class="btn-primary w-full" type="submit">บันทึกลิงก์ YouTube</button>
      </form>
    </details>
    {settings.homeVideo && (
      <form method="post" data-confirm="เอาวิดีโอหน้าแรกออกหรือไม่?">
        <input type="hidden" name="intent" value="homeVideo" /><input type="hidden" name="youtube" value="" />
        <button class="btn-ghost w-full" type="submit">เอาวิดีโอออกจากหน้าแรก</button>
      </form>
    )}
  </section>

  <form method="post" class="card space-y-3 scroll-mt-20" id="payment">
    <input type="hidden" name="intent" value="payment" /><input type="hidden" name="version" value={version} />
    <h2 class="text-lg font-semibold">ช่องทางชำระเงิน (สำหรับข้อความสรุปออเดอร์)</h2>
    <p class="hint">ต่อท้ายข้อความสรุปออเดอร์ที่ส่งให้ลูกค้า (ไม่แสดงบนเว็บ)</p>
    <div>
      <label class="label" for="paymentInfo">เลขบัญชี / พร้อมเพย์</label>
      <textarea class="field" id="paymentInfo" name="paymentInfo" rows="3" maxlength="500" placeholder="เช่น ธ.กสิกรไทย 123-4-56789-0 ชื่อบัญชี … / พร้อมเพย์ 08x-xxx-xxxx">{errorWhere === 'payment' ? (values.paymentInfo ?? '') : settings.paymentInfo}</textarea>
      {err('paymentInfo', 'payment') && <p class="error">{err('paymentInfo', 'payment')}</p>}
    </div>
    <button class="btn-primary" type="submit">บันทึกช่องทางชำระเงิน</button>
  </form>

  <form method="post" class="card space-y-3 scroll-mt-20" id="location">
    <input type="hidden" name="intent" value="location" /><input type="hidden" name="version" value={version} />
    <h2 class="text-lg font-semibold">พิกัดฟาร์ม (สำหรับข้อมูลสภาพอากาศ)</h2>
    <p class="hint">ใช้ดึงข้อมูลฝน/อุณหภูมิในหน้า <a class="underline" href="/admin/production">ผลผลิต</a> (ไม่แสดงบนเว็บ)
      {settings.farm.isDefault && <> · <strong class="text-honey-700">ตอนนี้ใช้พิกัดประมาณ อ.ปลวกแดง</strong></>}</p>
    <div>
      <label class="label" for="coords">พิกัด (ละติจูด, ลองจิจูด)</label>
      <input class="field" id="coords" name="coords" inputmode="decimal" autocomplete="off" required value={errorWhere === 'location' ? (values.coords ?? '') : `${settings.farm.lat}, ${settings.farm.lng}`} placeholder="เช่น 12.9812, 101.2234" />
      {err('coords', 'location') && <p class="error">{err('coords', 'location')}</p>}
      <p class="hint">Google Maps → กดค้างที่ฟาร์ม → แตะพิกัดเพื่อคัดลอก</p>
    </div>
    <button class="btn-primary" type="submit">บันทึกพิกัด</button>
  </form>
  </div>
  </div>

  <section id="courses" aria-labelledby="courses-h" class="mt-8">
    <h2 id="courses-h" class="text-lg font-semibold">หลักสูตรอบรม: ราคาและระยะเวลา</h2>
    <p class="hint mb-3">ติ๊ก "ยืนยัน" เมื่อเป็นราคาจริงแล้ว ป้าย "ราคาตัวอย่าง" จะหายไป</p>
    <ul class="space-y-4">
      {courses.map((x) => {
        const w = `course:${x.slug}`;
        const mine = errorWhere === w;
        return (
          <li class="card" id={`c-${x.slug}`}>
            <form method="post" class="space-y-3">
              <input type="hidden" name="intent" value="course" /><input type="hidden" name="version" value={version} /><input type="hidden" name="slug" value={x.slug} />
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="font-semibold">{x.title}</h3>
                <p class="text-sm text-muted">บนเว็บตอนนี้: {formatPrice(x.eff.priceThb)} · {x.eff.duration} {x.eff.priceIsSample && <SampleBadge />}</p>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                <div><label class="label" for={`p-${x.slug}`}>ค่าอบรม (บาท)</label><input class="field" id={`p-${x.slug}`} name="priceThb" type="number" inputmode="numeric" min="1" required value={mine ? (values.priceThb ?? '') : x.eff.priceThb} />{err('priceThb', w) && <p class="error">{err('priceThb', w)}</p>}</div>
                <div><label class="label" for={`d-${x.slug}`}>ระยะเวลา</label><input class="field" id={`d-${x.slug}`} name="duration" required maxlength="40" value={mine ? (values.duration ?? '') : x.eff.duration} placeholder="เช่น 1 วัน" />{err('duration', w) && <p class="error">{err('duration', w)}</p>}</div>
              </div>
              <label class="flex min-h-11 items-center gap-2"><input class="size-5 accent-palm-600" type="checkbox" name="confirmed" checked={mine ? values.confirmed === 'on' : !x.eff.priceIsSample} /> ยืนยันว่าเป็นค่าจริงแล้ว</label>
              <button class="btn-primary" type="submit">บันทึก</button>
            </form>
          </li>
        );
      })}
    </ul>
  </section>
</AdminLayout>
