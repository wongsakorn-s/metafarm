---
import Icon from '../../components/Icon.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../server/db.ts';
import { getSettings, saveContact, saveLocation, savePayment, settingsVersion } from '../../server/settings.ts';
import { contactSchema, lineChatUrl, locationSchema, paymentSchema, telHref } from '../../lib/settings.ts';
import { messengerBase } from '../../lib/contact.ts';
import { fieldErrors, type FieldErrors } from '../../lib/validation.ts';

export const prerender = false;

const db = getDb();
const user = Astro.locals.user!;
let errors: FieldErrors = {};
let errorWhere = '';
let values: Record<string, string> = {};
const saved = Astro.url.searchParams.get('saved');
const notice = Astro.url.searchParams.get('msg');
/** มีคนบันทึกการตั้งค่าไปก่อน (เวอร์ชันไม่ตรง) — ค่าที่กรอกยังอยู่ในฟอร์ม กดบันทึกอีกครั้งเพื่อยืนยัน */
let conflict = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
  const intent = String(form.get('intent') ?? '');
  const version = values.version;
  if (intent === 'contact') {
    const p = contactSchema.safeParse(values);
    if (p.success && (await saveContact(db, user, p.data, version))) return Astro.redirect('/admin/settings?saved=contact', 303);
    if (p.success) conflict = true; else errors = fieldErrors(p.error);
    errorWhere = 'contact';
  } else if (intent === 'payment') {
    const p = paymentSchema.safeParse(values);
    if (p.success && (await savePayment(db, user, p.data, version))) return Astro.redirect('/admin/settings?saved=payment#payment', 303);
    if (p.success) conflict = true; else errors = fieldErrors(p.error);
    errorWhere = 'payment';
  } else if (intent === 'location') {
    const p = locationSchema.safeParse(values);
    if (p.success && (await saveLocation(db, user, p.data, version))) return Astro.redirect('/admin/settings?saved=location#location', 303);
    if (p.success) conflict = true; else errors = fieldErrors(p.error);
    errorWhere = 'location';
  }
}

const settings = await getSettings(db);
// ทุกฟอร์มส่งเวอร์ชันนี้กลับมา (ชนกัน = ได้เวอร์ชันล่าสุดแล้ว กดบันทึกอีกครั้งเพื่อยืนยันค่าของคุณ)
const version = await settingsVersion(db);
const c = settings.contact;
// ค่าที่แสดงในฟอร์ม: ค่าที่เพิ่งส่งมา (กรณีมี error) ไม่งั้นค่าปัจจุบัน
const cv = (k: 'lineId' | 'phone' | 'facebookUrl' | 'messengerUrl' | 'mapUrl' | 'primary') => (errorWhere === 'contact' ? (values[k] ?? '') : c[k]);
const confirmedChecked = errorWhere === 'contact' ? values.confirmed === 'on' : c.confirmed;
const err = (k: string, where: string) => (errorWhere === where ? errors[k] : undefined);
const line = lineChatUrl(c, 'ทดสอบข้อความจากหลังบ้าน');
const messenger = messengerBase(c);
// แปลงจากลิงก์ Facebook ไม่ได้ (เช่นลิงก์แชร์) และไม่ได้ใส่ลิงก์ Messenger เอง → เตือน
const messengerMissing = !!c.facebookUrl && !messenger;
---

<AdminLayout back={{ href: '/admin/more', label: 'เมนู' }} title="ติดต่อและชำระเงิน" active="settings">
  {conflict && <p role="alert" class="mb-4 rounded-xl border-2 border-honey-400 bg-honey-50 p-3 font-medium">ยังไม่ได้บันทึก — มีคนบันทึกการตั้งค่าไปก่อนระหว่างที่คุณแก้อยู่ ตรวจค่าในฟอร์มอีกครั้ง แล้วกดบันทึกเพื่อยืนยัน</p>}
  {notice && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900"><Icon name="check" class="inline-block size-[1.15em] align-[-0.2em]" /> {notice}</p>}
  {saved && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900"><Icon name="check" class="inline-block size-[1.15em] align-[-0.2em]" /> บันทึกแล้ว — ลูกค้าบางคนอาจเห็นค่าเก่าอีกไม่เกิน 5 นาที</p>}

  <div class="grid gap-6 lg:grid-cols-2 lg:items-start">
  <form method="post" class="card space-y-4" id="contact">
    <input type="hidden" name="intent" value="contact" /><input type="hidden" name="version" value={version} />
    <div>
      <h2 class="text-lg font-semibold">ช่องทางติดต่อ</h2>
      <p class="hint">ลูกค้ากดปุ่มบนเว็บแล้วเปิดแชต/โทรหาคุณ · <strong>เว้นว่าง = ไม่แสดง</strong></p>
    </div>
    {!c.confirmed && <p class="rounded-xl bg-honey-50 p-3 text-sm"><strong>ตอนนี้ยังเป็นข้อมูลตัวอย่าง</strong> เว็บจึงมีแถบเหลือง "ข้อมูลตัวอย่าง" ให้ลูกค้าเห็น พอกรอกข้อมูลจริงแล้วติ๊ก "ยืนยัน" ด้านล่าง แถบจะหายไป</p>}

    <div><label class="label" for="lineId">LINE ID หรือ LINE Official Account</label><input class="field" id="lineId" name="lineId" value={cv('lineId')} placeholder="เช่น @metafarm" autocomplete="off" />{err('lineId', 'contact') && <p class="error">{err('lineId', 'contact')}</p>}<p class="hint">LINE OA ขึ้นต้นด้วย @</p></div>
    <div><label class="label" for="phone">เบอร์โทรศัพท์</label><input class="field" id="phone" name="phone" type="tel" value={cv('phone')} placeholder="เช่น 081-234-5678" />{err('phone', 'contact') && <p class="error">{err('phone', 'contact')}</p>}</div>
    <div><label class="label" for="facebookUrl">ลิงก์ Facebook (เพจ หรือโปรไฟล์ส่วนตัว)</label><input class="field" id="facebookUrl" name="facebookUrl" type="url" value={cv('facebookUrl')} placeholder="https://www.facebook.com/…" />{err('facebookUrl', 'contact') && <p class="error">{err('facebookUrl', 'contact')}</p>}<p class="hint">คัดลอกลิงก์จากช่องที่อยู่ด้านบนของหน้าเพจ/โปรไฟล์ Facebook · ปุ่ม Messenger บนเว็บสร้างจากลิงก์นี้</p></div>
    <div><label class="label" for="messengerUrl">ลิงก์ Messenger (ไม่บังคับ)</label><input class="field" id="messengerUrl" name="messengerUrl" type="url" value={cv('messengerUrl')} placeholder="https://m.me/…" />{err('messengerUrl', 'contact') && <p class="error">{err('messengerUrl', 'contact')}</p>}
      {messengerMissing ? <p class="hint font-medium text-honey-700">ระบบสร้างปุ่ม Messenger จากลิงก์ Facebook นี้ไม่ได้ (เช่นลิงก์ที่ได้จากปุ่ม "แชร์") — ให้ใส่ลิงก์ m.me ในช่องนี้ หรือใช้ลิงก์แบบ facebook.com/ชื่อเพจ แทน</p>
        : <p class="hint">เว้นว่างได้ ถ้าปุ่มทดสอบด้านล่างเปิดแชตถูกคน</p>}</div>
    <fieldset>
      <legend class="label">ช่องทางหลัก (ปุ่มใหญ่บนเว็บ)</legend>
      <div class="grid gap-2 sm:grid-cols-3">
        {([['messenger', 'Messenger'], ['line', 'LINE'], ['phone', 'โทรศัพท์']] as const).map(([k, label]) => (
          <label class="flex min-h-11 items-center gap-2 rounded-xl border border-line px-3"><input class="size-5 accent-palm-600" type="radio" name="primary" value={k} checked={cv('primary') === k} />{label}</label>
        ))}
      </div>
      <p class="hint">ช่องทางอื่นที่กรอกไว้เป็นปุ่มรอง</p>
      {err('primary', 'contact') && <p class="error">{err('primary', 'contact')}</p>}
    </fieldset>
    <div><label class="label" for="mapUrl">ลิงก์แผนที่ฟาร์ม (Google Maps)</label><input class="field" id="mapUrl" name="mapUrl" type="url" value={cv('mapUrl')} placeholder="https://maps.app.goo.gl/…" />{err('mapUrl', 'contact') && <p class="error">{err('mapUrl', 'contact')}</p>}<p class="hint">Google Maps → แชร์ → คัดลอกลิงก์</p></div>

    <label class="flex min-h-11 items-start gap-2 rounded-xl border border-line p-3">
      <input class="mt-1 size-5 accent-palm-600" type="checkbox" name="confirmed" checked={confirmedChecked} />
      <span><strong>ยืนยันว่าเป็นข้อมูลจริงแล้ว</strong><span class="block text-sm text-muted">ติ๊กแล้วแถบ "ข้อมูลตัวอย่าง" บนเว็บจะหายไป (ต้องมี LINE, Facebook/Messenger หรือเบอร์โทรอย่างน้อยหนึ่งช่อง)</span></span>
    </label>
    {err('confirmed', 'contact') && <p class="error">{err('confirmed', 'contact')}</p>}

    <div class="flex flex-wrap items-center gap-3">
      <button class="btn-primary" type="submit">บันทึกช่องทางติดต่อ</button>
      {line && <a class="inline-flex min-h-11 items-center text-sm underline" href={line} target="_blank" rel="noopener noreferrer">ทดสอบลิงก์ LINE ที่บันทึกไว้</a>}
      {messenger && <a class="inline-flex min-h-11 items-center text-sm underline" href={messenger} target="_blank" rel="noopener noreferrer">ทดสอบลิงก์ Messenger</a>}
      {telHref(c.phone) && <a class="inline-flex min-h-11 items-center text-sm underline" href={telHref(c.phone)!}>ทดสอบเบอร์โทร</a>}
      <a class="inline-flex min-h-11 items-center text-sm underline" href="/contact" target="_blank" rel="noopener">ดูหน้า "ติดต่อเรา" บนเว็บ</a>
    </div>
  </form>

  <div class="space-y-6">
  <form method="post" class="card space-y-3 scroll-mt-20" id="payment">
    <input type="hidden" name="intent" value="payment" /><input type="hidden" name="version" value={version} />
    <h2 class="text-lg font-semibold">ช่องทางชำระเงิน (สำหรับข้อความสรุปออเดอร์)</h2>
    <p class="hint">ต่อท้ายข้อความสรุปออเดอร์ที่ส่งให้ลูกค้า (ไม่แสดงบนเว็บ)</p>
    <div>
      <label class="label" for="paymentInfo">เลขบัญชี / พร้อมเพย์</label>
      <textarea class="field" id="paymentInfo" name="paymentInfo" rows="3" maxlength="500" placeholder="เช่น ธ.กสิกรไทย 123-4-56789-0 ชื่อบัญชี … / พร้อมเพย์ 08x-xxx-xxxx">{errorWhere === 'payment' ? (values.paymentInfo ?? '') : settings.paymentInfo}</textarea>
      {err('paymentInfo', 'payment') && <p class="error">{err('paymentInfo', 'payment')}</p>}
    </div>
    <button class="btn-primary" type="submit">บันทึกช่องทางชำระเงิน</button>
  </form>

  <form method="post" class="card space-y-3 scroll-mt-20" id="location">
    <input type="hidden" name="intent" value="location" /><input type="hidden" name="version" value={version} />
    <h2 class="text-lg font-semibold">พิกัดฟาร์ม (สำหรับข้อมูลสภาพอากาศ)</h2>
    <p class="hint">ใช้ดึงข้อมูลฝนและอุณหภูมิมาแสดงในหน้า <a class="underline" href="/admin/production">ผลผลิต</a> (ไม่แสดงบนเว็บ)
      {settings.farm.isDefault && <> · <strong class="text-honey-700">ตอนนี้ใช้พิกัดประมาณ อ.ปลวกแดง</strong></>}</p>
    <div>
      <label class="label" for="coords">พิกัด (ละติจูด, ลองจิจูด)</label>
      <input class="field" id="coords" name="coords" inputmode="decimal" autocomplete="off" required value={errorWhere === 'location' ? (values.coords ?? '') : `${settings.farm.lat}, ${settings.farm.lng}`} placeholder="เช่น 12.9812, 101.2234" />
      {err('coords', 'location') && <p class="error">{err('coords', 'location')}</p>}
      <p class="hint">ใน Google Maps กดค้างที่ตำแหน่งฟาร์ม แล้วแตะตัวเลขพิกัดเพื่อคัดลอก</p>
    </div>
    <button class="btn-primary" type="submit">บันทึกพิกัด</button>
  </form>
  </div>
  </div>


</AdminLayout>
