---
import Icon from '../../components/Icon.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import { getDb } from '../../server/db.ts';
import { getSettings, saveContact, saveCourse, saveHero, saveLocation, savePayment } from '../../server/settings.ts';
import { getHeroPhoto } from '../../server/public.ts';
import { thumbUrl } from '../../lib/media.ts';
import { listTraining } from '../../lib/content.ts';
import { contactSchema, courseSchema, effectiveCourse, heroSchema, lineChatUrl, locationSchema, paymentSchema, telHref } from '../../lib/settings.ts';
import { messengerBase } from '../../lib/contact.ts';
import { fieldErrors, type FieldErrors } from '../../lib/validation.ts';
import { formatPrice } from '../../lib/products.ts';

export const prerender = false;

const db = getDb();
const user = Astro.locals.user!;
let errors: FieldErrors = {};
let errorWhere = '';
let values: Record<string, string> = {};
const saved = Astro.url.searchParams.get('saved');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
  const intent = String(form.get('intent') ?? '');
  if (intent === 'contact') {
    const p = contactSchema.safeParse(values);
    if (p.success) { await saveContact(db, user, p.data); return Astro.redirect('/admin/settings?saved=contact', 303); }
    errors = fieldErrors(p.error); errorWhere = 'contact';
  } else if (intent === 'course') {
    const p = courseSchema.safeParse(values);
    if (p.success) { await saveCourse(db, user, p.data); return Astro.redirect(`/admin/settings?saved=course#c-${p.data.slug}`, 303); }
    errors = fieldErrors(p.error); errorWhere = `course:${values.slug}`;
  } else if (intent === 'payment') {
    const p = paymentSchema.safeParse(values);
    if (p.success) { await savePayment(db, user, p.data); return Astro.redirect('/admin/settings?saved=payment#payment', 303); }
    errors = fieldErrors(p.error); errorWhere = 'payment';
  } else if (intent === 'hero') {
    const p = heroSchema.safeParse(values);
    if (!p.success) { errors = fieldErrors(p.error); errorWhere = 'hero'; }
    else if (p.data.heroHive && !(await getHeroPhoto(db, p.data.heroHive))) { errors = { heroHive: `รัง ${p.data.heroHive} ยังไม่มีรูปสมุดพก (หรือไม่มีรังนี้) — เลือกรังที่มีรูป` }; errorWhere = 'hero'; }
    else { await saveHero(db, user, p.data.heroHive); return Astro.redirect('/admin/settings?saved=hero#hero', 303); }
  } else if (intent === 'location') {
    const p = locationSchema.safeParse(values);
    if (p.success) { await saveLocation(db, user, p.data); return Astro.redirect('/admin/settings?saved=location#location', 303); }
    errors = fieldErrors(p.error); errorWhere = 'location';
  }
}

const settings = await getSettings(db);
const hero = await getHeroPhoto(db, settings.heroHive);
const c = settings.contact;
const courses = listTraining().map((x) => ({ ...x, eff: effectiveCourse(x, settings.courses[x.slug]) }));
// ค่าที่แสดงในฟอร์ม: ค่าที่เพิ่งส่งมา (กรณีมี error) ไม่งั้นค่าปัจจุบัน
const cv = (k: 'lineId' | 'phone' | 'facebookUrl' | 'messengerUrl' | 'mapUrl' | 'primary') => (errorWhere === 'contact' ? (values[k] ?? '') : c[k]);
const confirmedChecked = errorWhere === 'contact' ? values.confirmed === 'on' : c.confirmed;
const err = (k: string, where: string) => (errorWhere === where ? errors[k] : undefined);
const line = lineChatUrl(c, 'ทดสอบข้อความจากหลังบ้าน');
const messenger = messengerBase(c);
// แปลงจากลิงก์ Facebook ไม่ได้ (เช่นลิงก์แชร์) และไม่ได้ใส่ลิงก์ Messenger เอง → เตือน
const messengerMissing = !!c.facebookUrl && !messenger;
---

<AdminLayout back={{ href: '/admin/more', label: 'เมนู' }} title="ตั้งค่า" active="settings">
  {saved && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900"><Icon name="check" class="inline-block size-[1.15em] align-[-0.2em]" /> บันทึกแล้ว — เว็บใช้ค่าใหม่ทันที แต่ลูกค้าบางคนอาจยังเห็นค่าเก่าอีกไม่เกิน ~5 นาที (แคชของเว็บ) · แก้ไขได้ทุกเมื่อ</p>}

  <form method="post" class="card mb-8 max-w-2xl space-y-4" id="contact">
    <input type="hidden" name="intent" value="contact" />
    <div>
      <h2 class="text-lg font-semibold">ช่องทางติดต่อ</h2>
      <p class="hint">ใช้บนทุกหน้าเว็บ (ปุ่มติดต่อ ส่วนท้ายหน้า หน้าติดต่อเรา) · ลูกค้ากดแล้วเด้งไปแชต/โทรหาคุณ · <strong>เว้นว่าง = ซ่อนช่องทางนั้น</strong></p>
    </div>
    {!c.confirmed && <p class="rounded-xl bg-honey-50 p-3 text-sm"><strong>ตอนนี้เป็นข้อมูลตัวอย่าง</strong> เว็บจึงแสดงแถบเหลือง "ข้อมูลตัวอย่าง" ให้ลูกค้าเห็น กรอกข้อมูลจริงแล้วติ๊ก "ยืนยัน" ด้านล่างเพื่อเอาแถบออก</p>}

    <div><label class="label" for="lineId">LINE ID หรือ LINE Official Account</label><input class="field" id="lineId" name="lineId" value={cv('lineId')} placeholder="เช่น @metafarm" autocomplete="off" />{err('lineId', 'contact') && <p class="error">{err('lineId', 'contact')}</p>}<p class="hint">LINE OA ขึ้นต้นด้วย @ (ปุ่มจะใส่ข้อความ "สนใจรัง A25 ราคา …" ให้ลูกค้าอัตโนมัติ) ถ้าเป็น ID ส่วนตัวจะเปิดโปรไฟล์ให้</p></div>
    <div><label class="label" for="phone">เบอร์โทรศัพท์</label><input class="field" id="phone" name="phone" type="tel" value={cv('phone')} placeholder="เช่น 081-234-5678" />{err('phone', 'contact') && <p class="error">{err('phone', 'contact')}</p>}</div>
    <div><label class="label" for="facebookUrl">ลิงก์ Facebook (เพจ หรือโปรไฟล์ส่วนตัว)</label><input class="field" id="facebookUrl" name="facebookUrl" type="url" value={cv('facebookUrl')} placeholder="https://www.facebook.com/…" />{err('facebookUrl', 'contact') && <p class="error">{err('facebookUrl', 'contact')}</p>}<p class="hint">ปุ่ม Messenger สร้างจากลิงก์นี้ให้เอง (เปิดหน้าเพจ/โปรไฟล์ใน Facebook แล้วคัดลอกลิงก์จากแถบที่อยู่)</p></div>
    <div><label class="label" for="messengerUrl">ลิงก์ Messenger (ไม่บังคับ)</label><input class="field" id="messengerUrl" name="messengerUrl" type="url" value={cv('messengerUrl')} placeholder="https://m.me/…" />{err('messengerUrl', 'contact') && <p class="error">{err('messengerUrl', 'contact')}</p>}
      {messengerMissing ? <p class="hint font-medium text-honey-700">สร้างลิงก์ Messenger จากลิงก์ Facebook นี้ไม่ได้ (เช่นลิงก์แบบ "แชร์") — ใส่ลิงก์ m.me ที่นี่ หรือใช้ลิงก์ facebook.com/ชื่อเพจ แทน</p>
        : <p class="hint">เว้นว่างได้ ถ้าปุ่มที่สร้างให้เปิดแชตถูกคนแล้ว (กด "ทดสอบลิงก์ Messenger" ด้านล่าง)</p>}</div>
    <fieldset>
      <legend class="label">ช่องทางหลัก (ปุ่มใหญ่บนเว็บ)</legend>
      <div class="grid gap-2 sm:grid-cols-3">
        {([['messenger', 'Messenger'], ['line', 'LINE'], ['phone', 'โทรศัพท์']] as const).map(([k, label]) => (
          <label class="flex min-h-11 items-center gap-2 rounded-xl border border-line px-3"><input class="size-5 accent-palm-600" type="radio" name="primary" value={k} checked={cv('primary') === k} />{label}</label>
        ))}
      </div>
      <p class="hint">ช่องทางที่เหลือ (ที่กรอกไว้) เป็นปุ่มรองข้าง ๆ · ถ้าช่องทางหลักเว้นว่าง เว็บใช้ช่องทางถัดไปแทน</p>
      {err('primary', 'contact') && <p class="error">{err('primary', 'contact')}</p>}
    </fieldset>
    <div><label class="label" for="mapUrl">ลิงก์แผนที่ฟาร์ม (Google Maps)</label><input class="field" id="mapUrl" name="mapUrl" type="url" value={cv('mapUrl')} placeholder="https://maps.app.goo.gl/…" />{err('mapUrl', 'contact') && <p class="error">{err('mapUrl', 'contact')}</p>}<p class="hint">เปิด Google Maps ที่ตำแหน่งฟาร์ม → กด "แชร์" → "คัดลอกลิงก์" แล้ววางที่นี่</p></div>

    <label class="flex min-h-11 items-start gap-2 rounded-xl border border-line p-3">
      <input class="mt-1 size-5 accent-palm-600" type="checkbox" name="confirmed" checked={confirmedChecked} />
      <span><strong>ยืนยันว่าเป็นข้อมูลจริงแล้ว</strong><span class="block text-sm text-muted">ติ๊กแล้วแถบ "ข้อมูลตัวอย่าง" บนเว็บจะหายไป (ต้องมี LINE, Facebook/Messenger หรือเบอร์โทรอย่างน้อยหนึ่งช่อง)</span></span>
    </label>
    {err('confirmed', 'contact') && <p class="error">{err('confirmed', 'contact')}</p>}

    <div class="flex flex-wrap items-center gap-3">
      <button class="btn-primary" type="submit">บันทึกช่องทางติดต่อ</button>
      {line && <a class="inline-flex min-h-11 items-center text-sm underline" href={line} target="_blank" rel="noopener noreferrer">ทดสอบลิงก์ LINE ที่บันทึกไว้</a>}
      {messenger && <a class="inline-flex min-h-11 items-center text-sm underline" href={messenger} target="_blank" rel="noopener noreferrer">ทดสอบลิงก์ Messenger</a>}
      {telHref(c.phone) && <a class="inline-flex min-h-11 items-center text-sm underline" href={telHref(c.phone)!}>ทดสอบเบอร์โทร</a>}
      <a class="inline-flex min-h-11 items-center text-sm underline" href="/contact" target="_blank" rel="noopener">ดูหน้า "ติดต่อเรา" บนเว็บ</a>
    </div>
  </form>

  <form method="post" class="card mb-8 max-w-2xl space-y-3 scroll-mt-20" id="hero">
    <input type="hidden" name="intent" value="hero" />
    <h2 class="text-lg font-semibold">รูปหัวหน้าแรกของเว็บ</h2>
    <p class="hint">ใช้รูปสมุดพกรูปแรกของรังที่เลือก (เลือกรังที่รูปสวยที่สุด) · เว้นว่าง = แสดงโลโก้ · เปลี่ยนได้ทุกเมื่อ</p>
    <div class="flex flex-wrap items-end gap-3">
      {hero && <img src={thumbUrl(`/img/${hero.key}`)} alt={`รูปรัง ${hero.code} ที่ใช้อยู่`} width="96" height="72" class="h-[72px] w-24 rounded-xl bg-palm-50 object-cover" />}
      <div class="min-w-40 flex-1">
        <label class="label" for="heroHive">รหัสรัง</label>
        <input class="field" id="heroHive" name="heroHive" autocomplete="off" placeholder="เช่น A25" value={errorWhere === 'hero' ? (values.heroHive ?? '') : settings.heroHive} />
        {err('heroHive', 'hero') && <p class="error">{err('heroHive', 'hero')}</p>}
      </div>
      <button class="btn-primary" type="submit">บันทึกรูปหน้าแรก</button>
    </div>
  </form>

  <form method="post" class="card mb-8 max-w-2xl space-y-3 scroll-mt-20" id="payment">
    <input type="hidden" name="intent" value="payment" />
    <h2 class="text-lg font-semibold">ช่องทางชำระเงิน (สำหรับข้อความสรุปออเดอร์)</h2>
    <p class="hint">ใส่ท้ายข้อความสรุปออเดอร์ที่ "รอชำระ" เวลากดคัดลอกไปส่งให้ลูกค้าทางแชต — ไม่แสดงบนเว็บสาธารณะ</p>
    <div>
      <label class="label" for="paymentInfo">เลขบัญชี / พร้อมเพย์</label>
      <textarea class="field" id="paymentInfo" name="paymentInfo" rows="3" maxlength="500" placeholder="เช่น ธ.กสิกรไทย 123-4-56789-0 ชื่อบัญชี … / พร้อมเพย์ 08x-xxx-xxxx">{errorWhere === 'payment' ? (values.paymentInfo ?? '') : settings.paymentInfo}</textarea>
      {err('paymentInfo', 'payment') && <p class="error">{err('paymentInfo', 'payment')}</p>}
    </div>
    <button class="btn-primary" type="submit">บันทึกช่องทางชำระเงิน</button>
  </form>

  <form method="post" class="card mb-8 max-w-2xl space-y-3 scroll-mt-20" id="location">
    <input type="hidden" name="intent" value="location" />
    <h2 class="text-lg font-semibold">พิกัดฟาร์ม (สำหรับข้อมูลสภาพอากาศ)</h2>
    <p class="hint">ใช้ดึงฝนและอุณหภูมิมาเทียบกับผลผลิตในหน้า <a class="underline" href="/admin/production">ผลผลิต + อากาศ</a> — ไม่แสดงบนเว็บสาธารณะ
      {settings.farm.isDefault && <> · <strong class="text-honey-700">ตอนนี้ใช้พิกัดประมาณ อ.ปลวกแดง</strong></>}</p>
    <div>
      <label class="label" for="coords">พิกัด (ละติจูด, ลองจิจูด)</label>
      <input class="field" id="coords" name="coords" inputmode="decimal" autocomplete="off" required value={errorWhere === 'location' ? (values.coords ?? '') : `${settings.farm.lat}, ${settings.farm.lng}`} placeholder="เช่น 12.9812, 101.2234" />
      {err('coords', 'location') && <p class="error">{err('coords', 'location')}</p>}
      <p class="hint">เปิด Google Maps → กดค้างที่ตำแหน่งฟาร์ม → แตะตัวเลขพิกัดที่ขึ้นมาเพื่อคัดลอก แล้ววางที่นี่ · เปลี่ยนพิกัดแล้ว ระบบดึงข้อมูลอากาศใหม่ให้เอง</p>
    </div>
    <button class="btn-primary" type="submit">บันทึกพิกัด</button>
  </form>

  <section id="courses" aria-labelledby="courses-h" class="max-w-2xl">
    <h2 id="courses-h" class="text-lg font-semibold">หลักสูตรอบรม: ราคาและระยะเวลา</h2>
    <p class="hint mb-3">แก้ราคา/ระยะเวลาที่แสดงบนเว็บ (เนื้อหาหลักสูตรอยู่ในไฟล์ <code>content/training/</code>) · ติ๊ก "ยืนยัน" เมื่อเป็นค่าจริงแล้ว ป้าย "ราคาตัวอย่าง" จะหายไป</p>
    <ul class="space-y-4">
      {courses.map((x) => {
        const w = `course:${x.slug}`;
        const mine = errorWhere === w;
        return (
          <li class="card" id={`c-${x.slug}`}>
            <form method="post" class="space-y-3">
              <input type="hidden" name="intent" value="course" /><input type="hidden" name="slug" value={x.slug} />
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="font-semibold">{x.title}</h3>
                <p class="text-sm text-muted">บนเว็บตอนนี้: {formatPrice(x.eff.priceThb)} · {x.eff.duration} {x.eff.priceIsSample && <SampleBadge />}</p>
              </div>
              <div class="grid gap-3 sm:grid-cols-2">
                <div><label class="label" for={`p-${x.slug}`}>ค่าอบรม (บาท)</label><input class="field" id={`p-${x.slug}`} name="priceThb" type="number" inputmode="numeric" min="1" required value={mine ? (values.priceThb ?? '') : x.eff.priceThb} />{err('priceThb', w) && <p class="error">{err('priceThb', w)}</p>}</div>
                <div><label class="label" for={`d-${x.slug}`}>ระยะเวลา</label><input class="field" id={`d-${x.slug}`} name="duration" required maxlength="40" value={mine ? (values.duration ?? '') : x.eff.duration} placeholder="เช่น 1 วัน" />{err('duration', w) && <p class="error">{err('duration', w)}</p>}</div>
              </div>
              <label class="flex min-h-11 items-center gap-2"><input class="size-5 accent-palm-600" type="checkbox" name="confirmed" checked={mine ? values.confirmed === 'on' : !x.eff.priceIsSample} /> ยืนยันว่าเป็นค่าจริงแล้ว</label>
              <button class="btn-primary" type="submit">บันทึก</button>
            </form>
          </li>
        );
      })}
    </ul>
  </section>
</AdminLayout>
