---
import Icon from '../../components/Icon.astro';
import Val from '../../components/Val.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../server/db.ts';
import { listHivesWithoutPhoto } from '../../server/hives.ts';
import { originLabel, statusClass, statusLabel } from '../../lib/labels.ts';
import { provinceOf } from '../../lib/place.ts';
import { formatThaiDate } from '../../lib/thai-date.ts';
import { canManageFarm as isOwnerUser } from '../../lib/permissions.ts';

export const prerender = false;

const includeAll = Astro.url.searchParams.get('all') === '1';
const rows = await listHivesWithoutPhoto(getDb(), includeAll);
const msg = Astro.url.searchParams.get('msg');
---

<AdminLayout back={isOwnerUser(Astro.locals.user) ? { href: '/admin/readiness', label: 'เตรียมเปิดเว็บ' } : { href: '/admin/more', label: 'เมนู' }} title="รังรอถ่ายรูป" active="photos">
  {msg && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900"><Icon name="check" class="inline-block size-[1.15em] align-[-0.2em]" /> {msg}</p>}

  <section class="card mb-4">
    <p class="text-lg"><strong id="left" data-total={rows.length}>{rows.length}</strong> รังที่ยังไม่มีรูปสมุดพก {!includeAll && <span class="text-sm text-muted">(เฉพาะรังที่ยังอยู่)</span>}</p>
    <p class="hint">เดินไปที่รัง กด <strong><Icon name="camera" class="inline-block size-[1.15em] align-[-0.2em]" /> ถ่ายรูป</strong> หรือ <strong><Icon name="image" class="inline-block size-[1.15em] align-[-0.2em]" /> เลือกรูป</strong> ระบบย่อรูปให้ก่อนส่ง (ประหยัดเน็ต) · เพิ่มรูปอื่น/ลบรูปได้ที่หน้ารังนั้นทีหลัง</p>
    <div class="mt-3 rounded-xl border border-palm-100 bg-palm-50/70 p-3 text-sm text-palm-900">
      <p class="font-semibold text-palm-800"><Icon name="info" class="inline-block size-[1.15em] align-[-0.2em]" /> คำแนะนำการถ่ายรูปสมุดพก:</p>
      <p class="mt-1 leading-relaxed text-muted">ควรถ่ายมุมกว้าง ให้เห็นตัวรังพร้อมสภาพแวดล้อมที่ตั้ง เพื่อให้จำได้และเดินหารังในสวนได้ง่าย</p>
    </div>
    <p class="mt-2 text-sm"><a class="underline" href={includeAll ? '/admin/photos' : '/admin/photos?all=1'}>{includeAll ? 'แสดงเฉพาะรังที่ยังอยู่' : 'แสดงรวมรังที่ขายแล้ว/ล่มด้วย'}</a></p>
  </section>

  {rows.length === 0 ? (
    <div class="card text-center"><Icon name="celebrate" class="mx-auto size-10 text-palm-600" /><p class="mt-1 text-lg font-semibold">ทุกรังมีรูปสมุดพกแล้ว</p></div>
  ) : (
    <ul class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3" id="queue">
      {rows.map((h) => (
        <li class="card space-y-3" data-code={h.code}>
          <div class="flex flex-wrap items-center gap-2">
            <a class="inline-flex min-h-11 min-w-11 items-center text-xl font-bold hover:underline" href={`/admin/hives/${h.code}`}>{h.code}</a>
            <span class:list={['badge', statusClass[h.status]]}>{statusLabel[h.status]}</span>
            {h.forSale && <span class="badge bg-honey-400 text-ink">ตั้งขาย</span>}
          </div>
          <p class="text-sm text-muted">{originLabel[h.origin]}{provinceOf(h.originPlace) ? ` · ${provinceOf(h.originPlace)}` : ''} · ได้มา <Val v={formatThaiDate(h.acquiredOn, h.acquiredOnPrecision ?? 'day')} /></p>

          <form method="post" action={`/admin/hives/${h.code}/media`} enctype="multipart/form-data" data-photo-form class="space-y-2">
            <input type="hidden" name="intent" value="upload" /><input type="hidden" name="kind" value="passport" /><input type="hidden" name="back" value="/admin/photos" />
            <div class="grid grid-cols-2 gap-2">
              <label class="btn-primary cursor-pointer" for={`cam-${h.code}`}><Icon name="camera" class="inline-block size-[1.15em] align-[-0.2em]" /> ถ่ายรูป</label>
              <label class="btn-ghost cursor-pointer" for={`pick-${h.code}`}><Icon name="image" class="inline-block size-[1.15em] align-[-0.2em]" /> เลือกรูป</label>
            </div>
            <input class="sr-only" id={`cam-${h.code}`} name="file" type="file" accept="image/*" capture="environment" />
            <input class="sr-only" id={`pick-${h.code}`} name="file" type="file" accept="image/jpeg,image/png,image/webp,image/*" multiple />
            <noscript><button class="btn-ghost w-full" type="submit">อัปโหลด</button></noscript>
            <button type="button" class="btn-primary w-full" data-retry hidden>ส่งอีกครั้ง</button>
            <p class="text-sm" data-state role="status" aria-live="polite"></p>
          </form>
        </li>
      ))}
    </ul>
  )}
</AdminLayout>

<script>
  import { appendPrepared, resizeAll, type Prepared } from '../../scripts/resize-image';
  import { newBatchId } from '../../scripts/upload';
  import { fieldsOf, QUEUED_MSG, SESSION_QUEUED_MSG, sendOrQueue } from '../../scripts/outbox';

  const PHOTO_UNSAVED_MSG = 'ยังไม่ได้บันทึก — สัญญาณไม่ดี และเครื่องนี้เก็บรูปไว้ไม่ได้ (พื้นที่เต็มหรือโหมดส่วนตัว) รูปยังอยู่ในหน้านี้ อย่าเพิ่งปิดหน้า กด "ส่งอีกครั้ง" เมื่อสัญญาณดีขึ้น';

  const left = document.getElementById('left');
  const bump = () => { if (left) left.textContent = String(Math.max(0, Number(left.textContent) - 1)); };

  document.querySelectorAll<HTMLFormElement>('form[data-photo-form]').forEach((form) => {
    const state = form.querySelector<HTMLElement>('[data-state]')!;
    const inputs = [...form.querySelectorAll<HTMLInputElement>('input[type=file]')];
    const retry = form.querySelector<HTMLButtonElement>('[data-retry]')!;
    const labels = [...form.querySelectorAll('label')];
    const lock = (on: boolean) => labels.forEach((l) => {
      l.classList.toggle('pointer-events-none', on);
      l.classList.toggle('opacity-60', on);
    });
    const say = (msg: string, tone: 'busy' | 'ok' | 'bad') => {
      state.className = tone === 'ok' ? 'text-sm font-semibold text-palm-700' : tone === 'bad' ? 'text-sm font-medium text-danger' : 'text-sm';
      state.textContent = msg;
    };

    // รูปที่ย่อแล้วของชุดล่าสุด — เก็บไว้ส่งซ้ำได้โดยไม่ต้องเดินกลับไปถ่ายใหม่ (รูปจากกล้องบางเครื่องไม่ถูกเก็บในอัลบั้ม)
    let pending: Prepared[] = [];
    let batch = '';

    // คิวรอส่ง (Phase 5.5): รูปเก็บในเครื่องก่อน · สัญญาณไม่ดี = เดินไปรังถัดไปได้เลย ระบบส่งเองทีหลัง
    const send = async () => {
      lock(true);
      try {
        await sendBatch();
      } catch {
        // ผิดพลาดในเครื่อง (อ่านไฟล์/ฐานข้อมูลในเครื่อง) — ปุ่มไม่ค้าง และรูปที่ย่อแล้วยังอยู่ให้กดส่งอีกครั้ง
        say(PHOTO_UNSAVED_MSG, 'bad');
        lock(false);
        retry.hidden = false;
      }
    };
    const sendBatch = async () => {
      const fd = new FormData();
      for (const [k, v] of new FormData(form)) if (!(v instanceof File)) fd.append(k, v);
      fd.set('batch', batch);
      appendPrepared(fd, pending);
      say(`กำลังส่ง ${pending.length} รูป…`, 'busy');
      const code = form.closest('li')?.dataset.code ?? '';
      const o = await sendOrQueue({ kind: 'photo', url: form.action, fields: await fieldsOf(fd), label: `${code} · รูปสมุดพก ${pending.length} รูป`, bytes: pending.reduce((n, p) => n + p.file.size + (p.thumb?.size ?? 0) + (p.medium?.size ?? 0), 0) });
      if (o.kind === 'unsaved') {
        // ส่งไม่ได้และเก็บลงเครื่องก็ไม่ได้ — เก็บรูปที่ย่อแล้ว (และรหัสชุดเดิม) ไว้ในหน้านี้ให้กดส่งอีกครั้ง
        // เดิมล้างรูปทิ้ง: รูปที่ถ่ายจากกล้องโดยตรง (ไม่ได้เก็บในอัลบั้ม) หายไปเลย
        say(PHOTO_UNSAVED_MSG, 'bad');
        lock(false);
        retry.hidden = false;
        inputs.forEach((i) => (i.value = ''));
        return;
      }
      if (o.kind === 'invalid') {
        // เซิร์ฟเวอร์ไม่รับไฟล์ (เต็ม/ไม่ใช่รูป) → ต้องเลือกรูปใหม่
        say(`ไม่ได้บันทึกรูป: ${o.message}`, 'bad');
        lock(false);
      } else {
        say(o.kind === 'done' ? (o.message ?? 'บันทึกแล้ว') : o.kind === 'session' ? SESSION_QUEUED_MSG : QUEUED_MSG, 'ok');
        form.querySelector('.grid')?.remove();
        form.closest('li')?.classList.add('opacity-70');
        if (o.kind === 'done') bump();
      }
      pending = [];
      inputs.forEach((i) => (i.value = ''));
    };

    retry.addEventListener('click', () => {
      retry.hidden = true;
      void send();
    });

    // เลือกไฟล์แล้วส่งทันที ไม่ต้องกดปุ่มซ้ำ (ลดการแตะบนมือถือ)
    inputs.forEach((input) => input.addEventListener('change', async () => {
      const picked = [...(input.files ?? [])];
      if (picked.length === 0) return;
      retry.hidden = true;
      lock(true);
      pending = await resizeAll(picked, (n, total) => say(`กำลังย่อรูป ${n}/${total}…`, 'busy'));
      batch = newBatchId();
      await send();
    }));
  });
</script>
