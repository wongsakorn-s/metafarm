---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../server/db.ts';
import { listHivesWithoutPhoto } from '../../server/hives.ts';
import { originLabel, statusClass, statusLabel } from '../../lib/labels.ts';
import { provinceOf } from '../../lib/place.ts';
import { formatThaiDate } from '../../lib/thai-date.ts';

export const prerender = false;

const includeAll = Astro.url.searchParams.get('all') === '1';
const rows = await listHivesWithoutPhoto(getDb(), includeAll);
const msg = Astro.url.searchParams.get('msg');
---

<AdminLayout title="คิวถ่ายรูปรัง" active="readiness">
  <p class="-mt-3 mb-4"><a class="inline-flex min-h-11 items-center text-sm text-muted underline" href="/admin/readiness">← เตรียมเปิดเว็บ</a></p>
  {msg && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900">✅ {msg}</p>}

  <section class="card mb-4">
    <p class="text-lg"><strong id="left" data-total={rows.length}>{rows.length}</strong> รังที่ยังไม่มีรูปสมุดพก {!includeAll && <span class="text-sm text-muted">(เฉพาะรังที่ยังอยู่)</span>}</p>
    <p class="hint">เดินไปที่รัง กด <strong>📷 ถ่ายรูป</strong> หรือ <strong>🖼️ เลือกจากเครื่อง</strong> ระบบย่อรูปให้ก่อนส่ง (ประหยัดเน็ต) · เพิ่มรูปอื่น/ลบรูปได้ที่หน้ารังนั้นทีหลัง</p>
    <p class="mt-2 text-sm"><a class="underline" href={includeAll ? '/admin/photos' : '/admin/photos?all=1'}>{includeAll ? 'แสดงเฉพาะรังที่ยังอยู่' : 'แสดงรวมรังที่ขายแล้ว/ล่มด้วย'}</a></p>
  </section>

  {rows.length === 0 ? (
    <div class="card text-center"><p class="text-3xl" aria-hidden="true">🎉</p><p class="mt-1 text-lg font-semibold">ทุกรังมีรูปสมุดพกแล้ว</p></div>
  ) : (
    <ul class="grid gap-3 sm:grid-cols-2" id="queue">
      {rows.map((h) => (
        <li class="card space-y-3" data-code={h.code}>
          <div class="flex flex-wrap items-center gap-2">
            <a class="inline-flex min-h-11 min-w-11 items-center text-xl font-bold hover:underline" href={`/admin/hives/${h.code}`}>{h.code}</a>
            <span class:list={['badge', statusClass[h.status]]}>{statusLabel[h.status]}</span>
            {h.forSale && <span class="badge bg-honey-400 text-ink">ตั้งขาย</span>}
          </div>
          <p class="text-sm text-muted">{originLabel[h.origin]}{provinceOf(h.originPlace) ? ` · ${provinceOf(h.originPlace)}` : ''} · ได้มา {formatThaiDate(h.acquiredOn, h.acquiredOnPrecision ?? 'day')}</p>

          <form method="post" action={`/admin/hives/${h.code}/media`} enctype="multipart/form-data" data-photo-form class="space-y-2">
            <input type="hidden" name="intent" value="upload" /><input type="hidden" name="kind" value="passport" /><input type="hidden" name="back" value="/admin/photos" />
            <div class="grid grid-cols-2 gap-2">
              <label class="btn-primary cursor-pointer" for={`cam-${h.code}`}>📷 ถ่ายรูป</label>
              <label class="btn-ghost cursor-pointer" for={`pick-${h.code}`}>🖼️ เลือกจากเครื่อง</label>
            </div>
            <input class="sr-only" id={`cam-${h.code}`} name="file" type="file" accept="image/*" capture="environment" />
            <input class="sr-only" id={`pick-${h.code}`} name="file" type="file" accept="image/jpeg,image/png,image/webp,image/*" multiple />
            <noscript><button class="btn-ghost w-full" type="submit">อัปโหลด</button></noscript>
            <p class="text-sm" data-state role="status" aria-live="polite"></p>
            <button class="btn-primary w-full" type="button" data-retry hidden>🔁 ส่งรูปเดิมอีกครั้ง</button>
          </form>
        </li>
      ))}
    </ul>
  )}
</AdminLayout>

<script>
  import { appendPrepared, resizeAll, type Prepared } from '../../scripts/resize-image';
  import { describeUploadError, newBatchId, postUpload, UploadError } from '../../scripts/upload';

  const left = document.getElementById('left');
  const bump = () => { if (left) left.textContent = String(Math.max(0, Number(left.textContent) - 1)); };

  document.querySelectorAll<HTMLFormElement>('form[data-photo-form]').forEach((form) => {
    const state = form.querySelector<HTMLElement>('[data-state]')!;
    const retry = form.querySelector<HTMLButtonElement>('[data-retry]')!;
    const inputs = [...form.querySelectorAll<HTMLInputElement>('input[type=file]')];
    const labels = [...form.querySelectorAll('label')];
    const lock = (on: boolean) => labels.forEach((l) => {
      l.classList.toggle('pointer-events-none', on);
      l.classList.toggle('opacity-60', on);
    });
    const say = (msg: string, tone: 'busy' | 'ok' | 'bad') => {
      state.className = tone === 'ok' ? 'text-sm font-semibold text-palm-700' : tone === 'bad' ? 'text-sm font-medium text-danger' : 'text-sm';
      state.textContent = msg;
    };

    // รูปที่ย่อแล้วของชุดล่าสุด — เก็บไว้ส่งซ้ำได้โดยไม่ต้องเดินกลับไปถ่ายใหม่ (รูปจากกล้องบางเครื่องไม่ถูกเก็บในอัลบั้ม)
    let pending: Prepared[] = [];
    let batch = '';

    const send = async () => {
      lock(true);
      retry.hidden = true;
      try {
        const fd = new FormData();
        for (const [k, v] of new FormData(form)) if (!(v instanceof File)) fd.append(k, v);
        fd.set('batch', batch);
        appendPrepared(fd, pending);
        say(`กำลังส่ง ${pending.length} รูป…`, 'busy');
        const r = await postUpload(form.action, fd, pending.reduce((n, p) => n + p.file.size + (p.thumb?.size ?? 0), 0));
        say(`✅ ${r.message}`, 'ok');
        pending = [];
        form.querySelector('.grid')?.remove();
        form.closest('li')?.classList.add('opacity-70');
        bump();
      } catch (err) {
        say(describeUploadError(err), 'bad');
        lock(false);
        // ส่งไม่ถึง/ล็อกอินหมดอายุ → ส่งรูปเดิมซ้ำได้ · เซิร์ฟเวอร์ไม่รับไฟล์ (เต็ม/ไม่ใช่รูป) → ต้องเลือกรูปใหม่
        if (!(err instanceof UploadError && (err.kind === 'rejected' || err.kind === 'client'))) retry.hidden = false;
        else pending = [];
      }
      inputs.forEach((i) => (i.value = ''));
    };

    // เลือกไฟล์แล้วส่งทันที ไม่ต้องกดปุ่มซ้ำ (ลดการแตะบนมือถือ)
    inputs.forEach((input) => input.addEventListener('change', async () => {
      const picked = [...(input.files ?? [])];
      if (picked.length === 0) return;
      lock(true);
      pending = await resizeAll(picked, (n, total) => say(`กำลังย่อรูป ${n}/${total}…`, 'busy'));
      batch = newBatchId();
      await send();
    }));
    retry.addEventListener('click', () => void send());
  });
</script>
