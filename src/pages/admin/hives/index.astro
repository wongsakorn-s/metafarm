---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import Val from '../../../components/Val.astro';
import { getDb } from '../../../server/db.ts';
import { HIVE_SORTS, listHives, type HiveSort } from '../../../server/hives.ts';
import { baht, originLabel, statusClass, statusLabel } from '../../../lib/labels.ts';
import { formatThaiDate } from '../../../lib/thai-date.ts';
import { placeholder } from '../../../lib/placeholders.ts';
import { thumbUrl } from '../../../lib/media.ts';
import { canManageFarm } from '../../../lib/permissions.ts';

export const prerender = false;
// พนักงาน: เห็นว่ารังไหนตั้งขาย แต่ไม่เห็นราคา
const owner = canManageFarm(Astro.locals.user);

const sp = Astro.url.searchParams;
const filter = {
  q: sp.get('q') ?? '',
  status: ['active', 'sold', 'collapsed', 'unknown'].includes(sp.get('status') ?? '') ? sp.get('status')! : '',
  origin: ['purchased', 'queen_bred', 'split', 'natural'].includes(sp.get('origin') ?? '') ? sp.get('origin')! : '',
  forSale: sp.get('forSale') === '1',
  incomplete: sp.get('incomplete') === '1',
  page: Math.max(1, Number(sp.get('page')) || 1),
  sort: (HIVE_SORTS as readonly string[]).includes(sp.get('sort') ?? '') ? (sp.get('sort') as HiveSort) : 'new',
};
const { rows, total, page, pages } = await listHives(getDb(), filter);
const activeFilters = [filter.status, filter.origin, filter.forSale, filter.incomplete].filter(Boolean).length;

const link = (p: number) => {
  const u = new URLSearchParams(sp);
  u.set('page', String(p));
  return `?${u}`;
};
// หัวตาราง: กดเพื่อเรียง (กลับไปหน้า 1)
const sortLink = (sort: HiveSort) => {
  const u = new URLSearchParams(sp);
  u.set('sort', sort);
  u.delete('page');
  return `?${u}`;
};
const sortHead = (label: string, sort: HiveSort) => ({ label, sort, on: filter.sort === sort });
// ชิปตัวกรองด่วน (เห็นตลอด ไม่ต้องเปิดกล่องตัวกรอง) — คงคำค้น/การเรียง/ที่มาไว้ เปลี่ยนเฉพาะสถานะ/ตั้งขาย/ไม่ครบ
const quick = [
  { label: 'ทั้งหมด', set: {} },
  { label: 'ยังอยู่', set: { status: 'active' } },
  { label: 'ตั้งขาย', set: { forSale: '1' } },
  { label: 'ขายแล้ว', set: { status: 'sold' } },
  { label: 'ล่ม', set: { status: 'collapsed' } },
  { label: 'ข้อมูลไม่ครบ', set: { incomplete: '1' } },
] as { label: string; set: Record<string, string> }[];
const quickLink = (set: Record<string, string>) => {
  const u = new URLSearchParams(sp);
  for (const k of ['status', 'forSale', 'incomplete', 'page']) u.delete(k);
  for (const [k, v] of Object.entries(set)) u.set(k, v);
  const q = u.toString();
  return q ? `?${q}` : '/admin/hives';
};
const quickOn = (set: Record<string, string>) =>
  (set.status ?? '') === filter.status && (set.forSale === '1') === filter.forSale && (set.incomplete === '1') === filter.incomplete;
---

<AdminLayout title="รังทั้งหมด" active="hives">
  {/* มือถือ: เห็นช่องค้นหาก่อน ตัวกรองอื่นพับไว้ (เดิมฟอร์มเต็มจอแรก ต้องเลื่อนก่อนเห็นรังแรก) */}
  <form method="get" class="mb-3 space-y-2" role="search">
    <div class="flex gap-2">
      <label class="sr-only" for="q">ค้นหารหัสรัง / สถานที่ซื้อ</label>
      <input class="field flex-1" id="q" name="q" type="search" value={filter.q} placeholder="ค้นหา เช่น A25 หรือ ภูเก็ต" enterkeyhint="search" />
      <button class="btn-primary shrink-0" type="submit">ค้นหา</button>
    </div>
    <nav aria-label="ตัวกรองด่วน" class="scroll-fade -mx-1 flex gap-1.5 overflow-x-auto px-1 pb-1 pr-8">
      {quick.map((c) => (
        <a href={quickLink(c.set)} aria-current={quickOn(c.set) ? 'page' : undefined}
          class:list={['inline-flex min-h-11 shrink-0 items-center rounded-full border px-4 text-sm font-medium', quickOn(c.set) ? 'border-palm-600 bg-palm-600 text-white' : 'border-line bg-surface hover:bg-canvas']}>{c.label}</a>
      ))}
    </nav>
    <details class="group rounded-2xl border border-line bg-surface" open={!!filter.origin}>
      <summary class="disclosure min-h-11 px-4 font-medium">ตัวกรองเพิ่มเติม (ที่มา){activeFilters > 0 && <span class="badge bg-palm-100 text-palm-900">{activeFilters}</span>}</summary>
      <div class="grid gap-3 px-4 pb-4 sm:grid-cols-[1fr_1fr_auto]">
        <div>
          <label class="label" for="status">สถานะ</label>
          <select class="field" id="status" name="status">
            <option value="">ทั้งหมด</option>
            {(['active', 'sold', 'collapsed', 'unknown'] as const).map((st) => <option value={st} selected={filter.status === st}>{statusLabel[st]}</option>)}
          </select>
        </div>
        <div>
          <label class="label" for="origin">ที่มา</label>
          <select class="field" id="origin" name="origin">
            <option value="">ทั้งหมด</option>
            {(['purchased', 'queen_bred', 'split', 'natural'] as const).map((o) => <option value={o} selected={filter.origin === o}>{originLabel[o]}</option>)}
          </select>
        </div>
        <div class="flex flex-wrap items-end gap-x-4">
          <label class="flex min-h-11 items-center gap-2"><input type="checkbox" name="forSale" value="1" checked={filter.forSale} class="size-5 accent-palm-600" /> ตั้งขาย</label>
          <label class="flex min-h-11 items-center gap-2"><input type="checkbox" name="incomplete" value="1" checked={filter.incomplete} class="size-5 accent-palm-600" /> ไม่ครบ ???</label>
        </div>
        <button class="btn-primary sm:col-span-3" type="submit">ใช้ตัวกรอง</button>
      </div>
    </details>
  </form>

  <div class="mb-3 flex items-center justify-between gap-2">
    <p class="text-sm text-muted" aria-live="polite">พบ {total.toLocaleString('th-TH')} รัง {activeFilters + (filter.q ? 1 : 0) > 0 && <a class="ml-1 inline-flex min-h-11 items-center underline" href="/admin/hives">ล้าง</a>}</p>
    <a class="btn-ghost shrink-0" href="/admin/hives/new"><Icon name="plus" class="inline-block size-[1.15em] align-[-0.2em]" /> เพิ่มรัง</a>
  </div>

  {rows.length === 0 ? (
    <div class="card text-center text-muted">ไม่พบรังที่ตรงกับเงื่อนไข</div>
  ) : (
    <>
      {/* มือถือ/แท็บเล็ต: การ์ด (แตะง่าย) */}
      <ul class="grid gap-3 sm:grid-cols-2 lg:hidden">
        {rows.map((h) => (
          <li>
            <a href={`/admin/hives/${h.code}`} class="card-link flex gap-3">
              <img src={h.photoKey ? thumbUrl(`/media/${h.photoKey}`) : placeholder.hive} alt="" width="72" height="72" loading="lazy" class="size-[72px] shrink-0 rounded-xl bg-palm-50 object-cover" />
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                  <span class="text-lg font-bold">{h.code}</span>
                  <span class:list={['badge', statusClass[h.status]]}>{statusLabel[h.status]}</span>
                  {h.forSale && <span class="badge bg-honey-400 text-ink">{owner ? `ขาย ${baht(h.salePrice)}` : 'ตั้งขาย'}</span>}
                </div>
                <p class="truncate text-sm text-muted">{originLabel[h.origin]}{h.originPlace ? ` · ${h.originPlace}` : ''}</p>
                <p class="text-sm text-muted">ได้มา <Val v={formatThaiDate(h.acquiredOn, h.acquiredOnPrecision ?? 'day')} />{h.lastEventOn ? ` · ล่าสุด ${formatThaiDate(h.lastEventOn)}` : ''}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>

      {/* คอม: ตาราง — เห็นทีละมาก เรียงลำดับได้ แถวกดได้ทั้งแถว */}
      <div class="hidden overflow-hidden rounded-2xl border border-line bg-surface shadow-card lg:block">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">รายการรัง {total} รัง เรียงตาม{({ new: 'รังใหม่ก่อน', old: 'รหัสน้อยก่อน', recent: 'บันทึกล่าสุด', acquired: 'วันที่ได้มา' })[filter.sort]}</caption>
          <thead class="border-b border-line bg-canvas text-xs font-semibold text-muted">
            <tr>
              <th scope="col" class="w-14 px-3 py-2"><span class="sr-only">รูป</span></th>
              {[sortHead('รหัส', filter.sort === 'new' ? 'old' : 'new')].map((hd) => (
                <th scope="col" class="px-3 py-2" aria-sort={filter.sort === 'new' ? 'descending' : filter.sort === 'old' ? 'ascending' : undefined}>
                  <a class="inline-flex min-h-9 items-center gap-1 hover:text-palm-700" href={sortLink(hd.sort)}>รหัส {filter.sort === 'new' ? '↓' : filter.sort === 'old' ? '↑' : ''}</a>
                </th>
              ))}
              <th scope="col" class="px-3 py-2">สถานะ</th>
              <th scope="col" class="px-3 py-2">ที่มา</th>
              {[sortHead('ได้มา', 'acquired'), sortHead('บันทึกล่าสุด', 'recent')].map((hd) => (
                <th scope="col" class="px-3 py-2" aria-sort={hd.on ? 'descending' : undefined}>
                  <a class:list={['inline-flex min-h-9 items-center gap-1 hover:text-palm-700', hd.on && 'text-palm-700']} href={sortLink(hd.sort)}>{hd.label} {hd.on ? '↓' : ''}</a>
                </th>
              ))}
              <th scope="col" class="px-3 py-2 text-right">ตั้งขาย</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {rows.map((h) => (
              <tr class="group relative transition-colors duration-(--duration-fast) hover:bg-palm-50">
                <td class="px-3 py-2"><img src={h.photoKey ? thumbUrl(`/media/${h.photoKey}`) : placeholder.hive} alt="" width="40" height="40" loading="lazy" class="size-10 rounded-lg bg-palm-50 object-cover" /></td>
                <th scope="row" class="px-3 py-2 text-base font-bold">
                  {/* ลิงก์ยืดเต็มแถว: กดตรงไหนของแถวก็เปิดรังได้ */}
                  <a class="after:absolute after:inset-0 group-hover:text-palm-700" href={`/admin/hives/${h.code}`}>{h.code}</a>
                </th>
                <td class="px-3 py-2"><span class:list={['badge', statusClass[h.status]]}>{statusLabel[h.status]}</span></td>
                <td class="max-w-56 truncate px-3 py-2 text-muted">{originLabel[h.origin]}{h.originPlace ? ` · ${h.originPlace}` : ''}</td>
                <td data-num class="whitespace-nowrap px-3 py-2"><Val v={formatThaiDate(h.acquiredOn, h.acquiredOnPrecision ?? 'day')} /></td>
                <td data-num class="whitespace-nowrap px-3 py-2 text-muted">{h.lastEventOn ? formatThaiDate(h.lastEventOn) : '–'}</td>
                <td data-num class="whitespace-nowrap px-3 py-2 text-right">{h.forSale ? <span class="badge bg-honey-400 text-ink">{owner ? baht(h.salePrice) : 'ตั้งขาย'}</span> : <span class="text-muted">–</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {pages > 1 && (
    <nav class="mt-6 flex items-center justify-between" aria-label="เปลี่ยนหน้า">
      {page > 1 ? <a class="btn-ghost" href={link(page - 1)} rel="prev">← ก่อนหน้า</a> : <span />}
      <span class="text-sm text-muted">หน้า {page} / {pages}</span>
      {page < pages ? <a class="btn-ghost" href={link(page + 1)} rel="next">ถัดไป →</a> : <span />}
    </nav>
  )}
</AdminLayout>
