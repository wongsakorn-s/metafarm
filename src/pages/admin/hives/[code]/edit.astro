---
import { expandCodeFields, isHiveCode, normalizeHiveCode, splitHiveCode } from '../../../../lib/hive-code.ts';
import Icon from '../../../../components/Icon.astro';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb } from '../../../../server/db.ts';
import { getHiveDetail, updateHive } from '../../../../server/hives.ts';
import { boxLabel, originLabel } from '../../../../lib/labels.ts';
import { unknownTopics } from '../../../../lib/unknown-notes.ts';
import { editHiveSchema, parseForm, todayBangkok, type FieldErrors } from '../../../../lib/validation.ts';
import { formatThaiDate } from '../../../../lib/thai-date.ts';
import { canManageFarm } from '../../../../lib/permissions.ts';
import { differingFields, shortStamp, type FieldDiff } from '../../../../lib/concurrency.ts';
import { editedBy } from '../../../../server/versioned.ts';
import ConflictNotice from '../../../../components/ConflictNotice.astro';

export const prerender = false;

// รหัสรัง: ตัวอักษร + เลข (A25, B12, G108) — พิมพ์ตัวเล็กใน URL ก็เปิดได้
const code = normalizeHiveCode(Astro.params.code) ?? '';
if (!code) return new Response(null, { status: 404 });

const db = getDb();
let detail = await getHiveDetail(db, code);
if (!detail) return new Response('ไม่พบรังนี้', { status: 404 });
let { hive } = detail;
let conflict: { diffs: FieldDiff[]; by: string | null; at: string } | null = null;
const today = todayBangkok();

let errors: FieldErrors = {};
let values: Record<string, string> | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  // รังแม่พิมพ์แค่เลขได้ (ชุดตัวอักษรเดียวกับรังนี้)
  expandCodeFields(form, ['queenSourceCode', 'broodSourceCode'], splitHiveCode(code).prefix);
  values = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
  const p = parseForm(editHiveSchema, form);
  if (!p.ok) errors = p.errors;
  else {
    const r = await updateHive(db, Astro.locals.user!, hive, p.data);
    if (r.ok) return Astro.redirect(`/admin/hives/${code}?saved=edited`, 303);
    if (r.conflict) {
      // มีคนบันทึกไปก่อน: โหลดค่าล่าสุด เก็บค่าที่กรอกไว้ในฟอร์ม และเลื่อนเวอร์ชันเป็นล่าสุด (กดบันทึกอีกครั้ง = ยืนยันใช้ค่าของคุณ)
      detail = (await getHiveDetail(db, code))!;
      hive = detail.hive;
      conflict = { diffs: [], by: await editedBy(db, 'hive', hive.id, values.version ?? ''), at: shortStamp(hive.updatedAt) };
      values.version = hive.updatedAt;
    } else errors = { _: r.error };
  }
}

// ค่าเริ่มต้นของฟอร์ม: ค่าที่ส่งมาเมื่อมี error ไม่งั้นค่าปัจจุบันของรัง
const cur: Record<string, string> = {
  origin: hive.origin,
  originPlace: hive.originPlace ?? '',
  acquiredOn: hive.acquiredOn ?? '',
  queenBornOn: hive.queenBornOn ?? '',
  boxType: hive.boxType,
  queenSourceCode: detail.queenSource ?? '',
  broodSourceCode: detail.broodSource ?? '',
  purchasePrice: hive.purchasePrice != null && canManageFarm(Astro.locals.user) ? String(hive.purchasePrice) : '',
  collapseReason: hive.collapseReason ?? '',
  publicNote: hive.publicNote ?? '',
  notes: hive.notes ?? '',
};
const v = (k: string) => (values ? (values[k] ?? '') : cur[k]!);
// เทียบเป็นข้อความที่คนอ่านเข้าใจ (ที่มา/กล่องรังเป็นป้ายชื่อ ไม่ใช่รหัส)
if (conflict && values) {
  conflict.diffs = differingFields(values, cur, {
    origin: 'ที่มา', originPlace: 'สถานที่ซื้อ', acquiredOn: 'วันที่ได้มา', queenBornOn: 'วันเกิดนางพญา', boxType: 'กล่องรัง',
    queenSourceCode: 'รังแม่ (ไข่นาง)', broodSourceCode: 'รังแม่ (ไข่อ่อน)', ...(canManageFarm(Astro.locals.user) ? { purchasePrice: 'ราคาซื้อ' } : {}),
    collapseReason: 'สาเหตุที่ล่ม', publicNote: 'หมายเหตุสาธารณะ', notes: 'หมายเหตุภายใน',
  });
}
const err = (k: string) => errors[k];

// ช่องที่ยังเป็น ??? ให้ไฮไลต์
const topics = unknownTopics(hive.notes);
const needs = new Set<string>();
for (const t of topics) {
  if (t === 'วันเกิดนางพญา') needs.add('queenBornOn');
  if (t === 'วันที่ซื้อ') needs.add('acquiredOn');
  if (t.includes('ไข่นาง')) needs.add('queenSourceCode');
  if (t.includes('ไข่อ่อน')) needs.add('broodSourceCode');
}
const hl = (k: string) => (needs.has(k) ? 'ring-2 ring-honey-400' : '');
const monthOnly = hive.acquiredOnPrecision && hive.acquiredOnPrecision !== 'day';
---

<AdminLayout back={{ href: `/admin/hives/${hive.code}`, label: `รัง ${hive.code}` }} title={`แก้ไขรัง ${hive.code}`} active="hives">

  {errors._ && <p role="alert" class="mb-4 rounded-xl bg-red-50 p-3 font-medium text-danger">{errors._}</p>}
  {conflict && <ConflictNotice form="hive-edit" diffs={conflict.diffs} by={conflict.by} at={conflict.at} format={(k, x) => (k === 'origin' ? (originLabel[x as keyof typeof originLabel] ?? x) : k === 'boxType' ? (boxLabel[x as keyof typeof boxLabel] ?? x) : x)} />}

  {topics.length > 0 && (
    <section class="mb-4 rounded-2xl border border-honey-400 bg-honey-50 p-4" aria-label="ข้อมูลที่ยังไม่ครบ">
      <h2 class="font-semibold text-honey-700">ข้อมูลที่ยังไม่ทราบ (???)</h2>
      <ul class="mt-1 list-inside list-disc text-sm">{topics.map((t) => <li>{t}{t === 'สถานะรัง' && <> — ตั้งที่ <a class="underline" href={`/admin/hives/${hive.code}`}>หน้ารัง › เปลี่ยนสถานะ</a></>}</li>)}</ul>
      <p class="hint">กรอกช่องที่ไฮไลต์สีเหลืองด้านล่าง เมื่อบันทึกแล้วรายการ ??? จะหายไปเอง</p>
    </section>
  )}

  <form method="post" id="hive-edit" class="card grid gap-4 lg:grid-cols-2 lg:gap-x-8 lg:gap-y-5">
    <input type="hidden" name="version" value={values?.version ?? hive.updatedAt} />
    <div class="grid grid-cols-2 gap-3 self-start">
      <div>
        <label class="label" for="origin">ที่มา</label>
        <select class="field" id="origin" name="origin" required>
          {(['purchased', 'queen_bred', 'split', 'natural', 'unknown'] as const).map((o) => <option value={o} selected={v('origin') === o}>{originLabel[o]}</option>)}
        </select>
        {err('origin') && <p class="error">{err('origin')}</p>}
      </div>
      <div>
        <label class="label" for="box">กล่องรัง</label>
        <select class="field" id="box" name="boxType" required>
          {(['teak_2room', 'log', 'other', 'unknown'] as const).map((b) => <option value={b} selected={v('boxType') === b}>{boxLabel[b]}</option>)}
        </select>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 self-start">
      <div>
        <label class="label" for="acq">วันที่ได้มา / ขยาย</label>
        <input class:list={['field', hl('acquiredOn')]} id="acq" name="acquiredOn" type="date" max={today} value={v('acquiredOn')} />
        {err('acquiredOn') && <p class="error">{err('acquiredOn')}</p>}
        {monthOnly && <p class="hint">เดิมรู้แค่ {formatThaiDate(hive.acquiredOn, hive.acquiredOnPrecision!)}</p>}
      </div>
      <div>
        <label class="label" for="qb">วันเกิดนางพญา {needs.has('queenBornOn') && <span class="text-honey-700">???</span>}</label>
        <input class:list={['field', hl('queenBornOn')]} id="qb" name="queenBornOn" type="date" max={today} value={v('queenBornOn')} />
        {err('queenBornOn') && <p class="error">{err('queenBornOn')}</p>}
      </div>
    </div>

    <fieldset class="rounded-xl border border-line p-3">
      <legend class="px-1 text-sm font-medium">รังแม่</legend>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="label" for="qs">ไข่นางจากรัง {needs.has('queenSourceCode') && <span class="text-honey-700">???</span>}</label>
          <input class:list={['field', hl('queenSourceCode')]} id="qs" name="queenSourceCode" placeholder="เช่น 55" value={v('queenSourceCode')} />
          {err('queenSourceCode') && <p class="error">{err('queenSourceCode')}</p>}
        </div>
        <div>
          <label class="label" for="bs">ไข่อ่อนจากรัง {needs.has('broodSourceCode') && <span class="text-honey-700">???</span>}</label>
          <input class:list={['field', hl('broodSourceCode')]} id="bs" name="broodSourceCode" placeholder="เช่น 89" value={v('broodSourceCode')} />
          {err('broodSourceCode') && <p class="error">{err('broodSourceCode')}</p>}
        </div>
      </div>
      <p class="hint">แก้ตรงนี้ไม่บันทึกการแยกในรังแม่ให้</p>
    </fieldset>

    <div class:list={['grid gap-3 self-start', canManageFarm(Astro.locals.user) && 'grid-cols-2']}>
      <div><label class="label" for="place">สถานที่ซื้อ</label><input class="field" id="place" name="originPlace" maxlength="100" value={v('originPlace')} /></div>
      {/* ราคาซื้อ = เจ้าของเท่านั้น (เซิร์ฟเวอร์ไม่รับค่านี้จากพนักงานอยู่แล้ว) */}
      {canManageFarm(Astro.locals.user) && <div><label class="label" for="price">ราคาซื้อ (บาท) <Icon name="lock" class="inline-block size-[1.15em] align-[-0.2em]" /></label><input class="field" id="price" name="purchasePrice" type="number" inputmode="numeric" min="0" value={v('purchasePrice')} />{err('purchasePrice') && <p class="error">{err('purchasePrice')}</p>}</div>}
    </div>

    {hive.status === 'collapsed' && (
      <div><label class="label" for="cr">สาเหตุที่ล่ม <Icon name="lock" class="inline-block size-[1.15em] align-[-0.2em]" /></label><input class="field" id="cr" name="collapseReason" maxlength="300" value={v('collapseReason')} /></div>
    )}

    <div>
      <label class="label" for="pub">ข้อความเพิ่มเติมของรัง (แสดงสาธารณะ)</label>
      <textarea class="field" id="pub" name="publicNote" rows="3" maxlength="500">{v('publicNote')}</textarea>
      {err('publicNote') && <p class="error">{err('publicNote')}</p>}
      <p class="hint">ลูกค้าเห็นข้อความนี้ใต้ราคาในหน้ารังที่ขาย และในสมุดพกของรัง (เช่น ชนิดรัง ขนาด เงื่อนไขการรับ-ส่ง)</p>
    </div>

    <div class="lg:col-span-2">
      <label class="label" for="notes">หมายเหตุภายใน <Icon name="lock" class="inline-block size-[1.15em] align-[-0.2em]" /></label>
      <textarea class="field" id="notes" name="notes" data-internal-notes rows="5" maxlength="2000">{v('notes')}</textarea>
      {err('notes') && <p class="error">{err('notes')}</p>}
      <p class="hint">บรรทัด ??? = ข้อมูลที่ยังไม่รู้ เติมแล้วหายเอง</p>
    </div>

    {/* มือถือ: ปุ่มบันทึกติดเหนือแถบเมนูล่างตลอด (ฟอร์มยาว ไม่ต้องเลื่อนลงไปหา) */}
    <div data-sticky-save class="sticky bottom-[calc(4.75rem+env(safe-area-inset-bottom))] z-10 -mx-4 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:static md:mx-0 md:border-0 md:bg-transparent md:p-0 md:backdrop-blur-none grid grid-cols-2 gap-3 lg:col-span-2 lg:flex lg:justify-end">
      <a class="btn-ghost lg:min-w-40" href={`/admin/hives/${hive.code}`}>ยกเลิก</a>
      <button class="btn-primary lg:min-w-64" type="submit">บันทึกการแก้ไข</button>
    </div>
  </form>
</AdminLayout>
