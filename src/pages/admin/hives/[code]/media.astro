---
import { normalizeHiveCode } from '../../../../lib/hive-code.ts';
import Icon from '../../../../components/Icon.astro';
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb, getMedia } from '../../../../server/db.ts';
import { getHiveDetail } from '../../../../server/hives.ts';
import { deleteMedia, listMedia, moveHiveMedia, reorderHiveMedia, setVideo, uploadImages } from '../../../../server/media.ts';
import VideoUploader from '../../../../components/VideoUploader.astro';
import { jsonResult, wantsJson } from '../../../../lib/http.ts';
import { LIMITS, thumbUrl, MAX_FILES_PER_REQUEST, remainingSlots, uploadSummary, youtubeWatchUrl } from '../../../../lib/media.ts';

export const prerender = false;

// รหัสรัง: ตัวอักษร + เลข (A25, B12, G108) — พิมพ์ตัวเล็กใน URL ก็เปิดได้
const code = normalizeHiveCode(Astro.params.code) ?? '';
if (!code) return new Response(null, { status: 404 });

const db = getDb();
const user = Astro.locals.user!;
const detail = await getHiveDetail(db, code);
if (!detail) return new Response('ไม่พบรังนี้', { status: 404 });
const hive = detail.hive;

let error = '';
let notice = Astro.url.searchParams.get('msg') ?? '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  // กลับไปหน้าที่ส่งมา (เช่น คิวถ่ายรูป) ได้เฉพาะหน้าในหลังบ้าน — กัน open redirect
  const rawBack = String(form.get('back') ?? '');
  const backTo = /^\/admin\/[A-Za-z0-9/_-]*$/.test(rawBack) && !rawBack.includes('//') ? rawBack : `/admin/hives/${code}/media`;
  const back = (msg: string) => Astro.redirect(`${backTo}?msg=${encodeURIComponent(msg)}`, 303);

  if (intent === 'upload') {
    // รูปสมุดพกกับรูปสำหรับขายอัปโหลดแยกกัน (ฟอร์มที่ไม่ระบุชนิด = รูปสมุดพก)
    const kind = form.get('kind') === 'sale' ? 'sale' : 'passport';
    const files = form.getAll('file').filter((f): f is File => f instanceof File && f.size > 0);
    if (files.length === 0) error = 'ยังไม่ได้เลือกไฟล์';
    else {
      const thumbs = form.getAll('thumb').map((f) => (f instanceof File ? f : new File([], '')));
      const r = await uploadImages(db, getMedia(), user, hive, kind, files, String(form.get('batch') ?? ''), thumbs);
      const message = uploadSummary(r.added, r.skipped);
      // สคริปต์อัปโหลดต้องรู้ผลจริง (เดิมได้แค่ redirect → นับว่าสำเร็จแม้ข้ามทุกไฟล์)
      if (wantsJson(Astro.request)) return jsonResult({ ok: r.added > 0, message, added: r.added, skipped: r.skipped, redirect: `${backTo}?msg=${encodeURIComponent(message)}` });
      return back(message);
    }
    if (wantsJson(Astro.request)) return jsonResult({ ok: false, message: error });
  } else if (intent === 'reorder') {
    const ids = String(form.get('order') ?? '').split(',').map(Number).filter((n) => Number.isInteger(n) && n > 0);
    const kind = form.get('category') === 'sale' ? 'sale' : 'passport';
    const r = ids.length ? await reorderHiveMedia(db, user, hive, kind, ids) : { ok: false, error: 'ข้อมูลลำดับไม่ถูกต้อง' };
    if (wantsJson(Astro.request)) return jsonResult({ ok: r.ok, message: r.ok ? 'บันทึกลำดับแล้ว' : (r.error ?? 'บันทึกไม่สำเร็จ') });
    if (r.ok) return back('บันทึกลำดับแล้ว');
    error = r.error ?? 'บันทึกไม่สำเร็จ';
  } else if (intent === 'move') {
    const dir = String(form.get('dir') ?? '');
    if (dir !== 'up' && dir !== 'down' && dir !== 'top') error = 'คำสั่งไม่ถูกต้อง';
    else {
      const r = await moveHiveMedia(db, user, hive, Number(form.get('mediaId')), dir);
      if (r.ok) return back('ย้ายรูปแล้ว');
      error = r.error ?? 'ย้ายไม่สำเร็จ';
    }
  } else if (intent === 'delete') {
    const r = await deleteMedia(db, getMedia(), user, hive, Number(form.get('mediaId')));
    if (r.ok) return back('ลบแล้ว');
    error = r.error ?? 'ลบไม่สำเร็จ';
  } else if (intent === 'video') {
    const r = await setVideo(db, getMedia(), user, hive, String(form.get('video') ?? ''));
    if (r.ok) return back(String(form.get('video') ?? '').trim() ? 'บันทึกวิดีโอแล้ว' : 'ลบวิดีโอแล้ว');
    error = r.error ?? 'บันทึกไม่สำเร็จ';
  } else error = 'คำสั่งไม่ถูกต้อง';
}

const media = await listMedia(db, hive.id);
const by = (k: string) => media.filter((m) => m.kind === k);
const passport = by('passport');
const sale = by('sale');
const video = by('video')[0];
// รังที่ตั้งขายอยู่: แสดงรูปสำหรับขายก่อน · รังอื่น: รูปสมุดพกก่อน
const sets = ([
  {
    kind: 'passport',
    title: 'รูปสมุดพก',
    items: passport,
    tag: '★ รูปหลัก (เห็นที่ตั้งรัง)',
    guide: 'รูปที่ 1 เป็นรูปหลัก: ควรถ่ายมุมกว้าง (overall) ให้เห็นตัวรังพร้อมสภาพแวดล้อมที่ตั้ง เพื่อให้เดินหาตำแหน่งรังในสวนได้ง่าย · รูปที่ 2–6 เป็นรูปมุมใกล้ ตัวรัง หรือการดูแล',
    hint: 'รูปที่ลูกค้าและคนดูแลเห็นในสมุดพกของรัง (หน้าประวัติรัง)',
  },
  {
    kind: 'sale',
    title: 'รูปสำหรับขาย',
    items: sale,
    tag: '★ รูปปก (เปิดฝาโชว์รัง)',
    guide: 'รูปที่ 1 สำคัญที่สุด: ควรถ่ายเปิดฝาโชว์ข้างในรังผ่านแผ่นพลาสติกใส ให้เห็นประชากรชันโรง ไข่อ่อน-ไข่แก่ และถ้วยน้ำหวาน เพื่อสร้างความมั่นใจให้ผู้ซื้อ · รูปที่ 2–6 เป็นรูปมุมข้างหรือตัวรังภายนอก',
    hint: 'รูปที่ลูกค้าเห็นในหน้ารังที่ขาย (เห็นเฉพาะตอนตั้งขาย) · ถ้ายังไม่มีรูปสำหรับขาย หน้าขายจะใช้ 3 รูปแรกของสมุดพกให้ก่อน',
  },
] as const).toSorted((a) => (hive.forSale ? (a.kind === 'sale' ? -1 : 1) : (a.kind === 'passport' ? -1 : 1)));
---

<AdminLayout back={{ href: `/admin/hives/${hive.code}`, label: `รัง ${hive.code}` }} title={`รูปและวิดีโอ ${hive.code}`} active="hives">

  {notice && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900"><Icon name="check" class="inline-block size-[1.15em] align-[-0.2em]" /> {notice}</p>}
  {error && <p role="alert" class="mb-4 rounded-xl bg-red-50 p-3 font-medium text-danger">{error}</p>}

  {/* รูปสมุดพกกับรูปสำหรับขาย: อัปโหลดและเรียงลำดับแยกกัน (เจ้าของขอ 2026-10-14) */}
  <p id="sort-status" role="status" class="mb-4 hidden rounded-xl p-3 font-medium"></p>
  <p id="sort-live" class="sr-only" aria-live="polite"></p>

  {sets.map((st) => {
    const free = remainingSlots(st.kind, st.items.length);
    return (
      <section class="card mb-5 space-y-3" aria-labelledby={`h-${st.kind}`} id={`set-${st.kind}`}>
        <h2 id={`h-${st.kind}`} class="text-lg font-semibold"><Icon name={st.kind === 'sale' ? 'tag' : 'camera'} class="inline-block size-[1.15em] align-[-0.2em]" /> {st.title} <span class="text-sm font-normal text-muted">({st.items.length}/{LIMITS[st.kind]})</span></h2>
        <p class="hint">{st.hint}</p>

        <div class="rounded-xl border border-palm-100 bg-palm-50/70 p-3 text-sm text-palm-900">
          <p class="font-semibold text-palm-800"><Icon name="info" class="inline-block size-[1.15em] align-[-0.2em]" /> แนะนำการเลือกรูป:</p>
          <p class="mt-1 leading-relaxed text-muted">{st.guide}</p>
        </div>

        {st.items.length === 0 ? <p class="text-muted">ยังไม่มีรูป</p> : (
          <>
            {st.items.length > 1 && <p class="hint">อยากเปลี่ยนลำดับ ให้เอานิ้วกดค้างที่ปุ่มจุด ๆ มุมขวาบนของรูป แล้วลากไปวางตำแหน่งที่ต้องการ</p>}
            <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3" data-zoom-group data-sortable data-category={st.kind}>
              {st.items.map((m, i) => (
                <li class="space-y-2" data-photo-id={m.id}>
                  <div class="relative overflow-hidden rounded-xl">
                    <a href={`/media/${m.r2Key}`} data-zoom data-caption={`รัง ${hive.code}`} aria-label={`ดูรูปรัง ${hive.code} (${st.title}) รูปที่ ${i + 1} ขยาย`} class="relative block" target="_blank" rel="noopener">
                      <span aria-hidden="true" data-num data-pos class="absolute left-2 top-2 grid min-w-7 place-items-center rounded-full bg-black/60 px-2 py-0.5 text-sm font-semibold text-white">{i + 1}</span>
                      <span data-first-label class:list={['pointer-events-none absolute inset-x-2 bottom-2 rounded-lg bg-black/75 px-2 py-1 text-center text-xs font-semibold text-white shadow-sm backdrop-blur', i !== 0 && 'hidden']}>
                        {st.tag}
                      </span>
                      <img src={thumbUrl(`/media/${m.r2Key}`)} alt={m.alt ?? ''} loading="lazy" class="aspect-[3/4] w-full rounded-xl bg-palm-50 object-cover" />
                    </a>
                    <button type="button" data-drag-handle aria-pressed="false" aria-label={`จัดลำดับรูปที่ ${i + 1} จาก ${st.items.length} — กด Space เพื่อหยิบ แล้วใช้ลูกศรเลื่อน`}
                      class="absolute right-2 top-2 grid size-11 cursor-grab touch-none select-none place-items-center rounded-full bg-black/60 text-white backdrop-blur hover:bg-black/75 active:cursor-grabbing focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><Icon name="grip" class="size-5" /></button>
                  </div>
                  <noscript><div class="flex items-center gap-1" role="group" aria-label={`ลำดับรูปที่ ${i + 1} จาก ${st.items.length}`}>
                    {(['up', 'down', 'top'] as const).map((d) => {
                      const off = d === 'up' || d === 'top' ? i === 0 : i === st.items.length - 1;
                      const label = { up: 'เลื่อนขึ้น', down: 'เลื่อนลง', top: 'ไปบนสุด' }[d];
                      return (
                        <form method="post" class="flex-1">
                          <input type="hidden" name="intent" value="move" /><input type="hidden" name="mediaId" value={m.id} /><input type="hidden" name="dir" value={d} />
                          <button class="btn-ghost !px-0 w-full min-w-11" type="submit" disabled={off} aria-label={`${label} (รูปที่ ${i + 1})`} title={label}><Icon name={d} class="size-5" /></button>
                        </form>
                      );
                    })}
                  </div></noscript>
                  <form method="post" data-confirm="ลบรูปนี้ถาวรหรือไม่?">
                    <input type="hidden" name="intent" value="delete" /><input type="hidden" name="mediaId" value={m.id} />
                    <button class="btn-danger w-full" type="submit"><Icon name="trash" class="inline-block size-[1.15em] align-[-0.2em]" /> ลบ</button>
                  </form>
                </li>
              ))}
            </ul>
          </>
        )}

        <form method="post" enctype="multipart/form-data" data-photo-upload data-code={hive.code} data-set={st.title} class="space-y-3 border-t border-line pt-3">
          <input type="hidden" name="intent" value="upload" /><input type="hidden" name="kind" value={st.kind} />
          <div>
            <label class="label flex min-h-11 items-end" for={`file-${st.kind}`}>เพิ่ม{st.title} (ถ่ายใหม่หรือเลือกจากเครื่อง)</label>
            <input class="field-file" id={`file-${st.kind}`} name="file" type="file" accept="image/jpeg,image/png,image/webp,image/*" multiple disabled={free === 0} />
            <p class="hint">{free === 0 ? `ครบ ${LIMITS[st.kind]} รูปแล้ว — ถ้าจะเพิ่ม ให้ลบรูปเก่าก่อน` : `เพิ่มได้อีก ${free} รูป (ครั้งละไม่เกิน ${MAX_FILES_PER_REQUEST} รูป) · ระบบย่อรูปให้เล็กลงและลบตำแหน่งที่ถ่ายออกให้เอง`}</p>
          </div>
          <p data-upload-status class="hidden rounded-xl bg-honey-50 p-3 text-sm font-medium text-honey-700" role="status" aria-live="polite"></p>
          <button class="btn-primary w-full" type="submit" disabled={free === 0}>อัปโหลด{st.title}</button>
        </form>
      </section>
    );
  })}

  {/* วิดีโอ */}
  <section class="card mb-5" aria-labelledby="h-video">
    <h2 id="h-video" class="mb-1 text-lg font-semibold"><Icon name="video" class="inline-block size-[1.15em] align-[-0.2em]" /> วิดีโอ <span class="text-sm font-normal text-muted">({video ? 1 : 0}/{LIMITS.video})</span></h2>
    <p class="hint mb-3">วิดีโอจะขึ้นในสมุดพกและหน้ารังที่ขาย · ใส่ได้ 1 คลิป ถ้าอัปโหลดอันใหม่จะแทนอันเดิม</p>
    {video?.r2Key && (
      <video class="mb-3 block w-full max-h-[60svh] rounded-2xl bg-black" controls playsinline preload="metadata" src={`/video/${video.r2Key}`} aria-label={`วิดีโอรัง ${hive.code}`}></video>
    )}
    {video?.youtubeId && <p class="mb-3">▶ <a class="text-palm-700 underline" href={youtubeWatchUrl(video.youtubeId)} target="_blank" rel="noopener noreferrer">{youtubeWatchUrl(video.youtubeId)}</a></p>}
    <VideoUploader id="video-file" action={`/admin/hives/${hive.code}/video`} />
    <details class="mt-4" open={!!video?.youtubeId}>
      <summary class="min-h-11 cursor-pointer py-2 font-medium">หรือวางลิงก์ YouTube แทน</summary>
      <form method="post" class="mt-2 space-y-3">
        <input type="hidden" name="intent" value="video" />
        <p class="hint">ถ้าอัปโหลดวิดีโอขึ้น YouTube ไว้แล้ว (ตั้งเป็น "ไม่แสดงในรายการ" ก็ได้) ให้คัดลอกลิงก์มาวางที่นี่</p>
        <div><label class="label" for="video">ลิงก์ YouTube</label><input class="field" id="video" name="video" inputmode="url" placeholder="https://youtu.be/…" value={video?.youtubeId ? youtubeWatchUrl(video.youtubeId) : ''} /></div>
        <button class="btn-primary w-full" type="submit">บันทึกลิงก์ YouTube</button>
      </form>
    </details>
    {video && (
      <form method="post" class="mt-3" data-confirm="ลบวิดีโอนี้หรือไม่?">
        <input type="hidden" name="intent" value="video" /><input type="hidden" name="video" value="" />
        <button class="btn-ghost w-full" type="submit">ลบวิดีโอ</button>
      </form>
    )}
  </section>
</AdminLayout>

<script>
  import '../../../../scripts/gallery-sort';
  import { appendPrepared, resizeAll } from '../../../../scripts/resize-image';
  import { describeUploadError, newBatchId } from '../../../../scripts/upload';
  import { fieldsOf, QUEUED_MSG, SESSION_QUEUED_MSG, sendOrQueue, UNSAVED_MSG } from '../../../../scripts/outbox';

  // ย่อรูปก่อนอัปโหลด แล้วส่งด้วย fetch (ถ้า JS ใช้ไม่ได้ ฟอร์มจะส่งไฟล์เดิมตามปกติ) — มี 2 ฟอร์ม: รูปสมุดพก / รูปสำหรับขาย
  // ยืนยันก่อนลบ/กันกดซ้ำ อยู่ในสคริปต์กลางของหลังบ้าน (scripts/admin-forms.ts)
  document.querySelectorAll<HTMLFormElement>('form[data-photo-upload]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-upload-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const input = form.querySelector<HTMLInputElement>('input[type=file]')!;
    const say = (msg: string, bad = false) => {
      status.textContent = msg;
      status.classList.remove('hidden');
      status.classList.toggle('bg-red-50', bad);
      status.classList.toggle('text-danger', bad);
      status.classList.toggle('bg-honey-50', !bad);
      status.classList.toggle('text-honey-700', !bad);
    };
    // รหัสชุดผูกกับ "ไฟล์ที่เลือก" — กดส่งซ้ำหลังเน็ตหลุด เซิร์ฟเวอร์จะไม่บันทึกรูปซ้ำ
    let batch = newBatchId();
    input.addEventListener('change', () => (batch = newBatchId()));

    form.addEventListener('submit', async (e) => {
      const picked = [...(input.files ?? [])];
      if (picked.length === 0) return; // ให้ server แจ้งว่ายังไม่ได้เลือกไฟล์
      e.preventDefault();
      btn && (btn.disabled = true);
      try {
        const small = await resizeAll(picked, (n, total) => say(`กำลังย่อรูป ${n}/${total}…`));
        const fd = new FormData(form);
        fd.delete('file');
        fd.set('batch', batch);
        appendPrepared(fd, small);
        const before = picked.reduce((n, f) => n + f.size, 0), after = small.reduce((n, p) => n + p.file.size + (p.thumb?.size ?? 0), 0);
        say(`กำลังอัปโหลด… (${(before / 1048576).toFixed(1)} MB → ${(after / 1048576).toFixed(1)} MB)`);
        // คิวรอส่ง: เก็บรูปในเครื่องก่อน · สัญญาณไม่ดี = ส่งเองทีหลัง (รหัสชุดเดิม เซิร์ฟเวอร์ไม่บันทึกซ้ำ)
        const o = await sendOrQueue({ kind: 'photo', url: form.action || location.href, fields: await fieldsOf(fd), label: `${form.dataset.code} · ${form.dataset.set} ${small.length} รูป`, bytes: after });
        if (o.kind === 'done') { location.href = o.redirect ?? location.href; return; }
        if (o.kind === 'invalid') say(`ไม่ได้บันทึกรูป: ${o.message}`, true);
        else if (o.kind === 'unsaved') say(UNSAVED_MSG, true);
        else { say(o.kind === 'session' ? SESSION_QUEUED_MSG : QUEUED_MSG); form.reset(); batch = newBatchId(); }
        btn && (btn.disabled = false);
      } catch (err) {
        say(describeUploadError(err), true);
        btn && (btn.disabled = false);
      }
    });
  });
</script>
