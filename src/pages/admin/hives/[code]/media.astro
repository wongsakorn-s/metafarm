---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { getDb, getMedia } from '../../../../server/db.ts';
import { getHiveDetail } from '../../../../server/hives.ts';
import { deleteMedia, listMedia, setVideo, uploadImages } from '../../../../server/media.ts';
import { jsonResult, wantsJson } from '../../../../lib/http.ts';
import { kindLabel, LIMITS, MAX_FILES_PER_REQUEST, remainingSlots, uploadSummary, youtubeWatchUrl } from '../../../../lib/media.ts';

export const prerender = false;

const code = (Astro.params.code ?? '').toUpperCase();
if (!/^A\d{1,5}$/.test(code)) return new Response(null, { status: 404 });

const db = getDb();
const user = Astro.locals.user!;
const detail = await getHiveDetail(db, code);
if (!detail) return new Response('ไม่พบรังนี้', { status: 404 });
const hive = detail.hive;

let error = '';
let notice = Astro.url.searchParams.get('msg') ?? '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  // กลับไปหน้าที่ส่งมา (เช่น คิวถ่ายรูป) ได้เฉพาะหน้าในหลังบ้าน — กัน open redirect
  const rawBack = String(form.get('back') ?? '');
  const backTo = /^\/admin\/[A-Za-z0-9/_-]*$/.test(rawBack) && !rawBack.includes('//') ? rawBack : `/admin/hives/${code}/media`;
  const back = (msg: string) => Astro.redirect(`${backTo}?msg=${encodeURIComponent(msg)}`, 303);

  if (intent === 'upload') {
    const kind = form.get('kind');
    const files = form.getAll('file').filter((f): f is File => f instanceof File && f.size > 0);
    if (kind !== 'passport' && kind !== 'sale') error = 'เลือกชนิดรูป';
    else if (files.length === 0) error = 'ยังไม่ได้เลือกไฟล์';
    else {
      const r = await uploadImages(db, getMedia(), user, hive, kind, files, String(form.get('batch') ?? ''));
      const message = uploadSummary(r.added, r.skipped);
      // สคริปต์อัปโหลดต้องรู้ผลจริง (เดิมได้แค่ redirect → นับว่าสำเร็จแม้ข้ามทุกไฟล์)
      if (wantsJson(Astro.request)) return jsonResult({ ok: r.added > 0, message, added: r.added, skipped: r.skipped, redirect: `${backTo}?msg=${encodeURIComponent(message)}` });
      return back(message);
    }
    if (wantsJson(Astro.request)) return jsonResult({ ok: false, message: error });
  } else if (intent === 'delete') {
    const r = await deleteMedia(db, getMedia(), user, hive, Number(form.get('mediaId')));
    if (r.ok) return back('ลบแล้ว');
    error = r.error ?? 'ลบไม่สำเร็จ';
  } else if (intent === 'video') {
    const r = await setVideo(db, user, hive, String(form.get('video') ?? ''));
    if (r.ok) return back(String(form.get('video') ?? '').trim() ? 'บันทึกวิดีโอแล้ว' : 'ลบวิดีโอแล้ว');
    error = r.error ?? 'บันทึกไม่สำเร็จ';
  } else error = 'คำสั่งไม่ถูกต้อง';
}

const media = await listMedia(db, hive.id);
const by = (k: string) => media.filter((m) => m.kind === k);
const passport = by('passport');
const sale = by('sale');
const video = by('video')[0];
const free = { passport: remainingSlots('passport', passport.length), sale: remainingSlots('sale', sale.length) };
---

<AdminLayout title={`รูปและวิดีโอ ${hive.code}`} active="hives">
  <p class="-mt-3 mb-4"><a class="inline-flex min-h-11 items-center text-sm text-muted underline" href={`/admin/hives/${hive.code}`}>← กลับหน้ารัง {hive.code}</a></p>

  {notice && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900">✅ {notice}</p>}
  {error && <p role="alert" class="mb-4 rounded-xl bg-red-50 p-3 font-medium text-danger">{error}</p>}

  <!-- อัปโหลด -->
  <form method="post" enctype="multipart/form-data" id="upload-form" class="card mb-5 space-y-3" data-code={hive.code} data-max={MAX_FILES_PER_REQUEST}>
    <input type="hidden" name="intent" value="upload" />
    <h2 class="text-lg font-semibold">📷 เพิ่มรูป</h2>
    <fieldset>
      <legend class="label">ชนิดรูป</legend>
      <div class="grid gap-2 sm:grid-cols-2">
        <label class:list={['flex min-h-11 items-center gap-2 rounded-xl border border-line px-3', free.sale === 0 && 'opacity-50']}>
          <input class="size-5 accent-palm-600" type="radio" name="kind" value="sale" checked={free.sale > 0} disabled={free.sale === 0} /> รูปสำหรับขาย <span class="text-sm text-muted">(เหลือ {free.sale}/{LIMITS.sale})</span>
        </label>
        <label class:list={['flex min-h-11 items-center gap-2 rounded-xl border border-line px-3', free.passport === 0 && 'opacity-50']}>
          <input class="size-5 accent-palm-600" type="radio" name="kind" value="passport" checked={free.sale === 0 && free.passport > 0} disabled={free.passport === 0} /> รูปสมุดพก <span class="text-sm text-muted">(เหลือ {free.passport}/{LIMITS.passport})</span>
        </label>
      </div>
    </fieldset>
    <div>
      <label class="label flex min-h-11 items-end" for="file">เลือกรูป (ถ่ายใหม่หรือเลือกจากเครื่อง)</label>
      <input class="field" id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/*" multiple />
      <p class="hint">ครั้งละไม่เกิน {MAX_FILES_PER_REQUEST} รูป · ระบบย่อรูปให้อัตโนมัติก่อนส่ง (ประหยัดเน็ต)</p>
    </div>
    <p id="upload-status" class="hidden rounded-xl bg-honey-50 p-3 text-sm font-medium text-honey-700" role="status" aria-live="polite"></p>
    <button id="upload-btn" class="btn-primary w-full" type="submit" disabled={free.sale === 0 && free.passport === 0}>อัปโหลด</button>
  </form>

  {([['sale', sale], ['passport', passport]] as const).map(([k, items]) => (
    <section class="card mb-5" aria-labelledby={`h-${k}`}>
      <h2 id={`h-${k}`} class="mb-1 text-lg font-semibold">{kindLabel[k]} <span class="text-sm font-normal text-muted">({items.length}/{LIMITS[k]})</span></h2>
      <p class="hint mb-3">{k === 'sale' ? 'แสดงเฉพาะในหน้าสินค้า/รังสมบูรณ์ เมื่อตั้งขายรังนี้' : 'แสดงในสมุดพกชันโรง (สาธารณะ)'}</p>
      {items.length === 0 ? <p class="text-muted">ยังไม่มีรูป</p> : (
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
          {items.map((m) => (
            <li class="space-y-2">
              <img src={`/media/${m.r2Key}`} alt={m.alt ?? ''} loading="lazy" class="aspect-[3/4] w-full rounded-xl bg-palm-50 object-cover" />
              <form method="post" data-confirm="ลบรูปนี้ถาวรหรือไม่?">
                <input type="hidden" name="intent" value="delete" /><input type="hidden" name="mediaId" value={m.id} />
                <button class="btn-danger w-full" type="submit">🗑️ ลบ</button>
              </form>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}

  <!-- วิดีโอ -->
  <section class="card mb-5" aria-labelledby="h-video">
    <h2 id="h-video" class="mb-1 text-lg font-semibold">🎬 วิดีโอ <span class="text-sm font-normal text-muted">({video ? 1 : 0}/{LIMITS.video})</span></h2>
    <p class="hint mb-3">อัปโหลดวิดีโอขึ้น YouTube (ตั้งเป็น "ไม่แสดงในรายการ" ก็ได้) แล้ววางลิงก์ที่นี่</p>
    {video?.youtubeId && <p class="mb-3">▶ <a class="text-palm-700 underline" href={youtubeWatchUrl(video.youtubeId)} target="_blank" rel="noopener noreferrer">{youtubeWatchUrl(video.youtubeId)}</a></p>}
    <form method="post" class="space-y-3">
      <input type="hidden" name="intent" value="video" />
      <div><label class="label" for="video">ลิงก์ YouTube</label><input class="field" id="video" name="video" inputmode="url" placeholder="https://youtu.be/…" value={video?.youtubeId ? youtubeWatchUrl(video.youtubeId) : ''} /></div>
      <button class="btn-primary w-full" type="submit">บันทึกวิดีโอ</button>
    </form>
    {video && (
      <form method="post" class="mt-3" data-confirm="ลบวิดีโอนี้หรือไม่?">
        <input type="hidden" name="intent" value="video" /><input type="hidden" name="video" value="" />
        <button class="btn-ghost w-full" type="submit">ลบวิดีโอ</button>
      </form>
    )}
  </section>
</AdminLayout>

<script>
  import { resizeAll } from '../../../../scripts/resize-image';
  import { describeUploadError, newBatchId, postUpload } from '../../../../scripts/upload';

  // ย่อรูปก่อนอัปโหลด แล้วส่งด้วย fetch (ถ้า JS ใช้ไม่ได้ ฟอร์มจะส่งไฟล์เดิมตามปกติ)
  // ยืนยันก่อนลบ/กันกดซ้ำ อยู่ในสคริปต์กลางของหลังบ้าน (scripts/admin-forms.ts)
  const form = document.getElementById('upload-form') as HTMLFormElement | null;
  const status = document.getElementById('upload-status')!;
  const btn = document.getElementById('upload-btn') as HTMLButtonElement | null;
  const input = form?.querySelector<HTMLInputElement>('input[type=file]');
  const say = (msg: string, bad = false) => {
    status.textContent = msg;
    status.classList.remove('hidden');
    status.classList.toggle('bg-red-50', bad);
    status.classList.toggle('text-danger', bad);
  };
  // รหัสชุดผูกกับ "ไฟล์ที่เลือก" — กดส่งซ้ำหลังเน็ตหลุด เซิร์ฟเวอร์จะไม่บันทึกรูปเดิมซ้ำ
  let batch = newBatchId();
  input?.addEventListener('change', () => (batch = newBatchId()));

  form?.addEventListener('submit', async (e) => {
    const picked = [...(input?.files ?? [])];
    if (picked.length === 0) return; // ให้ server แจ้งว่ายังไม่ได้เลือกไฟล์
    e.preventDefault();
    btn && (btn.disabled = true);
    try {
      const small = await resizeAll(picked, (n, total) => say(`กำลังย่อรูป ${n}/${total}…`));
      const fd = new FormData(form);
      fd.delete('file');
      fd.set('batch', batch);
      small.forEach((f) => fd.append('file', f, f.name));
      const before = picked.reduce((n, f) => n + f.size, 0), after = small.reduce((n, f) => n + f.size, 0);
      say(`กำลังอัปโหลด… (${(before / 1048576).toFixed(1)} MB → ${(after / 1048576).toFixed(1)} MB)`);
      const r = await postUpload(form.action || location.href, fd, after);
      location.href = r.redirect ?? location.href;
    } catch (err) {
      say(describeUploadError(err), true);
      btn && (btn.disabled = false);
    }
  });
</script>
