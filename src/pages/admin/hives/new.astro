---
import Icon from '../../../components/Icon.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../server/db.ts';
import { createHive, nextHiveCode } from '../../../server/hives.ts';
import { boxLabel, originLabel } from '../../../lib/labels.ts';
import { newHiveSchema, parseForm, todayBangkok, type FieldErrors } from '../../../lib/validation.ts';
import { isOwner } from '../../../lib/permissions.ts';

export const prerender = false;

const db = getDb();
const today = todayBangkok();
let errors: FieldErrors = {};
let values: Record<string, string> = {};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
  const p = parseForm(newHiveSchema, form);
  if (!p.ok) errors = p.errors;
  else {
    const r = await createHive(db, Astro.locals.user!, p.data);
    if (r.ok) return Astro.redirect(`/admin/hives/${r.code}?saved=created`, 303);
    errors = { _: r.error };
  }
}
const nextCode = await nextHiveCode(db);
const v = (k: string, d = '') => values[k] ?? d;
const err = (k: string) => errors[k];
---

<AdminLayout back={{ href: '/admin/hives', label: 'รังทั้งหมด' }} title={`เพิ่มรังใหม่ (${nextCode})`} active="new">
  {errors._ && <p role="alert" class="mb-4 rounded-xl bg-red-50 p-3 font-medium text-danger">{errors._}</p>}
  <form method="post" class="card max-w-xl space-y-4">
    <input type="hidden" name="idem" value={v('idem') || crypto.randomUUID()} />
    <p class="rounded-xl bg-palm-50 p-3">รหัสรังใหม่จะเป็น <strong>{nextCode}</strong> (ระบบกำหนดให้อัตโนมัติ)</p>

    <div>
      <label class="label" for="origin">ที่มา</label>
      <select class="field" id="origin" name="origin" required>
        <option value="">เลือก…</option>
        {(['queen_bred', 'split', 'purchased', 'natural'] as const).map((o) => <option value={o} selected={v('origin') === o}>{originLabel[o]}</option>)}
      </select>
      {err('origin') && <p class="error">{err('origin')}</p>}
    </div>

    <div class="grid grid-cols-2 gap-3">
      <div><label class="label" for="acq">วันที่ได้มา / วันที่ขยาย</label><input class="field" id="acq" name="acquiredOn" type="date" max={today} value={v('acquiredOn', today)} />{err('acquiredOn') && <p class="error">{err('acquiredOn')}</p>}</div>
      <div><label class="label" for="qb">วันเกิดนางพญา</label><input class="field" id="qb" name="queenBornOn" type="date" max={today} value={v('queenBornOn')} />{err('queenBornOn') && <p class="error">{err('queenBornOn')}</p>}<p class="hint">ถ้ายังไม่ทราบ เว้นว่างได้ (จะแสดง ???)</p></div>
    </div>

    <fieldset class="rounded-xl border border-line p-3">
      <legend class="px-1 text-sm font-medium">รังแม่ (สำหรับรังที่ขยายเอง)</legend>
      <div class="grid grid-cols-2 gap-3">
        <div><label class="label" for="qs">ไข่นางจากรัง</label><input class="field" id="qs" name="queenSourceCode" placeholder="เช่น A55" value={v('queenSourceCode')} />{err('queenSourceCode') && <p class="error">{err('queenSourceCode')}</p>}</div>
        <div><label class="label" for="bs">ไข่อ่อนจากรัง</label><input class="field" id="bs" name="broodSourceCode" placeholder="เช่น A89" value={v('broodSourceCode')} />{err('broodSourceCode') && <p class="error">{err('broodSourceCode')}</p>}</div>
      </div>
      <p class="hint">ระบบจะบันทึกประวัติ "แยกรัง" ในรังแม่ให้อัตโนมัติ (ตามวันที่ได้มา)</p>
    </fieldset>

    <div class="grid grid-cols-2 gap-3">
      <div>
        <label class="label" for="box">กล่องรัง</label>
        <select class="field" id="box" name="boxType">
          {(['teak_2room', 'log', 'other'] as const).map((b) => <option value={b} selected={(v('boxType') || 'teak_2room') === b}>{boxLabel[b]}</option>)}
        </select>
      </div>
      <div><label class="label" for="place">สถานที่ซื้อ (ถ้าซื้อมา)</label><input class="field" id="place" name="originPlace" maxlength="100" value={v('originPlace')} /></div>
    </div>

    {isOwner(Astro.locals.user) && <div><label class="label" for="price">ราคาซื้อ (บาท) <Icon name="lock" class="inline-block size-[1.15em] align-[-0.2em]" /></label><input class="field" id="price" name="purchasePrice" type="number" inputmode="numeric" min="0" value={v('purchasePrice')} /></div>}
    <div><label class="label" for="notes">หมายเหตุภายใน <Icon name="lock" class="inline-block size-[1.15em] align-[-0.2em]" /></label><textarea class="field" id="notes" name="notes" rows="2" maxlength="1000">{v('notes')}</textarea></div>

    <div class="sticky bottom-[calc(4.75rem+env(safe-area-inset-bottom))] z-10 -mx-4 border-t border-line bg-surface/95 px-4 py-3 backdrop-blur md:static md:mx-0 md:border-0 md:bg-transparent md:p-0 md:backdrop-blur-none">
      <button class="btn-primary w-full" type="submit">สร้างรัง {nextCode}</button>
    </div>
  </form>
</AdminLayout>
