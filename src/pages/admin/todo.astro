---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../server/db.ts';
import { fillMissing, getHiveDetail, listIncompleteHives, markUnknown } from '../../server/hives.ts';
import { originLabel, statusLabel } from '../../lib/labels.ts';
import { unknownTopics } from '../../lib/unknown-notes.ts';
import { fieldErrors, fillSchema, todayBangkok } from '../../lib/validation.ts';
import { provinceOf } from '../../lib/place.ts';
import { formatThaiDate } from '../../lib/thai-date.ts';

export const prerender = false;

const db = getDb();
const user = Astro.locals.user!;
const today = todayBangkok();
let error = '';
let errorCode = '';
let errorFields: Record<string, string> = {};
let values: Record<string, string> = {};
const saved = Astro.url.searchParams.get('saved');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const code = String(form.get('code') ?? '').toUpperCase();
  const intent = String(form.get('intent') ?? '');
  const detail = /^A\d{1,5}$/.test(code) ? await getHiveDetail(db, code) : null;
  values = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
  errorCode = code;
  if (!detail) error = 'ไม่พบรังนี้';
  else if (intent === 'fill') {
    const p = fillSchema.safeParse(values);
    if (!p.success) { errorFields = fieldErrors(p.error); error = 'กรอกข้อมูลไม่ถูกต้อง'; }
    else {
      const r = await fillMissing(db, user, detail.hive, p.data);
      if (r.ok) return Astro.redirect(`/admin/todo?saved=${code}`, 303);
      error = r.error;
    }
  } else if (intent === 'unknown') {
    const r = await markUnknown(db, user, detail.hive, String(form.get('topic') ?? ''));
    if (r.ok) return Astro.redirect(`/admin/todo?saved=${code}-unknown`, 303);
    error = r.error;
  } else error = 'คำสั่งไม่ถูกต้อง';
}

const rows = await listIncompleteHives(db);
const items = rows.map((h) => ({ ...h, topics: unknownTopics(h.notes) }));
---

<AdminLayout back={{ href: '/admin/readiness', label: 'เตรียมเปิดเว็บ' }} title="ข้อมูลที่ยังไม่ครบ" active="todo">
  {saved && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900">✅ บันทึกรัง {saved.split('-')[0]} แล้ว{saved.endsWith('-unknown') ? ' (ตั้งเป็น "ไม่ทราบจริง ๆ" — เลิกเตือน)' : ''}</p>}
  {error && <p role="alert" class="mb-4 rounded-xl bg-red-50 p-3 font-medium text-danger">รัง {errorCode}: {error}</p>}

  <section class="card mb-4">
    <p class="text-lg"><strong>{items.length}</strong> รังที่ยังมีข้อมูลไม่ทราบ (???)</p>
    <p class="hint">เติมเฉพาะที่รู้แล้วกด <strong>บันทึก</strong> · ถ้าไม่มีทางรู้ได้ กด <strong>ไม่ทราบจริง ๆ</strong> เพื่อเลิกเตือนหัวข้อนั้น · ทั้งสองอย่าง <strong>แก้ไขทีหลังได้เสมอ</strong> ที่หน้า "แก้ไขข้อมูลรัง"</p>
  </section>

  {items.length === 0 ? (
    <div class="card text-center"><p class="text-3xl" aria-hidden="true">🎉</p><p class="mt-1 text-lg font-semibold">ไม่มีข้อมูลค้างแล้ว</p></div>
  ) : (
    <ul class="grid gap-4 lg:grid-cols-2">
      {items.map((h) => {
        const needs = (t: string) => h.topics.includes(t);
        const needQueen = needs('รังแม่ (ไข่นาง)') || needs('รังแม่ (ไข่อ่อนและไข่นาง)');
        const needBrood = needs('รังแม่ (ไข่อ่อน)') || needs('รังแม่ (ไข่อ่อนและไข่นาง)');
        const mine = errorCode === h.code;
        const val = (k: string) => (mine ? (values[k] ?? '') : '');
        return (
          <li class="card space-y-3" id={`h-${h.code}`}>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <a class="inline-flex min-h-11 min-w-11 items-center text-xl font-bold hover:underline" href={`/admin/hives/${h.code}`}>{h.code}</a>
              <a class="inline-flex min-h-11 items-center text-sm underline" href={`/admin/hives/${h.code}/edit`}>แก้ไขเต็มรูปแบบ →</a>
            </div>
            <p class="text-sm text-muted">{originLabel[h.origin]}{provinceOf(h.originPlace) ? ` · ${provinceOf(h.originPlace)}` : ''} · {statusLabel[h.status]} · ได้มา {formatThaiDate(h.acquiredOn)}</p>
            <p class="rounded-xl bg-honey-50 p-2 text-sm">ยังไม่ทราบ: {h.topics.join(' · ')}</p>

            <form method="post" class="space-y-3" data-confirm={`เปลี่ยนสถานะรัง ${h.code} เป็น "{status}" ด้วย ใช่ไหม?`} data-confirm-when="status">
              <input type="hidden" name="intent" value="fill" /><input type="hidden" name="code" value={h.code} />
              {(needs('วันเกิดนางพญา')) && <div><label class="label" for={`qb-${h.code}`}>วันเกิดนางพญา</label><input class="field" id={`qb-${h.code}`} name="queenBornOn" type="date" max={today} value={val('queenBornOn')} />{mine && errorFields.queenBornOn && <p class="error">{errorFields.queenBornOn}</p>}</div>}
              {(needs('วันที่ซื้อ')) && <div><label class="label" for={`ac-${h.code}`}>วันที่ซื้อ</label><input class="field" id={`ac-${h.code}`} name="acquiredOn" type="date" max={today} value={val('acquiredOn')} />{mine && errorFields.acquiredOn && <p class="error">{errorFields.acquiredOn}</p>}</div>}
              {(needQueen || needBrood) && (
                <div class="grid grid-cols-2 gap-3">
                  {needQueen && <div><label class="label" for={`qs-${h.code}`}>ไข่นางจากรัง</label><input class="field" id={`qs-${h.code}`} name="queenSourceCode" placeholder="เช่น A55" value={val('queenSourceCode')} />{mine && errorFields.queenSourceCode && <p class="error">{errorFields.queenSourceCode}</p>}</div>}
                  {needBrood && <div><label class="label" for={`bs-${h.code}`}>ไข่อ่อนจากรัง</label><input class="field" id={`bs-${h.code}`} name="broodSourceCode" placeholder="เช่น A89" value={val('broodSourceCode')} />{mine && errorFields.broodSourceCode && <p class="error">{errorFields.broodSourceCode}</p>}</div>}
                </div>
              )}
              {needs('สถานะรัง') && (
                <div><label class="label" for={`st-${h.code}`}>สถานะรัง</label>
                  <select class="field" id={`st-${h.code}`} name="status"><option value="">เลือก…</option>{(['active', 'sold', 'collapsed'] as const).map((s) => <option value={s} selected={val('status') === s}>{statusLabel[s]}</option>)}</select>
                  <p class="hint">บันทึกเป็นเหตุการณ์ "เปลี่ยนสถานะ" วันนี้</p></div>
              )}
              <button class="btn-primary w-full" type="submit">บันทึกที่กรอก</button>
            </form>

            <details class="rounded-xl border border-line p-2">
              <summary class="flex min-h-11 cursor-pointer items-center text-sm text-muted">ไม่มีทางรู้ได้? ตั้งเป็น "ไม่ทราบจริง ๆ"</summary>
              <div class="mt-2 flex flex-wrap gap-2">
                {h.topics.map((t) => (
                  <form method="post">
                    <input type="hidden" name="intent" value="unknown" /><input type="hidden" name="code" value={h.code} /><input type="hidden" name="topic" value={t} />
                    <button class="btn-ghost text-sm" type="submit">ไม่ทราบ: {t}</button>
                  </form>
                ))}
              </div>
            </details>
          </li>
        );
      })}
    </ul>
  )}
</AdminLayout>
