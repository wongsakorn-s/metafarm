---
import Icon from '../../components/Icon.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import SalesTabs from '../../components/SalesTabs.astro';
import { getDb } from '../../server/db.ts';
import { getMedia } from '../../server/db.ts';
import { removeProductImage, setProductImage } from '../../server/media.ts';
import { placeholder } from '../../lib/placeholders.ts';
import { listProductsAdmin, setProductPublished, updateVariant } from '../../server/products.ts';
import { categoryLabel, formatPrice, sizeLabel } from '../../lib/products.ts';
import { parseForm, publishSchema, variantSchema } from '../../lib/validation.ts';
import { jsonResult, wantsJson } from '../../lib/http.ts';
import { differingFields, shortStamp, type FieldDiff } from '../../lib/concurrency.ts';
import ConflictNotice from '../../components/ConflictNotice.astro';

export const prerender = false;

const db = getDb();
const user = Astro.locals.user!;
let error = '';
let errorVariant = 0;
let errorFields: Record<string, string> = {};
let posted: Record<string, string> = {};
const saved = Astro.url.searchParams.get('saved');
let conflictVariant = 0;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  if (intent === 'variant') {
    posted = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
    const p = parseForm(variantSchema, form);
    if (!p.ok) { errorFields = p.errors; errorVariant = Number(form.get('variantId')); error = 'กรอกข้อมูลไม่ถูกต้อง'; }
    else {
      const r = await updateVariant(db, user, p.data);
      if (r.ok) return Astro.redirect('/admin/products?saved=variant', 303);
      // ชนกัน: แถวนั้นแสดงค่าที่กรอกไว้ + กล่องเทียบค่าล่าสุด (ไม่ใช้แถบแดงด้านบน)
      if (r.conflict) { conflictVariant = p.data.variantId; errorVariant = conflictVariant; }
      else error = r.error;
    }
  } else if (intent === 'publish') {
    const p = parseForm(publishSchema, form);
    if (!p.ok) error = 'ข้อมูลไม่ถูกต้อง';
    else {
      const r = await setProductPublished(db, user, p.data);
      if (r.ok) return Astro.redirect('/admin/products?saved=publish', 303);
      error = r.error;
    }
  } else if (intent === 'image') {
    const file = form.get('file');
    if (!(file instanceof File) || file.size === 0) error = 'ยังไม่ได้เลือกรูป';
    else {
      const r = await setProductImage(db, getMedia(), user, Number(form.get('productId')), file);
      if (r.ok) {
        if (wantsJson(Astro.request)) return jsonResult({ ok: true, message: 'เปลี่ยนรูปสินค้าแล้ว', redirect: '/admin/products?saved=image' });
        return Astro.redirect('/admin/products?saved=image', 303);
      }
      error = r.error ?? 'อัปโหลดไม่สำเร็จ';
    }
    if (wantsJson(Astro.request)) return jsonResult({ ok: false, message: error });
  } else if (intent === 'image_remove') {
    const r = await removeProductImage(db, getMedia(), user, Number(form.get('productId')));
    if (r.ok) return Astro.redirect('/admin/products?saved=image_removed', 303);
    error = r.error ?? 'ลบไม่สำเร็จ';
  } else error = 'คำสั่งไม่ถูกต้อง';
}

const items = await listProductsAdmin(db);
// ชนกัน: เทียบค่าที่กรอกกับค่าล่าสุดของแถวนั้น แล้วเลื่อนเวอร์ชันเป็นล่าสุด (กดบันทึกอีกครั้ง = ยืนยันค่าของคุณ)
let conflict: { diffs: FieldDiff[]; at: string } | null = null;
const latestVariant = items.flatMap((p) => p.variants).find((v) => v.id === conflictVariant);
if (latestVariant) {
  conflict = { diffs: differingFields(posted, latestVariant, { priceThb: 'ราคา (บาท)', stockQty: 'สต็อก (ชิ้น)', unitCost: 'ต้นทุน/ชิ้น' }), at: shortStamp(latestVariant.updatedAt) };
  posted.version = latestVariant.updatedAt;
}
const savedText: Record<string, string> = { variant: 'บันทึกราคาและสต็อกแล้ว (ถือว่ายืนยันราคาแล้ว)', publish: 'บันทึกการแสดง/ซ่อนสินค้าแล้ว', image: 'เปลี่ยนรูปสินค้าแล้ว', image_removed: 'ลบรูปสินค้าแล้ว (เว็บกลับไปใช้รูปชั่วคราว)' };
---

<AdminLayout title="สินค้า" active="products">
  <SalesTabs active="products" />
  {saved && savedText[saved] && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900"><Icon name="check" class="inline-block size-[1.15em] align-[-0.2em]" /> {savedText[saved]}</p>}
  {error && <p role="alert" class="mb-4 rounded-xl bg-red-50 p-3 font-medium text-danger">{error}</p>}

  <p class="mb-4 rounded-xl bg-honey-50 p-3 text-sm">
    ราคาที่ยังเป็น <strong>ตัวอย่าง</strong> จะมีป้าย "ราคาตัวอย่าง" บนเว็บ — เมื่อกด <strong>บันทึก</strong> ที่ตัวเลือกใด ระบบถือว่าคุณยืนยันราคานั้นแล้วและป้ายจะหายไป
    · <strong>รังสมบูรณ์</strong> ไม่ได้จัดการที่นี่ แต่ตั้งขายที่หน้ารังแต่ละรัง (<a class="underline" href="/admin/hives?forSale=1">ดูรังที่ตั้งขาย</a>)
  </p>

  <div class="space-y-5">
    {items.map((p) => (
      <section class="card" aria-labelledby={`p-${p.id}`}>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 id={`p-${p.id}`} class="text-lg font-semibold">{p.name}</h2>
            <p class="text-sm text-muted">{categoryLabel[p.category]} · <a class="underline" href={`/products/${p.slug}`} target="_blank" rel="noopener">ดูบนเว็บ</a></p>
          </div>
          <form method="post" class="flex items-center gap-2">
            <input type="hidden" name="intent" value="publish" /><input type="hidden" name="productId" value={p.id} />
            {p.published ? <><span class="badge bg-palm-100 text-palm-900">แสดงบนเว็บ</span><button class="btn-ghost" type="submit">ซ่อน</button></> : <><span class="badge bg-slate-200 text-slate-700">ซ่อนอยู่</span><input type="hidden" name="published" value="on" /><button class="btn-primary" type="submit">แสดง</button></>}
          </form>
        </div>

        <div class="mt-4 flex flex-wrap items-start gap-4">
          <img src={p.imageKey ? `/media/${p.imageKey}` : p.category === 'honey' ? placeholder.honey : placeholder.hiveBox} alt={p.imageKey ? `รูปสินค้า ${p.name}` : 'รูปชั่วคราว'} width="160" height="120" class="h-[120px] w-40 rounded-xl bg-palm-50 object-cover" />
          <div class="min-w-0 flex-1 basis-60 space-y-2">
            <p class="text-sm font-medium">{p.imageKey ? 'รูปสินค้า (รูปจริง)' : 'ยังใช้รูปชั่วคราวอยู่ — อัปโหลดรูปจริงได้เลย (เปลี่ยนได้ทุกเมื่อ)'}</p>
            <form method="post" enctype="multipart/form-data" data-resize class="flex flex-wrap items-center gap-2">
              <input type="hidden" name="intent" value="image" /><input type="hidden" name="productId" value={p.id} />
              <input class="field-file min-w-0 flex-1" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/*" required aria-label={`เลือกรูปสินค้า ${p.name}`} />
              <button class="btn-primary" type="submit">{p.imageKey ? 'เปลี่ยนรูป' : 'อัปโหลดรูป'}</button>
            </form>
            {p.imageKey && (
              <form method="post" data-confirm="ลบรูปสินค้านี้ แล้วกลับไปใช้รูปชั่วคราวหรือไม่?">
                <input type="hidden" name="intent" value="image_remove" /><input type="hidden" name="productId" value={p.id} />
                <button class="btn-ghost" type="submit">ลบรูป</button>
              </form>
            )}
            <p class="hint" data-upload-status role="status" aria-live="polite"></p>
          </div>
        </div>

        <ul class="mt-4 space-y-3">
          {p.variants.map((v) => (
            <li class="rounded-xl border border-line p-3">
              {conflict && conflictVariant === v.id && <ConflictNotice form={`variant-${v.id}`} diffs={conflict.diffs} by={null} reason="คนอื่นบันทึก หรือออเดอร์ตัด/คืนสต็อก" at={conflict.at} />}
              <form method="post" id={`variant-${v.id}`} class="grid grid-cols-3 items-end gap-3 sm:grid-cols-[1fr_8rem_8rem_8rem_auto]">
                <input type="hidden" name="intent" value="variant" /><input type="hidden" name="variantId" value={v.id} />
                <input type="hidden" name="version" value={errorVariant === v.id && posted.version ? posted.version : v.updatedAt} />
                <div class="col-span-3 sm:col-span-1">
                  <p class="font-medium">{v.label}{sizeLabel(v.sizeMl) ? ` · ${sizeLabel(v.sizeMl)}` : ''}</p>
                  <p class="text-sm text-muted">{v.priceConfirmed ? `ราคาปัจจุบัน ${formatPrice(v.priceThb)} (ยืนยันแล้ว)` : <span class="font-medium text-honey-700">ราคาตัวอย่าง {formatPrice(v.priceThb)} — ยังไม่ได้ยืนยัน</span>}</p>
                </div>
                <div><label class="label" for={`pr-${v.id}`}>ราคา (บาท)</label><input class="field" id={`pr-${v.id}`} name="priceThb" type="number" inputmode="numeric" min="1" required value={errorVariant === v.id ? (posted.priceThb ?? '') : v.priceThb} />{errorVariant === v.id && errorFields.priceThb && <p class="error">{errorFields.priceThb}</p>}</div>
                <div><label class="label" for={`st-${v.id}`}>สต็อก (ชิ้น)</label><input class="field" id={`st-${v.id}`} name="stockQty" type="number" inputmode="numeric" min="0" required value={errorVariant === v.id ? (posted.stockQty ?? '') : v.stockQty} />{errorVariant === v.id && errorFields.stockQty && <p class="error">{errorFields.stockQty}</p>}</div>
                <div><label class="label" for={`co-${v.id}`}>ต้นทุน/ชิ้น</label><input class="field" id={`co-${v.id}`} name="unitCost" type="number" inputmode="numeric" min="0" placeholder="ไม่ทราบ" value={errorVariant === v.id ? (posted.unitCost ?? '') : (v.unitCost ?? '')} />{errorVariant === v.id && errorFields.unitCost && <p class="error">{errorFields.unitCost}</p>}</div>
                <button class="btn-primary col-span-3 sm:col-span-1" type="submit">บันทึก</button>
              </form>
              <p class="hint">สต็อก 0 = เว็บแสดง "สอบถามสต็อกก่อนสั่ง" (ไม่แสดงจำนวนจริงให้ลูกค้าเห็น) · ต้นทุนใช้คิดกำไรในรายงาน ไม่แสดงบนเว็บ (น้ำผึ้งใช้ต้นทุนตอนบรรจุขวดก่อน)</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</AdminLayout>

<script>
  import { resizeImage } from '../../scripts/resize-image';
  import { describeUploadError, postUpload } from '../../scripts/upload';

  // ย่อรูปในเบราว์เซอร์ก่อนส่ง (ประหยัดเน็ต) — ถ้า JS ใช้ไม่ได้ ฟอร์มส่งไฟล์เดิมตามปกติ
  // ยืนยันก่อนลบ/กันกดซ้ำ อยู่ในสคริปต์กลางของหลังบ้าน (scripts/admin-forms.ts)
  document.querySelectorAll<HTMLFormElement>('form[data-resize]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      const input = form.querySelector<HTMLInputElement>('input[type=file]')!;
      const file = input.files?.[0];
      if (!file) return;
      e.preventDefault();
      const status = form.parentElement?.querySelector<HTMLElement>('[data-upload-status]');
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
      btn && (btn.disabled = true);
      try {
        status && (status.textContent = 'กำลังย่อรูปและอัปโหลด…');
        const small = await resizeImage(file);
        const fd = new FormData(form);
        fd.set('file', small, small.name);
        const r = await postUpload(form.action || location.href, fd, small.size);
        location.href = r.redirect ?? location.href;
      } catch (err) {
        status && (status.textContent = describeUploadError(err));
        btn && (btn.disabled = false);
      }
    });
  });
</script>
