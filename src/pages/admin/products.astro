---
import Icon from '../../components/Icon.astro';
import Notice from '../../components/Notice.astro';
import PhotoTips from '../../components/PhotoTips.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import SalesTabs from '../../components/SalesTabs.astro';
import { getDb } from '../../server/db.ts';
import { getMedia } from '../../server/db.ts';
import { deleteProductPhoto, listProductPhotos, moveProductPhoto, reorderProductPhotos, uploadProductPhotos } from '../../server/product-photos.ts';
import { productPhotoLimit } from '../../lib/product-photos.ts';
import { MAX_FILES_PER_REQUEST, thumbUrl, uploadSummary } from '../../lib/media.ts';
import { placeholder } from '../../lib/placeholders.ts';
import { addVariant, listProductsAdmin, setProductPublished, setVariantHidden, updateProductDescription, updateVariant } from '../../server/products.ts';
import { categoryLabel, formatPrice, variantName } from '../../lib/products.ts';
import { newVariantSchema, parseForm, productTextSchema, publishSchema, variantHiddenSchema, variantSchema } from '../../lib/validation.ts';
import { jsonResult, wantsJson } from '../../lib/http.ts';
import { differingFields, shortStamp, type FieldDiff } from '../../lib/concurrency.ts';
import ConflictNotice from '../../components/ConflictNotice.astro';
import VideoUploader from '../../components/VideoUploader.astro';
import { posterKeyOf } from '../../lib/video.ts';
import { removeProductVideo, setProductYoutube } from '../../server/video.ts';

export const prerender = false;

const db = getDb();
const user = Astro.locals.user!;
let error = '';
let errorVariant = 0;
let errorFields: Record<string, string> = {};
let posted: Record<string, string> = {};
const saved = Astro.url.searchParams.get('saved');
let conflictVariant = 0;
/** ฟอร์มเพิ่มขนาดของสินค้าไหนที่ส่งมา (เปิดค้างไว้พร้อมค่าที่กรอก เมื่อกรอกผิด) */
let addFor = 0;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  if (intent === 'variant') {
    posted = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
    const p = parseForm(variantSchema, form);
    if (!p.ok) { errorFields = p.errors; errorVariant = Number(form.get('variantId')); error = 'กรอกข้อมูลไม่ถูกต้อง'; }
    else {
      const r = await updateVariant(db, user, p.data);
      if (r.ok) return Astro.redirect('/admin/products?saved=variant', 303);
      // ชนกัน: แถวนั้นแสดงค่าที่กรอกไว้ + กล่องเทียบค่าล่าสุด (ไม่ใช้แถบแดงด้านบน)
      if (r.conflict) { conflictVariant = p.data.variantId; errorVariant = conflictVariant; }
      else error = r.error;
    }
  } else if (intent === 'variant_add') {
    posted = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
    addFor = Number(form.get('productId'));
    const p = parseForm(newVariantSchema, form);
    if (!p.ok) errorFields = p.errors;
    else {
      const r = await addVariant(db, user, p.data);
      if (r.ok) return Astro.redirect('/admin/products?saved=variant_add', 303);
      error = r.error;
    }
  } else if (intent === 'product_text') {
    const p = parseForm(productTextSchema, form);
    if (!p.ok) error = p.errors.name ?? p.errors.description ?? 'ข้อมูลไม่ถูกต้อง';
    else {
      const r = await updateProductDescription(db, user, p.data);
      if (r.ok) return Astro.redirect('/admin/products?saved=product_text', 303);
      error = r.error;
    }
  } else if (intent === 'variant_hidden') {
    const p = parseForm(variantHiddenSchema, form);
    if (!p.ok) error = 'ข้อมูลไม่ถูกต้อง';
    else {
      const r = await setVariantHidden(db, user, p.data);
      if (r.ok) return Astro.redirect(`/admin/products?saved=${p.data.hidden ? 'variant_hide' : 'variant_show'}`, 303);
      error = r.error;
    }
  } else if (intent === 'publish') {
    const p = parseForm(publishSchema, form);
    if (!p.ok) error = 'ข้อมูลไม่ถูกต้อง';
    else {
      const r = await setProductPublished(db, user, p.data);
      if (r.ok) return Astro.redirect('/admin/products?saved=publish', 303);
      error = r.error;
    }
  } else if (intent === 'photo_upload') {
    const productId = Number(form.get('productId'));
    const files = form.getAll('file').filter((f): f is File => f instanceof File && f.size > 0);
    const back = (msg: string) => `/admin/products?${new URLSearchParams({ msg })}#p-${productId}`;
    if (files.length === 0) error = 'ยังไม่ได้เลือกรูป';
    else {
      const thumbs = form.getAll('thumb').map((f) => (f instanceof File ? f : new File([], '')));
      const mediums = form.getAll('medium').map((f) => (f instanceof File ? f : new File([], '')));
      const r = await uploadProductPhotos(db, getMedia(), user, productId, files, { batch: String(form.get('batch') ?? ''), thumbs, mediums });
      const message = r.error ?? uploadSummary(r.added, r.skipped);
      // สคริปต์อัปโหลด/คิวรอสต้องรู้ผลจริง (422 เมื่อข้ามทุกไฟล์)
      if (wantsJson(Astro.request)) return jsonResult({ ok: r.added > 0, message, added: r.added, skipped: r.skipped, redirect: back(message) });
      return Astro.redirect(back(message), 303);
    }
    if (wantsJson(Astro.request)) return jsonResult({ ok: false, message: error });
  } else if (intent === 'reorder') {
    const productId = Number(form.get('category'));
    const ids = String(form.get('order') ?? '').split(',').map(Number).filter((n) => Number.isInteger(n) && n > 0);
    const r = productId && ids.length ? await reorderProductPhotos(db, user, productId, ids) : { ok: false, error: 'ข้อมูลลำดับไม่ถูกต้อง' };
    if (wantsJson(Astro.request)) return jsonResult({ ok: r.ok, message: r.ok ? 'บันทึกลำดับแล้ว' : (r.error ?? 'บันทึกไม่สำเร็จ') });
    if (r.ok) return Astro.redirect(`/admin/products?${new URLSearchParams({ msg: 'บันทึกลำดับแล้ว' })}#p-${productId}`, 303);
    error = r.error ?? 'บันทึกไม่สำเร็จ';
  } else if (intent === 'photo_move') {
    const dir = String(form.get('dir') ?? '');
    if (dir !== 'up' && dir !== 'down' && dir !== 'top') error = 'คำสั่งไม่ถูกต้อง';
    else {
      const r = await moveProductPhoto(db, user, Number(form.get('photoId')), dir);
      if (r.ok) return Astro.redirect(`/admin/products?${new URLSearchParams({ msg: 'ย้ายรูปแล้ว' })}#p-${Number(form.get('productId'))}`, 303);
      error = r.error ?? 'ย้ายไม่สำเร็จ';
    }
  } else if (intent === 'product_video_youtube') {
    const productId = Number(form.get('productId'));
    const youtube = String(form.get('youtube') ?? '');
    const r = await setProductYoutube(db, getMedia(), user, productId, youtube);
    if (r.ok) return Astro.redirect(`/admin/products?${new URLSearchParams({ msg: 'บันทึกวิดีโอ YouTube แล้ว' })}#p-${productId}`, 303);
    error = r.error ?? 'บันทึกไม่สำเร็จ';
  } else if (intent === 'product_video_delete') {
    const productId = Number(form.get('productId'));
    const r = await removeProductVideo(db, getMedia(), user, productId);
    if (r.ok) return Astro.redirect(`/admin/products?${new URLSearchParams({ msg: 'ลบวิดีโอแล้ว' })}#p-${productId}`, 303);
    error = r.error ?? 'ลบไม่สำเร็จ';
  } else if (intent === 'photo_delete') {
    const r = await deleteProductPhoto(db, getMedia(), user, Number(form.get('photoId')));
    if (r.ok) return Astro.redirect(`/admin/products?${new URLSearchParams({ msg: 'ลบรูปแล้ว' })}#p-${Number(form.get('productId'))}`, 303);
    error = r.error ?? 'ลบไม่สำเร็จ';
  } else error = 'คำสั่งไม่ถูกต้อง';
}

const items = await listProductsAdmin(db);
const allPhotos = await listProductPhotos(db);
const hasUnconfirmed = items.some((p) => p.variants.some((v) => !v.priceConfirmed));
const notice = Astro.url.searchParams.get('msg') ?? '';
// ชนกัน: เทียบค่าที่กรอกกับค่าล่าสุดของแถวนั้น แล้วเลื่อนเวอร์ชันเป็นล่าสุด (กดบันทึกอีกครั้ง = ยืนยันค่าของคุณ)
let conflict: { diffs: FieldDiff[]; at: string } | null = null;
const latestVariant = items.flatMap((p) => p.variants).find((v) => v.id === conflictVariant);
if (latestVariant) {
  conflict = { diffs: differingFields(posted, latestVariant, { priceThb: 'ราคา (บาท)', stockQty: 'สต็อก (ชิ้น)', unitCost: 'ต้นทุน/ชิ้น' }), at: shortStamp(latestVariant.updatedAt) };
  posted.version = latestVariant.updatedAt;
}
const savedText: Record<string, string> = { product_text: 'บันทึกชื่อและคำอธิบายสินค้าแล้ว', variant_add: 'เพิ่มขนาดแล้ว — แสดงบนเว็บทันที (สต็อกเริ่มที่ 0)', variant_hide: 'ซ่อนขนาดแล้ว — ไม่แสดงบนเว็บและในฟอร์มออเดอร์ใหม่', variant_show: 'แสดงขนาดนั้นอีกครั้งแล้ว', variant: 'บันทึกราคาและสต็อกแล้ว (ถือว่ายืนยันราคาแล้ว)', publish: 'บันทึกการแสดง/ซ่อนสินค้าแล้ว', image: 'เปลี่ยนรูปสินค้าแล้ว', image_removed: 'ลบรูปสินค้าแล้ว (เว็บกลับไปใช้รูปชั่วคราว)' };
---

<AdminLayout title="สินค้า" active="products">
  <SalesTabs active="products" />
  {saved && savedText[saved] && <Notice tone="ok" class="mb-4">{savedText[saved]}</Notice>}
  {notice && <Notice tone="ok" class="mb-4">{notice}</Notice>}
  <p id="sort-status" role="status" class="mb-4 hidden rounded-xl p-3 font-medium"></p>
  <p id="sort-live" class="sr-only" aria-live="polite"></p>
  {error && <Notice tone="error" class="mb-4">{error}</Notice>}

  <nav aria-label="สินค้า" class="scroll-fade mb-4 flex gap-1.5 overflow-x-auto pb-1">
    {items.map((p) => (
      <a href={`#p-${p.id}`} class="inline-flex min-h-11 shrink-0 items-center rounded-full border border-line bg-surface px-4 text-sm font-medium hover:bg-palm-50">{p.name}</a>
    ))}
  </nav>

  {hasUnconfirmed && (
    <Notice tone="warn" class="mb-4">
      ป้าย "ราคาตัวอย่าง" บนเว็บจะหายไปเมื่อกด <strong>บันทึก</strong> ยืนยันราคา · รังสมบูรณ์ตั้งขายที่ <a class="underline font-medium" href="/admin/hives?forSale=1">หน้ารัง</a>
    </Notice>
  )}

  <div class="space-y-5">
    {items.map((p) => (
      <section class="card scroll-mt-20" id={`p-${p.id}`} aria-labelledby={`h-${p.id}`}>
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 id={`h-${p.id}`} class="text-lg font-semibold">{p.name}</h2>
            <p class="text-sm text-muted">{categoryLabel[p.category]} · <a class="underline" href={`/products/${p.slug}`} target="_blank" rel="noopener">ดูบนเว็บ</a></p>
          </div>
          <form method="post" class="flex items-center gap-2">
            <input type="hidden" name="intent" value="publish" /><input type="hidden" name="productId" value={p.id} />
            {p.published ? <><span class="badge bg-palm-100 text-palm-900">แสดงบนเว็บ</span><button class="btn-ghost" type="submit">ซ่อน</button></> : <><span class="badge bg-slate-200 text-slate-700">ซ่อนอยู่</span><input type="hidden" name="published" value="on" /><button class="btn-primary" type="submit">แสดง</button></>}
          </form>
        </div>

        <div class="mt-4">
          <p class="hint mb-2">สต็อก 0 = เว็บขึ้น "สอบถามก่อนสั่ง" · ต้นทุนลูกค้าไม่เห็น</p>
          <ul class="space-y-3">
            {p.variants.filter((v) => !v.hidden).map((v) => (
              <li class="rounded-xl border border-line bg-surface p-3.5">
                {conflict && conflictVariant === v.id && <ConflictNotice form={`variant-${v.id}`} diffs={conflict.diffs} by={null} reason="คนอื่นบันทึก หรือออเดอร์ตัด/คืนสต็อก" at={conflict.at} />}
                <form method="post" id={`variant-${v.id}`} class="space-y-3">
                  <input type="hidden" name="intent" value="variant" /><input type="hidden" name="variantId" value={v.id} />
                  <input type="hidden" name="version" value={errorVariant === v.id && posted.version ? posted.version : v.updatedAt} />
                  <div class="border-b border-line pb-2">
                    <span class="font-semibold">{variantName(v.label, v.sizeMl)}</span>
                    {!v.priceConfirmed && <span class="ml-2 inline-block rounded-md bg-honey-50 px-2 py-0.5 text-xs font-medium text-honey-700">ราคาตัวอย่าง — ยังไม่ได้ยืนยัน</span>}
                  </div>
                  <div class="grid grid-cols-2 items-end gap-3 sm:grid-cols-[1fr_1fr_1fr_auto]">
                    <div><label class="label" for={`pr-${v.id}`}>ราคา (บาท)</label><input class="field" id={`pr-${v.id}`} name="priceThb" type="number" inputmode="numeric" min="1" required value={errorVariant === v.id ? (posted.priceThb ?? '') : v.priceThb} />{errorVariant === v.id && errorFields.priceThb && <p class="error">{errorFields.priceThb}</p>}</div>
                    <div><label class="label" for={`st-${v.id}`}>สต็อก (ชิ้น)</label><input class="field" id={`st-${v.id}`} name="stockQty" type="number" inputmode="numeric" min="0" required value={errorVariant === v.id ? (posted.stockQty ?? '') : v.stockQty} />{errorVariant === v.id && errorFields.stockQty && <p class="error">{errorFields.stockQty}</p>}</div>
                    <div class="col-span-2 sm:col-span-1"><label class="label" for={`co-${v.id}`}>ต้นทุน/ชิ้น</label><input class="field" id={`co-${v.id}`} name="unitCost" type="number" inputmode="numeric" min="0" placeholder="ไม่ทราบ" value={errorVariant === v.id ? (posted.unitCost ?? '') : (v.unitCost ?? '')} />{errorVariant === v.id && errorFields.unitCost && <p class="error">{errorFields.unitCost}</p>}</div>
                    <button class="btn-primary col-span-2 sm:col-span-1" type="submit">บันทึก</button>
                  </div>
                </form>
                <div class="mt-2 flex justify-end">
                  <form method="post" data-confirm={`ซ่อนขนาด "${v.label}" ใช่ไหม? จะไม่แสดงบนเว็บ ในฟอร์มออเดอร์ใหม่ และการบรรจุขวด (แสดงกลับได้ภายหลัง)`}>
                    <input type="hidden" name="intent" value="variant_hidden" /><input type="hidden" name="variantId" value={v.id} /><input type="hidden" name="hidden" value="on" />
                    <button class="inline-flex min-h-11 items-center text-xs text-muted hover:text-danger hover:underline" type="submit">ซ่อนขนาดนี้</button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-4 divide-y divide-line border-t border-line text-sm">
          {(() => {
            const ph = allPhotos.filter((x) => x.productId === p.id);
            const max = productPhotoLimit(p.category);
            const hasVid = p.videoKey || p.videoYoutubeId;
            return (
              <details class="py-1">
                <summary class="disclosure min-h-11 cursor-pointer font-medium text-palm-700">
                  <span class="inline-flex items-center gap-2"><Icon name="image" class="size-4 shrink-0 text-palm-700" />รูปและวิดีโอ ({ph.length}{hasVid ? ' + วิดีโอ' : ''})</span>
                </summary>
              <div class="mt-3 space-y-4">
                <div data-photos={p.id}>
                  <h3 class="text-sm font-medium">รูปสินค้า <span class="font-normal text-muted">({ph.length}/{max})</span></h3>
                  {ph.length === 0 ? (
                    <div class="mt-2 flex items-center gap-3">
                      <img src={p.category === 'honey' ? placeholder.honey : placeholder.hiveBox} alt="รูปชั่วคราว" width="160" height="120" class="h-[90px] w-[120px] rounded-xl bg-palm-50 object-cover" />
                      <p class="text-sm text-muted">ยังใช้รูปชั่วคราวอยู่ — อัปโหลดรูปจริงได้เลย (ใส่ได้ไม่เกิน {max} รูป)</p>
                    </div>
                  ) : (
                    <>
                      {ph.length > 1 && <PhotoTips kind="sort" class="mt-1 mb-2" />}
                      <ul class="mt-2 grid grid-cols-2 gap-3 sm:grid-cols-3" data-zoom-group data-sortable data-category={p.id}>
                        {ph.map((x, i) => (
                          <li class="space-y-2" data-photo-id={x.id}>
                            <div class="relative overflow-hidden rounded-xl">
                              <a href={`/media/${x.r2Key}`} data-zoom data-caption={p.name} aria-label={`ดูรูปที่ ${i + 1} ของ ${p.name} ขยาย`} class="relative block" target="_blank" rel="noopener">
                                <span aria-hidden="true" data-num data-pos class="absolute left-2 top-2 grid min-w-7 place-items-center rounded-full bg-black/60 px-2 py-0.5 text-sm font-semibold text-white">{i + 1}</span>
                                <img src={thumbUrl(`/media/${x.r2Key}`)} alt={`รูปสินค้า ${p.name} ที่ ${i + 1}`} loading="lazy" width="480" height="360" class="aspect-[4/3] w-full rounded-xl bg-palm-50 object-cover" />
                              </a>
                              <button type="button" data-drag-handle aria-pressed="false" aria-label={`จัดลำดับรูปที่ ${i + 1} จาก ${ph.length} — กด Space เพื่อหยิบ แล้วใช้ลูกศรเลื่อน`}
                                class="absolute right-2 top-2 grid size-11 cursor-grab touch-none select-none place-items-center rounded-full bg-black/60 text-white backdrop-blur hover:bg-black/75 active:cursor-grabbing focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"><Icon name="grip" class="size-5" /></button>
                              <form method="post" data-confirm="ลบรูปนี้ออกจากสินค้าใช่ไหม?" class="absolute bottom-2 right-2 z-10">
                                <input type="hidden" name="intent" value="photo_delete" /><input type="hidden" name="photoId" value={x.id} /><input type="hidden" name="productId" value={p.id} />
                                <button class="grid size-11 place-items-center rounded-full bg-black/60 text-white backdrop-blur hover:bg-danger active:bg-danger" type="submit" aria-label="ลบรูป"><Icon name="trash" class="size-5" /></button>
                              </form>
                            </div>
                            <noscript><div class="flex items-center gap-1" role="group" aria-label={`ลำดับรูปที่ ${i + 1} จาก ${ph.length}`}>
                              {(['up', 'down', 'top'] as const).map((d) => {
                                const off = d === 'down' ? i === ph.length - 1 : i === 0;
                                const label = { up: 'เลื่อนขึ้น', down: 'เลื่อนลง', top: 'ไปบนสุด' }[d];
                                return (
                                  <form method="post" class="flex-1">
                                    <input type="hidden" name="intent" value="photo_move" /><input type="hidden" name="photoId" value={x.id} /><input type="hidden" name="productId" value={p.id} /><input type="hidden" name="dir" value={d} />
                                    <button class="btn-ghost !px-0 w-full min-w-11" type="submit" disabled={off} aria-label={`${label} (รูปที่ ${i + 1})`} title={label}><Icon name={d} class="size-5" /></button>
                                  </form>
                                );
                              })}
                            </div></noscript>
                          </li>
                        ))}
                      </ul>
                    </>
                  )}
                  {ph.length < max && (
                    <form method="post" enctype="multipart/form-data" data-photo-upload data-label={p.name} class="mt-3 space-y-2">
                      <input type="hidden" name="intent" value="photo_upload" /><input type="hidden" name="productId" value={p.id} />
                      <label class="label flex min-h-11 items-end" for={`pf-${p.id}`}>เพิ่มรูป (เลือกได้ครั้งละหลายรูป · เหลืออีก {max - ph.length} รูป)</label>
                      <input class="field-file" id={`pf-${p.id}`} name="file" type="file" accept="image/jpeg,image/png,image/webp,image/*" multiple />
                      <p class="hint">ครั้งละไม่เกิน {MAX_FILES_PER_REQUEST} รูป · ระบบย่อรูปและลบตำแหน่งที่ถ่ายให้เอง · รูปขึ้นหน้าเว็บทันที</p>
                      <p data-upload-status class="hidden rounded-xl bg-honey-50 p-3 text-sm font-medium text-honey-700" role="status" aria-live="polite"></p>
                      <button class="btn-primary w-full sm:w-auto" type="submit">อัปโหลดรูป</button>
                    </form>
                  )}
                </div>

                <div class="rounded-xl border border-line p-3" id={`video-${p.id}`}>
                  <h3 class="flex items-center gap-2 text-sm font-medium">
                    <Icon name="video" class="size-4 text-palm-700" /> วิดีโอสินค้า (1 คลิป)
                  </h3>
                  {p.videoKey ? (
                    <div class="mt-2 space-y-2">
                      <div class="max-w-md overflow-hidden rounded-xl bg-black">
                        <video class="aspect-video w-full object-cover" controls playsinline preload="metadata" poster={`/video/${posterKeyOf(p.videoKey)}`}>
                          <source src={`/video/${p.videoKey}`} type="video/mp4" />
                        </video>
                      </div>
                      <form method="post" data-confirm="ลบวิดีโอนี้ออกจากสินค้าใช่ไหม?">
                        <input type="hidden" name="intent" value="product_video_delete" />
                        <input type="hidden" name="productId" value={p.id} />
                        <button class="btn-danger text-sm" type="submit"><Icon name="trash" class="inline-block size-[1.15em] align-[-0.2em]" /> ลบวิดีโอ</button>
                      </form>
                    </div>
                  ) : p.videoYoutubeId ? (
                    <div class="mt-2 space-y-2">
                      <div class="aspect-video max-w-md overflow-hidden rounded-xl bg-black">
                        <iframe class="size-full" src={`https://www.youtube-nocookie.com/embed/${p.videoYoutubeId}`} title={p.name} allowfullscreen></iframe>
                      </div>
                      <form method="post" data-confirm="ลบวิดีโอนี้ออกจากสินค้าใช่ไหม?">
                        <input type="hidden" name="intent" value="product_video_delete" />
                        <input type="hidden" name="productId" value={p.id} />
                        <button class="btn-danger text-sm" type="submit"><Icon name="trash" class="inline-block size-[1.15em] align-[-0.2em]" /> ลบวิดีโอ</button>
                      </form>
                    </div>
                  ) : (
                    <div class="mt-2 space-y-3">
                      <details>
                        <summary class="disclosure min-h-11 text-sm font-medium text-palm-700">อัปโหลดวิดีโอ (MP4)</summary>
                        <div class="mt-2">
                          <VideoUploader action={`/admin/products/${p.id}/video`} id={`video-upload-${p.id}`} />
                        </div>
                      </details>
                      <details>
                        <summary class="disclosure min-h-11 text-sm font-medium text-palm-700">หรือใช้วิดีโอจาก YouTube</summary>
                        <form method="post" class="mt-2 flex flex-wrap items-end gap-2">
                          <input type="hidden" name="intent" value="product_video_youtube" />
                          <input type="hidden" name="productId" value={p.id} />
                          <div class="min-w-[200px] flex-1">
                            <label class="label" for={`yt-${p.id}`}>ลิงก์วิดีโอ YouTube</label>
                            <input class="field" id={`yt-${p.id}`} name="youtube" placeholder="https://www.youtube.com/watch?v=..." required />
                          </div>
                          <button class="btn-primary" type="submit">บันทึก YouTube</button>
                        </form>
                      </details>
                    </div>
                  )}
                </div>
              </div>
            </details>
          );
        })()}

        <details class="py-1">
          <summary class="disclosure min-h-11 cursor-pointer font-medium text-palm-700">
            <span class="inline-flex items-center gap-2"><Icon name="edit" class="size-4 shrink-0 text-palm-700" />ชื่อและคำอธิบายสินค้าบนเว็บ</span>
          </summary>
          <form method="post" class="mt-3 space-y-2">
            <input type="hidden" name="intent" value="product_text" /><input type="hidden" name="productId" value={p.id} />
            <label class="label" for={`pn-${p.id}`}>ชื่อสินค้า</label>
            <input class="field" id={`pn-${p.id}`} name="name" required minlength="2" maxlength="100" value={p.name} />
            <label class="label" for={`pd-${p.id}`}>คำอธิบายสินค้า</label>
            <textarea class="field" id={`pd-${p.id}`} name="description" rows="5" maxlength="400">{p.description ?? ''}</textarea>
            <button class="btn-primary" type="submit">บันทึกชื่อและคำอธิบาย</button>
          </form>
        </details>

        {p.variants.some((v) => v.hidden) && (
          <details class="py-1">
            <summary class="disclosure min-h-11 cursor-pointer text-muted">
              <span class="inline-flex items-center gap-2"><Icon name="ban" class="size-4 shrink-0 text-muted" />ขนาดที่ซ่อนอยู่ ({p.variants.filter((v) => v.hidden).length})</span>
            </summary>
            <ul class="mt-2 divide-y divide-line">
              {p.variants.filter((v) => v.hidden).map((v) => (
                <li class="flex flex-wrap items-center justify-between gap-2 py-1">
                  <span class="text-sm">{variantName(v.label, v.sizeMl)} · {formatPrice(v.priceThb)} · สต็อก {v.stockQty}</span>
                  <form method="post">
                    <input type="hidden" name="intent" value="variant_hidden" /><input type="hidden" name="variantId" value={v.id} />
                    <button class="btn-ghost" type="submit">แสดงอีกครั้ง</button>
                  </form>
                </li>
              ))}
            </ul>
          </details>
        )}

        <details class="py-1" open={addFor === p.id}>
          <summary class="disclosure min-h-11 cursor-pointer font-medium text-palm-700">
            <span class="inline-flex items-center gap-2"><Icon name="plus" class="size-4 shrink-0 text-palm-700" />เพิ่มขนาด / ตัวเลือก</span>
          </summary>
          <form method="post" class="mt-3 grid grid-cols-2 items-end gap-3 sm:grid-cols-[1fr_8rem_8rem_auto]">
            <input type="hidden" name="intent" value="variant_add" /><input type="hidden" name="productId" value={p.id} />
            <div class="col-span-2 sm:col-span-1"><label class="label" for={`nv-l-${p.id}`}>ชื่อตัวเลือก</label><input class="field" id={`nv-l-${p.id}`} name="label" required maxlength="60" placeholder={p.category === 'honey' ? 'เช่น ขวด 175 มล.' : 'เช่น รังไม้สัก 2 ห้อง'} value={addFor === p.id ? (posted.label ?? '') : ''} />{addFor === p.id && errorFields.label && <p class="error">{errorFields.label}</p>}</div>
            <div><label class="label" for={`nv-s-${p.id}`}>ขนาด (มล.)</label><input class="field" id={`nv-s-${p.id}`} name="sizeMl" type="number" inputmode="numeric" min="1" required={p.category === 'honey'} placeholder={p.category === 'honey' ? '175' : 'ไม่มี'} value={addFor === p.id ? (posted.sizeMl ?? '') : ''} />{addFor === p.id && errorFields.sizeMl && <p class="error">{errorFields.sizeMl}</p>}</div>
            <div><label class="label" for={`nv-p-${p.id}`}>ราคา (บาท)</label><input class="field" id={`nv-p-${p.id}`} name="priceThb" type="number" inputmode="numeric" min="1" required value={addFor === p.id ? (posted.priceThb ?? '') : ''} />{addFor === p.id && errorFields.priceThb && <p class="error">{errorFields.priceThb}</p>}</div>
            <button class="btn-primary col-span-2 sm:col-span-1" type="submit">เพิ่ม</button>
          </form>
          <p class="hint mt-2">ราคาที่กรอกถือว่ายืนยันแล้ว · สต็อกเริ่มที่ 0{p.category === 'honey' ? ' (จะเพิ่มเองเมื่อบรรจุขวดในหน้าล็อต)' : ''} · ขนาดที่เลิกขายแล้ว กด "ซ่อนขนาดนี้"</p>
        </details>
        </div>
      </section>
    ))}
  </div>
</AdminLayout>

<script>
  import '../../scripts/gallery-sort';
  import { appendPrepared, resizeAll } from '../../scripts/resize-image';
  import { describeUploadError, newBatchId } from '../../scripts/upload';
  import { fieldsOf, QUEUED_MSG, SESSION_QUEUED_MSG, sendOrQueue, UNSAVED_MSG } from '../../scripts/outbox';

  // เหมือนหน้ารูปรัง/แกลเลอรี: ย่อรูปก่อนส่ง + รหัสชุด (ส่งซ้ำไม่บันทึกซ้ำ) + คิวรอส่งเมื่อสัญญาณหลุด
  // ยืนยันก่อนลบ/กันกดซ้ำ อยู่ในสคริปต์กลางของหลังบ้าน (scripts/admin-forms.ts)
  document.querySelectorAll<HTMLFormElement>('form[data-photo-upload]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-upload-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]');
    const input = form.querySelector<HTMLInputElement>('input[type=file]')!;
    const say = (msg: string, bad = false) => {
      status.textContent = msg;
      status.classList.remove('hidden');
      status.classList.toggle('bg-red-50', bad);
      status.classList.toggle('text-danger', bad);
      status.classList.toggle('bg-honey-50', !bad);
      status.classList.toggle('text-honey-700', !bad);
    };
    let batch = newBatchId();
    input.addEventListener('change', () => (batch = newBatchId()));
    form.addEventListener('submit', async (e) => {
      const picked = [...(input.files ?? [])];
      if (picked.length === 0) return;
      e.preventDefault();
      btn && (btn.disabled = true);
      try {
        const small = await resizeAll(picked, (n, total) => say(`กำลังย่อรูป ${n}/${total}…`));
        const fd = new FormData(form);
        fd.delete('file');
        fd.set('batch', batch);
        appendPrepared(fd, small);
        const after = small.reduce((n, p) => n + p.file.size + (p.thumb?.size ?? 0) + (p.medium?.size ?? 0), 0);
        say('กำลังอัปโหลด…');
        const o = await sendOrQueue({ kind: 'photo', url: form.action || location.href, fields: await fieldsOf(fd), label: `สินค้า · ${form.dataset.label} · ${small.length} รูป`, bytes: after });
        if (o.kind === 'done') { location.href = o.redirect ?? location.href; return; }
        if (o.kind === 'invalid') say(`ไม่ได้บันทึกรูป: ${o.message}`, true);
        else if (o.kind === 'unsaved') say(UNSAVED_MSG, true);
        else { say(o.kind === 'session' ? SESSION_QUEUED_MSG : QUEUED_MSG); form.reset(); batch = newBatchId(); }
        btn && (btn.disabled = false);
      } catch (err) {
        say(describeUploadError(err), true);
        btn && (btn.disabled = false);
      }
    });
  });
</script>
