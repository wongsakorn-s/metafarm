---
import Icon from '../../components/Icon.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, getMedia } from '../../server/db.ts';
import { deleteGalleryPhoto, listGalleryAdmin, updateGalleryCaption, uploadGalleryPhotos } from '../../server/gallery.ts';
import { captionSchema, GALLERY_CATEGORIES, GALLERY_MAX_PER_CATEGORY, galleryCategory, isGalleryCategory } from '../../lib/gallery.ts';
import { MAX_FILES_PER_REQUEST, thumbUrl, uploadSummary } from '../../lib/media.ts';
import { jsonResult, wantsJson } from '../../lib/http.ts';

// รูปหน้าแกลเลอรีสาธารณะ — เจ้าของ/แอดมินเท่านั้น (MANAGER_ONLY ใน permissions.ts)
export const prerender = false;

const db = getDb();
const user = Astro.locals.user!;
let error = '';
const notice = Astro.url.searchParams.get('msg') ?? '';
const picked = Astro.url.searchParams.get('c');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const back = (msg: string, c?: string) => Astro.redirect(`/admin/gallery?${new URLSearchParams({ msg, ...(c ? { c } : {}) })}${c ? `#${c}` : ''}`, 303);

  if (intent === 'upload') {
    const category = form.get('category');
    const files = form.getAll('file').filter((f): f is File => f instanceof File && f.size > 0);
    const caption = captionSchema.safeParse(form.get('caption') ?? '');
    if (!isGalleryCategory(category)) error = 'เลือกหมวดรูป';
    else if (files.length === 0) error = 'ยังไม่ได้เลือกไฟล์';
    else if (!caption.success) error = caption.error.issues[0]?.message ?? 'คำบรรยายไม่ถูกต้อง';
    else {
      const thumbs = form.getAll('thumb').map((f) => (f instanceof File ? f : new File([], '')));
      const r = await uploadGalleryPhotos(db, getMedia(), user, category, files, { batch: String(form.get('batch') ?? ''), thumbs, caption: caption.data });
      const message = uploadSummary(r.added, r.skipped);
      const redirect = `/admin/gallery?${new URLSearchParams({ msg: message, c: category })}#${category}`;
      // สคริปต์อัปโหลด/คิวรอส่งต้องรู้ผลจริง (422 เมื่อข้ามทุกไฟล์)
      if (wantsJson(Astro.request)) return jsonResult({ ok: r.added > 0, message, added: r.added, skipped: r.skipped, redirect });
      return Astro.redirect(redirect, 303);
    }
    if (wantsJson(Astro.request)) return jsonResult({ ok: false, message: error });
  } else if (intent === 'caption') {
    const caption = captionSchema.safeParse(form.get('caption') ?? '');
    if (!caption.success) error = caption.error.issues[0]?.message ?? 'คำบรรยายไม่ถูกต้อง';
    else {
      const r = await updateGalleryCaption(db, user, Number(form.get('photoId')), caption.data);
      if (r.ok) return back('บันทึกคำบรรยายแล้ว', String(form.get('category') ?? ''));
      error = r.error ?? 'บันทึกไม่สำเร็จ';
    }
  } else if (intent === 'delete') {
    const r = await deleteGalleryPhoto(db, getMedia(), user, Number(form.get('photoId')));
    if (r.ok) return back('ลบรูปแล้ว', String(form.get('category') ?? ''));
    error = r.error ?? 'ลบไม่สำเร็จ';
  } else error = 'คำสั่งไม่ถูกต้อง';
}

const rows = await listGalleryAdmin(db);
const sections = GALLERY_CATEGORIES.map((c) => ({ key: c, ...galleryCategory[c], photos: rows.filter((r) => r.category === c) }));
const defaultCategory = isGalleryCategory(picked) ? picked : 'farm';
---

<AdminLayout back={{ href: '/admin/more', label: 'เมนู' }} title="รูปหน้าแกลเลอรี" active="more">
  {notice && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900"><Icon name="check" class="inline-block size-[1.15em] align-[-0.2em]" /> {notice}</p>}
  {error && <p role="alert" class="mb-4 rounded-xl bg-red-50 p-3 font-medium text-danger">{error}</p>}

  <div class="grid gap-5 lg:grid-cols-[24rem_minmax(0,1fr)] lg:items-start">
    <form method="post" enctype="multipart/form-data" id="upload-form" class="card space-y-3 lg:sticky lg:top-6">
      <input type="hidden" name="intent" value="upload" />
      <h2 class="text-lg font-semibold"><Icon name="camera" class="inline-block size-[1.15em] align-[-0.2em]" /> เพิ่มรูป</h2>
      <fieldset>
        <legend class="label">หมวด</legend>
        <div class="grid gap-2">
          {sections.map((s) => (
            <label class="flex min-h-11 items-center gap-2 rounded-xl border border-line px-3">
              <input class="size-5 accent-palm-600" type="radio" name="category" value={s.key} checked={s.key === defaultCategory} required />
              {s.label} <span class="ml-auto text-sm text-muted">{s.photos.length}/{GALLERY_MAX_PER_CATEGORY}</span>
            </label>
          ))}
        </div>
      </fieldset>
      <div>
        <label class="label" for="file">เลือกรูป (ถ่ายใหม่หรือเลือกจากเครื่อง)</label>
        <input class="field-file" id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/*" multiple />
        <p class="hint">ครั้งละไม่เกิน {MAX_FILES_PER_REQUEST} รูป · ย่อรูปและลบพิกัด GPS ให้อัตโนมัติ</p>
      </div>
      <div>
        <label class="label" for="caption">คำบรรยาย (ไม่บังคับ ใช้กับทุกรูปที่เลือก)</label>
        <input class="field" id="caption" name="caption" maxlength="200" placeholder="เช่น ส่งมอบรังที่ จ.ชลบุรี" />
      </div>
      <p class="rounded-xl bg-honey-50 p-3 text-sm">รูปขึ้นหน้าเว็บทันที · รูป<strong>ส่งมอบ</strong>ที่เห็นหน้า บ้าน หรือทะเบียนรถของลูกค้า ควรขออนุญาตลูกค้าก่อน</p>
      <p id="upload-status" class="hidden rounded-xl bg-honey-50 p-3 text-sm font-medium text-honey-700" role="status" aria-live="polite"></p>
      <button id="upload-btn" class="btn-primary w-full" type="submit">อัปโหลด</button>
      <a class="inline-flex min-h-11 items-center text-sm underline" href="/gallery" target="_blank" rel="noopener">ดูหน้าแกลเลอรีบนเว็บ</a>
    </form>

    <div class="space-y-5">
      {sections.map((s) => (
        <section id={s.key} class="card scroll-mt-20" aria-labelledby={`h-${s.key}`}>
          <h2 id={`h-${s.key}`} class="flex items-center gap-2 text-lg font-semibold"><Icon name={s.icon} class="size-5 text-palm-700" />{s.label} <span class="text-sm font-normal text-muted">({s.photos.length})</span></h2>
          {s.photos.length === 0 ? <p class="mt-2 text-muted">ยังไม่มีรูป — หน้าเว็บแสดงกรอบรูปชั่วคราวไว้ก่อน</p> : (
            <ul class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3">
              {s.photos.map((p) => (
                <li class="space-y-2">
                  <img src={thumbUrl(`/media/${p.r2Key}`)} alt={p.caption ?? s.label} loading="lazy" width="480" height="360" class="aspect-[4/3] w-full rounded-xl bg-palm-50 object-cover" />
                  <form method="post" class="space-y-1">
                    <input type="hidden" name="intent" value="caption" /><input type="hidden" name="photoId" value={p.id} /><input type="hidden" name="category" value={s.key} />
                    <label class="sr-only" for={`cap-${p.id}`}>คำบรรยายรูป</label>
                    <input class="field" id={`cap-${p.id}`} name="caption" maxlength="200" value={p.caption ?? ''} placeholder="คำบรรยาย" />
                    <button class="btn-ghost w-full" type="submit">บันทึกคำบรรยาย</button>
                  </form>
                  <form method="post" data-confirm="ลบรูปนี้ออกจากหน้าแกลเลอรีใช่ไหม?">
                    <input type="hidden" name="intent" value="delete" /><input type="hidden" name="photoId" value={p.id} /><input type="hidden" name="category" value={s.key} />
                    <button class="btn-danger w-full" type="submit"><Icon name="trash" class="inline-block size-[1.15em] align-[-0.2em]" /> ลบ</button>
                  </form>
                </li>
              ))}
            </ul>
          )}
        </section>
      ))}
    </div>
  </div>
</AdminLayout>

<script>
  import { appendPrepared, resizeAll } from '../../scripts/resize-image';
  import { describeUploadError, newBatchId } from '../../scripts/upload';
  import { fieldsOf, QUEUED_MSG, SESSION_QUEUED_MSG, sendOrQueue, UNSAVED_MSG } from '../../scripts/outbox';

  // เหมือนหน้ารูปรัง: ย่อรูปก่อนส่ง + รหัสชุด (ส่งซ้ำไม่บันทึกซ้ำ) + คิวรอส่งเมื่อสัญญาณไม่ดี · JS ใช้ไม่ได้ = ส่งไฟล์เดิมตามปกติ
  const form = document.getElementById('upload-form') as HTMLFormElement | null;
  const status = document.getElementById('upload-status')!;
  const btn = document.getElementById('upload-btn') as HTMLButtonElement | null;
  const input = form?.querySelector<HTMLInputElement>('input[type=file]');
  const say = (msg: string, bad = false) => {
    status.textContent = msg;
    status.classList.remove('hidden');
    status.classList.toggle('bg-red-50', bad);
    status.classList.toggle('text-danger', bad);
    status.classList.toggle('bg-honey-50', !bad);
    status.classList.toggle('text-honey-700', !bad);
  };
  let batch = newBatchId();
  input?.addEventListener('change', () => (batch = newBatchId()));

  form?.addEventListener('submit', async (e) => {
    const picked = [...(input?.files ?? [])];
    if (picked.length === 0) return;
    e.preventDefault();
    btn && (btn.disabled = true);
    try {
      const small = await resizeAll(picked, (n, total) => say(`กำลังย่อรูป ${n}/${total}…`));
      const fd = new FormData(form);
      fd.delete('file');
      fd.set('batch', batch);
      appendPrepared(fd, small);
      const after = small.reduce((n, p) => n + p.file.size + (p.thumb?.size ?? 0), 0);
      say('กำลังอัปโหลด…');
      const label = (form.querySelector<HTMLInputElement>('input[name=category]:checked')?.parentElement?.textContent ?? '').trim().split(/\s+\d/)[0];
      const o = await sendOrQueue({ kind: 'photo', url: form.action || location.href, fields: await fieldsOf(fd), label: `แกลเลอรี · ${label} · ${small.length} รูป`, bytes: after });
      if (o.kind === 'done') { location.href = o.redirect ?? location.href; return; }
      if (o.kind === 'invalid') say(`ไม่ได้บันทึกรูป: ${o.message}`, true);
      else if (o.kind === 'unsaved') say(UNSAVED_MSG, true);
      else { say(o.kind === 'session' ? SESSION_QUEUED_MSG : QUEUED_MSG); form.reset(); batch = newBatchId(); }
      btn && (btn.disabled = false);
    } catch (err) {
      say(describeUploadError(err), true);
      btn && (btn.disabled = false);
    }
  });
</script>
