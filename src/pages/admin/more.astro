---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../lib/icons.ts';
import { canManageFarm, canManageUsers, roleLabel } from '../../lib/permissions.ts';

// "เมนู" ของมือถือ: หน้ารองทั้งหมดรวมไว้ที่เดียว (เดิมตั้งค่า/บัญชี/ออกจากระบบ อัดอยู่แถบบนจนตัวอักษรตกบรรทัด)
export const prerender = false;
const user = Astro.locals.user!;
const owner = canManageFarm(user);

const groups = [
  {
    title: 'งานที่ฟาร์ม',
    items: [
      { href: '/admin/lots', icon: 'honey', label: 'น้ำผึ้ง (ล็อต)', hint: 'สร้างล็อต บรรจุขวด พิมพ์ฉลาก' },
      { href: '/admin/production', icon: 'chart', label: 'ผลผลิตน้ำผึ้งและอากาศ', hint: 'น้ำผึ้ง การขยายรัง เทียบกับฝนและอุณหภูมิ' },
      { href: '/admin/hives/new', icon: 'plus', label: 'เพิ่มรังใหม่' },
      { href: '/admin/photos', icon: 'camera', label: 'รังที่ยังไม่มีรูป', hint: 'ไปถ่ายรูปรังเหล่านี้' },
      { href: '/admin/todo', icon: 'note', label: 'รังที่ข้อมูลยังไม่ครบ', hint: 'รังที่ยังมีเรื่องไม่ทราบ (???)' },
      { href: '/admin/outbox', icon: 'status', label: 'รายการที่ค้างส่ง', hint: 'ที่บันทึกไว้ตอนสัญญาณไม่ดี — รอส่งในเครื่องนี้' },
    ],
  },
  ...(owner ? [{
    title: 'แก้หน้าเว็บ',
    items: [
      { href: '/admin/settings', icon: 'settings', label: 'ช่องทางติดต่อและชำระเงิน', hint: 'LINE เบอร์โทร Facebook แผนที่ เลขบัญชี พิกัดฟาร์ม' },
      { href: '/admin/settings/home', icon: 'globe', label: 'หน้าแรกและหลักสูตรอบรม', hint: 'รูปหน้าแรก วิดีโอแนะนำฟาร์ม ราคาอบรม' },
      { href: '/admin/gallery', icon: 'image', label: 'รูปหน้าแกลเลอรี', hint: 'ชันโรง ส่งมอบรัง ส่งมอบน้ำผึ้ง ห้องงานไม้' },
      { href: '/admin/products', icon: 'cart', label: 'สินค้าและราคา', hint: 'ชื่อ ราคา รูปของรังเปล่าและน้ำผึ้ง' },
      { href: '/admin/readiness', icon: 'checklist', label: 'สิ่งที่ต้องทำก่อนเปิดเว็บ', hint: 'รายการที่ยังต้องเติมก่อนเปิดจริง' },
      { href: '/', icon: 'globe', label: 'ดูหน้าเว็บจริง', external: true },
    ],
  }] : [{ title: 'เว็บไซต์', items: [{ href: '/', icon: 'globe', label: 'ดูหน้าเว็บจริง', external: true }] }]),
  {
    title: 'บัญชี',
    items: [
      { href: '/admin/account', icon: 'key', label: 'บัญชีและรหัสผ่านของฉัน', hint: user.email },
      ...(canManageUsers(Astro.locals.user) ? [{ href: '/admin/users', icon: 'lock', label: 'คนใช้งานระบบ', hint: 'เพิ่มคนใช้ เปลี่ยนสิทธิ์ ปิดบัญชี' }] : []),
    ],
  },
] as { title: string; items: { href: string; icon: string; label: string; hint?: string; external?: boolean }[] }[];
---

<AdminLayout title="เมนู" active="more">
  <p class="mb-4 text-muted">เข้าสู่ระบบเป็น <strong class="text-ink">{user.name}</strong> ({roleLabel[user.role]})</p>
  <div class="space-y-5 md:grid md:grid-cols-2 md:items-start md:gap-5 md:space-y-0 2xl:grid-cols-3">
    {groups.map((g) => (
      <section aria-labelledby={`g-${g.title}`}>
        <h2 id={`g-${g.title}`} class="mb-2 px-1 text-sm font-semibold text-muted">{g.title}</h2>
        <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
          {g.items.map((it) => (
            <li>
              <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined} class="flex min-h-14 items-center gap-3 px-4 py-2 active:bg-canvas">
                <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-palm-50 text-palm-700"><Icon name={it.icon as IconName} class="size-5" /></span>
                <span class="min-w-0 flex-1"><span class="block font-medium">{it.label}</span>{it.hint && <span class="block truncate text-sm text-muted">{it.hint}</span>}</span>
                <Icon name="chevron" class="size-5 shrink-0 text-muted" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section id="install" class="rounded-2xl border border-line bg-surface p-4 md:hidden" aria-labelledby="install-h">
      <h2 id="install-h" class="font-semibold">ติดตั้งเป็นแอปบนหน้าจอโฮม</h2>
      <p class="hint mb-2">ติดตั้งแอปไว้ที่หน้าจอมือถือ เปิดได้เร็วจากไอคอน และเวลาสัญญาณไม่ดี รายการที่บันทึกไว้จะรอส่งในเครื่องได้นานขึ้น (สำคัญสำหรับ iPhone)</p>
      <ul class="space-y-1 text-sm">
        <li><strong>iPhone (Safari):</strong> กดปุ่มแชร์ (สี่เหลี่ยมมีลูกศรขึ้น) → "เพิ่มไปยังหน้าจอโฮม" — แอปบน iPhone เก็บข้อมูลแยกจาก Safari ถ้ามีรายการ "รอส่ง" ค้างอยู่ ให้ส่งให้หมดก่อนติดตั้ง และล็อกอินใหม่ในแอปหนึ่งครั้ง</li>
        <li><strong>Android (Chrome):</strong> กดเมนู ⋮ มุมขวาบน → "เพิ่มลงในหน้าจอหลัก" หรือ "ติดตั้งแอป"</li>
      </ul>
    </section>
    <form method="post" action="/admin/logout" data-confirm="ออกจากระบบใช่ไหม?" class="md:hidden">
      <button class="flex min-h-14 w-full items-center justify-center rounded-2xl border border-line bg-surface font-semibold text-danger active:bg-red-50" type="submit">ออกจากระบบ</button>
    </form>
  </div>
</AdminLayout>

<script>
  // เปิดจากไอคอนบนหน้าจอโฮมอยู่แล้ว → ไม่ต้องแสดงวิธีติดตั้ง
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone;
  if (standalone) document.getElementById('install')?.remove();
</script>
