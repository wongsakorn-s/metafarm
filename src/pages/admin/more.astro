---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../lib/icons.ts';
import { canManageFarm, canManageUsers, roleLabel } from '../../lib/permissions.ts';

// "เมนู" ของมือถือ: หน้ารองทั้งหมดรวมไว้ที่เดียว (เดิมตั้งค่า/บัญชี/ออกจากระบบ อัดอยู่แถบบนจนตัวอักษรตกบรรทัด)
export const prerender = false;
const user = Astro.locals.user!;
const owner = canManageFarm(user);

const groups = [
  {
    title: 'งานที่ฟาร์ม',
    items: [
      { href: '/admin/lots', icon: 'honey', label: 'น้ำผึ้ง (ล็อต)', hint: 'จดน้ำผึ้งที่กรองแล้ว บรรจุขวด พิมพ์ฉลาก' },
      { href: '/admin/production', icon: 'chart', label: 'ผลผลิตและอากาศ', hint: 'ดูน้ำผึ้งที่เก็บได้ เทียบกับฝนและอากาศ' },
      { href: '/admin/hives/new', icon: 'plus', label: 'เพิ่มรังใหม่', hint: 'ลงทะเบียนรังที่เพิ่งได้มาหรือเพิ่งแยก' },
      { href: '/admin/photos', icon: 'camera', label: 'รังรอถ่ายรูป', hint: 'รังเหล่านี้รอให้ไปถ่ายรูป' },
      { href: '/admin/todo', icon: 'note', label: 'รังข้อมูลไม่ครบ', hint: 'รังที่ยังมีเรื่องที่ไม่ทราบ รอเติมให้ครบ' },
      { href: '/admin/outbox', icon: 'status', label: 'รายการค้างส่ง', hint: 'ที่จดไว้ตอนสัญญาณไม่ดี และยังส่งไม่ได้' },
    ],
  },
  ...(owner ? [{
    title: 'แก้หน้าเว็บ',
    items: [
      { href: '/admin/settings', icon: 'settings', label: 'ติดต่อและชำระเงิน', hint: 'เบอร์โทร LINE Facebook แผนที่ เลขบัญชี' },
      { href: '/admin/settings/home', icon: 'globe', label: 'หน้าแรกและหลักสูตร', hint: 'รูปและวิดีโอหน้าแรก ราคาหลักสูตรอบรม' },
      { href: '/admin/gallery', icon: 'image', label: 'รูปแกลเลอรี', hint: 'เพิ่มรูปฟาร์ม รูปส่งมอบรัง/น้ำผึ้ง' },
      { href: '/admin/products', icon: 'cart', label: 'สินค้าและราคา', hint: 'แก้ชื่อ ราคา และรูปของรังเปล่ากับน้ำผึ้ง' },
      { href: '/admin/readiness', icon: 'checklist', label: 'เตรียมเปิดเว็บ', hint: 'ดูว่ายังเหลืออะไรที่ต้องกรอกก่อนเปิดเว็บ' },
      { href: '/', icon: 'globe', label: 'ดูหน้าเว็บจริง', hint: 'เปิดดูเว็บอย่างที่ลูกค้าเห็น', external: true },
    ],
  }] : [{ title: 'เว็บไซต์', items: [{ href: '/', icon: 'globe', label: 'ดูหน้าเว็บจริง', hint: 'เปิดดูเว็บอย่างที่ลูกค้าเห็น', external: true }] }]),
  {
    title: 'บัญชี',
    items: [
      { href: '/admin/account', icon: 'key', label: 'บัญชีและรหัสผ่านของฉัน', hint: 'เปลี่ยนรหัสผ่านของคุณ' },
      ...(canManageUsers(Astro.locals.user) ? [{ href: '/admin/users', icon: 'lock', label: 'คนใช้งานระบบ', hint: 'เพิ่มคนที่เข้าระบบได้ หรือปิดบัญชีคนที่ออกแล้ว' }] : []),
    ],
  },
] as { title: string; items: { href: string; icon: string; label: string; hint?: string; external?: boolean }[] }[];
---

<AdminLayout title="เมนู" active="more">
  <p class="mb-4 text-lg">สวัสดี <strong>{user.name}</strong> <span class="text-base text-muted">({roleLabel[user.role]})</span></p>
  <div class="space-y-5 md:grid md:grid-cols-2 md:items-start md:gap-5 md:space-y-0 2xl:grid-cols-3">
    {groups.map((g) => (
      <section aria-labelledby={`g-${g.title}`}>
        <h2 id={`g-${g.title}`} class="mb-2 flex items-center gap-2 px-1 text-lg font-bold text-palm-900"><span class="h-5 w-1 rounded-full bg-palm-600" aria-hidden="true"></span>{g.title}</h2>
        <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
          {g.items.map((it) => (
            <li>
              <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined} class="flex min-h-16 items-center gap-3 px-4 py-2.5 active:bg-canvas">
                <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-palm-50 text-palm-700"><Icon name={it.icon as IconName} class="size-6" /></span>
                <span class="min-w-0 flex-1"><span class="block text-base font-semibold">{it.label}</span>{it.hint && <span class="line-clamp-2 text-sm text-muted">{it.hint}</span>}</span>
                <Icon name="chevron" class="size-5 shrink-0 text-muted" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <details id="install" class="rounded-2xl border border-line bg-surface md:hidden">
      <summary class="flex min-h-14 cursor-pointer items-center gap-3 px-4 py-2 text-base font-semibold"><span class="grid size-11 shrink-0 place-items-center rounded-xl bg-palm-50 text-palm-700"><Icon name="phone" class="size-6" /></span>ติดตั้งเป็นแอปบนหน้าจอมือถือ</summary>
      <div class="space-y-3 border-t border-line p-4 text-sm">
        <p>ติดตั้งแล้วเปิดได้เร็วจากไอคอน และเวลาสัญญาณไม่ดี รายการที่บันทึกไว้จะรอส่งในเครื่องได้นานขึ้น (สำคัญสำหรับ iPhone)</p>
        <p><strong>iPhone:</strong> เปิดด้วย Safari → กดปุ่มแชร์ (สี่เหลี่ยมมีลูกศรชี้ขึ้น) → เลือก "เพิ่มไปยังหน้าจอโฮม"<br /><span class="text-muted">ถ้ามีรายการ "ค้างส่ง" อยู่ ให้ส่งให้หมดก่อนติดตั้ง และล็อกอินใหม่ในแอปหนึ่งครั้ง</span></p>
        <p><strong>Android:</strong> เปิดด้วย Chrome → กดจุดสามจุดมุมขวาบน → เลือก "เพิ่มลงในหน้าจอหลัก" หรือ "ติดตั้งแอป"</p>
      </div>
    </details>
    <form method="post" action="/admin/logout" data-confirm="ออกจากระบบใช่ไหม?" class="md:hidden">
      <button class="flex min-h-14 w-full items-center justify-center rounded-2xl border border-line bg-surface font-semibold text-danger active:bg-red-50" type="submit">ออกจากระบบ</button>
    </form>
  </div>
</AdminLayout>

<script>
  // เปิดจากไอคอนบนหน้าจอโฮมอยู่แล้ว → ไม่ต้องแสดงวิธีติดตั้ง
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone;
  if (standalone) document.getElementById('install')?.remove();
</script>
