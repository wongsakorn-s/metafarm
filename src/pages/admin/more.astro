---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../lib/icons.ts';
import { canManageFarm, canManageUsers, roleLabel } from '../../lib/permissions.ts';

export const prerender = false;
const user = Astro.locals.user!;
const owner = canManageFarm(user);

const groups = [
  {
    title: 'งาน',
    items: [
      { href: '/admin/hives/new', icon: 'plus', label: 'เพิ่มรังใหม่' },
      { href: '/admin/photos', icon: 'camera', label: 'รังรอถ่ายรูป' },
      { href: '/admin/todo', icon: 'note', label: 'รังข้อมูลไม่ครบ' },
      { href: '/admin/production', icon: 'chart', label: 'ผลผลิตและอากาศ' },
      { href: '/admin/outbox', icon: 'status', label: 'รายการค้างส่ง' },
      ...(owner ? [{ href: '/admin/readiness', icon: 'checklist', label: 'เตรียมเปิดเว็บ' }] : []),
    ],
  },
  ...(owner ? [{
    title: 'หน้าเว็บ',
    items: [
      { href: '/admin/settings', icon: 'settings', label: 'ติดต่อและชำระเงิน' },
      { href: '/admin/settings/home', icon: 'globe', label: 'หน้าแรกและหลักสูตร' },
      { href: '/admin/gallery', icon: 'image', label: 'รูปแกลเลอรี' },
      { href: '/', icon: 'globe', label: 'ดูหน้าเว็บจริง', external: true },
    ],
  }] : [{
    title: 'หน้าเว็บ',
    items: [
      { href: '/', icon: 'globe', label: 'ดูหน้าเว็บจริง', external: true },
    ],
  }]),
  {
    title: 'บัญชี',
    items: [
      { href: '/admin/account', icon: 'key', label: 'บัญชีของฉัน' },
      ...(canManageUsers(user) ? [{ href: '/admin/users', icon: 'lock', label: 'คนใช้งานระบบ' }] : []),
    ],
  },
] as { title: string; items: { href: string; icon: string; label: string; external?: boolean }[] }[];
---

<AdminLayout title="เมนู" active="more">
  <p class="mb-4 text-lg">สวัสดี <strong>{user.name}</strong> <span class="text-base text-muted">({roleLabel[user.role]})</span></p>
  <div class="space-y-5 md:grid md:grid-cols-2 md:items-start md:gap-5 md:space-y-0 2xl:grid-cols-3">
    {groups.map((g) => (
      <section aria-labelledby={`g-${g.title}`}>
        <h2 id={`g-${g.title}`} class="mb-2 flex items-center gap-2 px-1 text-lg font-bold text-palm-900"><span class="h-5 w-1 rounded-full bg-palm-600" aria-hidden="true"></span>{g.title}</h2>
        <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
          {g.items.map((it) => (
            <li>
              <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined} class="flex min-h-14 items-center gap-3 px-4 py-2 active:bg-canvas">
                <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-palm-50 text-palm-700"><Icon name={it.icon as IconName} class="size-5" /></span>
                <span class="min-w-0 flex-1 text-base font-semibold">{it.label}</span>
                <Icon name="chevron" class="size-5 shrink-0 text-muted" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <details id="install" class="rounded-2xl border border-line bg-surface md:hidden">
      <summary class="flex min-h-14 cursor-pointer items-center gap-3 px-4 py-2 text-base font-semibold"><span class="grid size-10 shrink-0 place-items-center rounded-xl bg-palm-50 text-palm-700"><Icon name="phone" class="size-5" /></span>ติดตั้งเป็นแอปบนหน้าจอมือถือ</summary>
      <div class="space-y-2 border-t border-line p-4 text-sm">
        <p><strong>iPhone:</strong> เปิดด้วย Safari → กดปุ่มแชร์ → เลือก "เพิ่มไปยังหน้าจอโฮม"</p>
        <p><strong>Android:</strong> เปิดด้วย Chrome → กดจุดสามจุดมุมขวาบน → เลือก "เพิ่มลงในหน้าจอหลัก"</p>
      </div>
    </details>
    <form method="post" action="/admin/logout" data-confirm="ออกจากระบบใช่ไหม?" class="md:hidden">
      <button class="flex min-h-14 w-full items-center justify-center rounded-2xl border border-line bg-surface font-semibold text-danger active:bg-red-50" type="submit">ออกจากระบบ</button>
    </form>
  </div>
</AdminLayout>

<script>
  // เปิดจากไอคอนบนหน้าจอโฮมอยู่แล้ว → ไม่ต้องแสดงวิธีติดตั้ง
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone;
  if (standalone) document.getElementById('install')?.remove();
</script>
