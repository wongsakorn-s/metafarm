---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../lib/icons.ts';
import { isOwner, roleLabel } from '../../lib/permissions.ts';

// "เมนู" ของมือถือ: หน้ารองทั้งหมดรวมไว้ที่เดียว (เดิมตั้งค่า/บัญชี/ออกจากระบบ อัดอยู่แถบบนจนตัวอักษรตกบรรทัด)
export const prerender = false;
const user = Astro.locals.user!;
const owner = isOwner(user);

const groups = [
  {
    title: 'งานรัง',
    items: [
      { href: '/admin/production', icon: 'chart', label: 'ผลผลิต + สภาพอากาศ', hint: 'น้ำผึ้ง การขยายรัง เทียบฝนและอุณหภูมิ' },
      { href: '/admin/hives/new', icon: 'plus', label: 'เพิ่มรังใหม่' },
      { href: '/admin/photos', icon: 'camera', label: 'คิวถ่ายรูปรัง', hint: 'รังที่ยังไม่มีรูปสมุดพก' },
      { href: '/admin/todo', icon: 'note', label: 'ข้อมูลที่ยังไม่ครบ (???)' },
      { href: '/admin/outbox', icon: 'status', label: 'รอส่ง (บันทึกตอนสัญญาณไม่ดี)', hint: 'รายการที่ยังเก็บอยู่ในเครื่องนี้' },
    ],
  },
  ...(owner ? [] : [{ title: 'น้ำผึ้ง', items: [{ href: '/admin/lots', icon: 'honey', label: 'ล็อตน้ำผึ้ง', hint: 'สร้างล็อต บรรจุขวด พิมพ์ฉลาก' }] }]),
  {
    title: 'เว็บไซต์',
    items: [
      ...(owner ? [
        { href: '/admin/readiness', icon: 'checklist', label: 'เตรียมเปิดเว็บ', hint: 'สิ่งที่ยังต้องเติมก่อนเปิดจริง' },
        { href: '/admin/settings', icon: 'settings', label: 'ช่องทางติดต่อ และหลักสูตรอบรม' },
      ] : []),
      { href: '/', icon: 'globe', label: 'ดูหน้าเว็บสาธารณะ', external: true },
    ],
  },
  {
    title: 'บัญชี',
    items: [
      { href: '/admin/account', icon: 'key', label: 'บัญชีและรหัสผ่าน', hint: user.email },
      ...(owner ? [{ href: '/admin/users', icon: 'users', label: 'ผู้ใช้และสิทธิ์', hint: 'เพิ่มพนักงาน ปิดบัญชี รีเซ็ตรหัส' }] : []),
    ],
  },
] as { title: string; items: { href: string; icon: string; label: string; hint?: string; external?: boolean }[] }[];
---

<AdminLayout title="เมนู" active="more">
  <p class="mb-4 text-muted">เข้าสู่ระบบเป็น <strong class="text-ink">{user.name}</strong> ({roleLabel[user.role]})</p>
  <div class="space-y-5">
    {groups.map((g) => (
      <section aria-labelledby={`g-${g.title}`}>
        <h2 id={`g-${g.title}`} class="mb-2 px-1 text-sm font-semibold text-muted">{g.title}</h2>
        <ul class="divide-y divide-line overflow-hidden rounded-2xl border border-line bg-surface">
          {g.items.map((it) => (
            <li>
              <a href={it.href} target={it.external ? '_blank' : undefined} rel={it.external ? 'noopener' : undefined} class="flex min-h-14 items-center gap-3 px-4 py-2 active:bg-canvas">
                <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-palm-50 text-palm-700"><Icon name={it.icon as IconName} class="size-5" /></span>
                <span class="min-w-0 flex-1"><span class="block font-medium">{it.label}</span>{it.hint && <span class="block truncate text-sm text-muted">{it.hint}</span>}</span>
                <Icon name="chevron" class="size-5 shrink-0 text-muted" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
    <section id="install" class="rounded-2xl border border-line bg-surface p-4" aria-labelledby="install-h">
      <h2 id="install-h" class="font-semibold">ติดตั้งเป็นแอปบนหน้าจอโฮม</h2>
      <p class="hint mb-2">เปิดได้เร็วจากไอคอน และรายการที่บันทึกตอนสัญญาณไม่ดีจะเก็บในเครื่องได้นานขึ้น (สำคัญกับ iPhone)</p>
      <ul class="space-y-1 text-sm">
        <li><strong>iPhone (Safari):</strong> กดปุ่มแชร์ (สี่เหลี่ยมมีลูกศรขึ้น) → "เพิ่มไปยังหน้าจอโฮม" — แอปบน iPhone เก็บข้อมูลแยกจาก Safari ถ้ามีรายการ "รอส่ง" ค้างอยู่ ให้ส่งให้หมดก่อนติดตั้ง และล็อกอินใหม่ในแอปหนึ่งครั้ง</li>
        <li><strong>Android (Chrome):</strong> กดเมนู ⋮ มุมขวาบน → "เพิ่มลงในหน้าจอหลัก" หรือ "ติดตั้งแอป"</li>
      </ul>
    </section>
    <form method="post" action="/admin/logout" data-confirm="ออกจากระบบใช่ไหม?">
      <button class="flex min-h-14 w-full items-center justify-center rounded-2xl border border-line bg-surface font-semibold text-danger active:bg-red-50" type="submit">ออกจากระบบ</button>
    </form>
  </div>
</AdminLayout>

<script>
  // เปิดจากไอคอนบนหน้าจอโฮมอยู่แล้ว → ไม่ต้องแสดงวิธีติดตั้ง
  const standalone = matchMedia('(display-mode: standalone)').matches || (navigator as Navigator & { standalone?: boolean }).standalone;
  if (standalone) document.getElementById('install')?.remove();
</script>
