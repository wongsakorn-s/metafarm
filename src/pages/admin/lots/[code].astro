---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getDb } from '../../../server/db.ts';
import { addBottling, getLot, honeyVariants } from '../../../server/lots.ts';
import { bottlingSchema, isLotCode, maxBottles } from '../../../lib/lots.ts';
import { fieldErrors, todayBangkok } from '../../../lib/validation.ts';
import { formatThaiDate } from '../../../lib/thai-date.ts';
import { fmt } from '../../../lib/chart.ts';
import { baht } from '../../../lib/labels.ts';

export const prerender = false;
const db = getDb();
const code = Astro.params.code ?? '';
if (!isLotCode(code)) return new Response('ไม่พบล็อต', { status: 404 });
const today = todayBangkok();
let errors: Record<string, string> = {};
let values: Record<string, string> = {};
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = Object.fromEntries([...form].filter(([, v]) => typeof v === 'string')) as Record<string, string>;
  const p = bottlingSchema.safeParse(values);
  if (!p.success) errors = fieldErrors(p.error);
  else {
    const r = await addBottling(db, Astro.locals.user!, code, p.data);
    if (r.ok) return Astro.redirect(`/admin/lots/${code}?saved=bottled`, 303);
    errors._ = r.error;
  }
}
const got = await getLot(db, code);
if (!got) return new Response('ไม่พบล็อต', { status: 404 });
const { lot, sources, bottled, remaining } = got;
const variants = await honeyVariants(db);
const hives = [...new Set(sources.map((s) => s.code))];
const saved = Astro.url.searchParams.get('saved');
const v = (k: string, d = '') => values[k] ?? d;
// ขวดที่บรรจุแล้ว รวมตามขนาด (สำหรับปุ่มพิมพ์ฉลาก)
const byVariant = [...bottled.reduce((m, b) => m.set(b.variantId, { label: `${b.product} · ${b.label}`, qty: (m.get(b.variantId)?.qty ?? 0) + b.qty, sold: b.sold }), new Map<number, { label: string; qty: number; sold: number }>())];
---

<AdminLayout back={{ href: '/admin/lots', label: 'ล็อตน้ำผึ้ง' }} title={`ล็อต ${lot.code}`} active="lots">
  {saved === 'created' && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900">สร้างล็อตแล้ว — บันทึกการบรรจุขวดด้านล่าง แล้วพิมพ์ฉลาก</p>}
  {saved === 'bottled' && <p role="status" class="mb-4 rounded-xl bg-palm-100 p-3 font-medium text-palm-900">บันทึกการบรรจุแล้ว — สต็อกในหน้าสินค้าเพิ่มให้แล้ว</p>}
  {errors._ && <p role="alert" class="mb-4 rounded-xl bg-red-50 p-3 font-medium text-danger">{errors._}</p>}

  <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-start">
    <div class="space-y-5">
      <section class="card grid grid-cols-3 divide-x divide-line !p-0 text-center" aria-label="สรุปล็อต">
        <div class="px-2 py-3"><p data-num class="text-xl font-bold">{fmt(lot.totalMl)}</p><p class="text-xs text-muted">มล. ทั้งหมด</p></div>
        <div class="px-2 py-3"><p data-num class="text-xl font-bold">{fmt(lot.totalMl - remaining)}</p><p class="text-xs text-muted">มล. บรรจุแล้ว</p></div>
        <div class="px-2 py-3"><p data-num class:list={['text-xl font-bold', remaining > 0 ? 'text-honey-700' : 'text-palm-700']}>{fmt(remaining)}</p><p class="text-xs text-muted">มล. ยังไม่บรรจุ</p></div>
      </section>

      <section class="card" aria-labelledby="src-h">
        <h2 id="src-h" class="mb-1 font-semibold">ที่มา: เก็บ {formatThaiDate(lot.harvestedFrom)}{lot.harvestedFrom !== lot.harvestedTo && ` – ${formatThaiDate(lot.harvestedTo)}`} จาก {hives.length} รัง</h2>
        <ul class="divide-y divide-line text-sm">
          {sources.map((s) => (
            <li class="flex items-center gap-3"><a class="inline-flex min-h-11 items-center font-semibold text-palm-700 underline" href={`/admin/hives/${s.code}`}>{s.code}</a><span class="text-muted">{formatThaiDate(s.occurredOn)}</span><span data-num class="ml-auto">{fmt(s.ml)} มล.</span></li>
          ))}
        </ul>
        {lot.note && <p class="mt-2 rounded-xl bg-canvas p-3 text-sm">{lot.note}</p>}
      </section>

      <section class="card" aria-labelledby="bt-h">
        <h2 id="bt-h" class="mb-1 font-semibold">การบรรจุขวด</h2>
        {bottled.length === 0 ? <p class="text-sm text-muted">ยังไม่ได้บรรจุ</p> : (
          <table class="w-full text-sm">
            <thead class="border-b border-line text-xs text-muted"><tr><th scope="col" class="py-1 text-left">วันที่ / ขนาด</th><th scope="col" class="text-right">ขวด</th><th scope="col" class="text-right">ต้นทุน/ขวด</th></tr></thead>
            <tbody class="divide-y divide-line" data-num>
              {bottled.map((b) => <tr><td class="py-2">{formatThaiDate(b.bottledOn)} · {b.label}{b.sizeMl ? ` ${b.sizeMl} มล.` : ''}</td><td class="text-right">{b.qty}</td><td class="text-right">{b.unitCost != null ? baht(b.unitCost) : '–'}</td></tr>)}
            </tbody>
          </table>
        )}
      </section>
    </div>

    <div class="space-y-5 lg:sticky lg:top-6">
      <form method="post" class="card space-y-3">
        <input type="hidden" name="idem" value={v('idem') || crypto.randomUUID()} />
        <h2 class="flex items-center gap-2 font-semibold"><Icon name="honey" class="size-5 text-palm-700" />บรรจุขวด</h2>
        {variants.length === 0 ? <p class="text-sm text-muted">ยังไม่มีสินค้าหมวดน้ำผึ้งที่ระบุขนาด มล. — เพิ่มได้ที่หน้าสินค้า</p> : (
          <>
            <div><label class="label" for="variantId">ขนาดขวด</label>
              <select class="field" id="variantId" name="variantId" required><option value="">เลือก…</option>
                {variants.map((x) => <option value={x.id} selected={v('variantId') === String(x.id)}>{x.label} · {x.sizeMl} มล. (บรรจุได้อีก {maxBottles(remaining, x.sizeMl!)} ขวด)</option>)}
              </select>{errors.variantId && <p class="error">{errors.variantId}</p>}</div>
            <div class="grid grid-cols-2 gap-3">
              <div><label class="label" for="qty">จำนวนขวด</label><input class="field" id="qty" name="qty" type="number" inputmode="numeric" min="1" required value={v('qty')} />{errors.qty && <p class="error">{errors.qty}</p>}</div>
              <div><label class="label" for="bottledOn">วันที่บรรจุ</label><input class="field" id="bottledOn" name="bottledOn" type="date" max={today} required value={v('bottledOn', today)} />{errors.bottledOn && <p class="error">{errors.bottledOn}</p>}</div>
            </div>
            <div><label class="label" for="unitCost">ต้นทุนต่อขวด (ขวด+ฉลาก, ไม่บังคับ)</label><input class="field" id="unitCost" name="unitCost" type="number" inputmode="numeric" min="0" value={v('unitCost')} placeholder="บาท" />{errors.unitCost && <p class="error">{errors.unitCost}</p>}<p class="hint">ใช้คิดกำไรในรายงาน · ไม่แสดงบนเว็บ</p></div>
            <button class="btn-primary w-full" type="submit" disabled={remaining <= 0}>บันทึกการบรรจุ (เพิ่มสต็อก)</button>
          </>
        )}
      </form>

      <section class="card space-y-2" aria-labelledby="lb-h">
        <h2 id="lb-h" class="font-semibold">ฉลาก QR</h2>
        {byVariant.length === 0 ? <p class="text-sm text-muted">บรรจุขวดก่อน แล้วพิมพ์ฉลากได้ที่นี่</p> : byVariant.map(([vid, x]) => (
          <a class="btn-ghost w-full justify-start" href={`/admin/lots/${lot.code}/labels?variant=${vid}&count=${x.qty}`} target="_blank" rel="noopener">พิมพ์ฉลาก {x.label} ({x.qty} ดวง)</a>
        ))}
        <a class="inline-flex min-h-11 items-center text-sm underline" href={`/lot/${lot.code}`} target="_blank" rel="noopener">ดูหน้าที่ลูกค้าเห็นเมื่อสแกน QR</a>
      </section>
    </div>
  </div>
</AdminLayout>
