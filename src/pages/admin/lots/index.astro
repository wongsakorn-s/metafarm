---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import SalesTabs from '../../../components/SalesTabs.astro';
import { getDb } from '../../../server/db.ts';
import { listLots, unassignedHarvests } from '../../../server/lots.ts';
import { formatThaiDate } from '../../../lib/thai-date.ts';
import { fmt } from '../../../lib/chart.ts';

// ล็อตน้ำผึ้ง: เก็บน้ำหวาน → สร้างล็อต → บรรจุขวด → พิมพ์ฉลาก QR → ขาย (ระบบผูกล็อตเก่าก่อนให้เอง)
export const prerender = false;
const db = getDb();
const [lots, pending] = await Promise.all([listLots(db), unassignedHarvests(db)]);
const pendingMl = pending.reduce((s, e) => s + (e.ml ?? 0), 0);
---

<AdminLayout title="ขาย" active="lots">
  <SalesTabs active="lots" />

  <section class="card mb-4 flex flex-col gap-3 sm:flex-row sm:items-center">
    <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-honey-50 text-honey-700"><Icon name="honey" class="size-6" /></span>
    <div class="flex-1">
      {pending.length > 0 ? (
        <p><strong>น้ำผึ้งที่ยังไม่อยู่ในล็อต: <span data-num>{fmt(pendingMl)}</span> มล.</strong> <span class="text-muted">จากการเก็บ {pending.length} ครั้ง</span></p>
      ) : (
        <p class="text-muted">การเก็บน้ำหวานทั้งหมดอยู่ในล็อตแล้ว — เก็บเพิ่มได้ที่ ➕ บันทึก → เก็บน้ำหวาน</p>
      )}
      <p class="hint">ล็อต = น้ำผึ้งที่กรองและบรรจุพร้อมกัน · รหัสล็อตพิมพ์บนฉลาก ลูกค้าสแกน QR ดูได้ว่าเก็บเมื่อไรจากรังไหน</p>
    </div>
    {pending.length > 0 && <a class="btn-primary shrink-0" href="/admin/lots/new"><Icon name="plus" class="size-5" />สร้างล็อต</a>}
  </section>

  {lots.length === 0 ? (
    <div class="flex flex-col items-center gap-2 rounded-3xl border border-dashed border-line bg-surface px-5 py-8 text-center">
      <p class="font-semibold">ยังไม่มีล็อตน้ำผึ้ง</p>
      <p class="max-w-sm text-sm text-muted">หลังเก็บน้ำหวานและกรองแล้ว สร้างล็อตจากการเก็บเหล่านั้น แล้วบันทึกการบรรจุขวด สต็อกในหน้าสินค้าจะเพิ่มให้เอง</p>
    </div>
  ) : (
    <ul class="grid gap-3 lg:grid-cols-2">
      {lots.map((l) => {
        const left = l.totalMl - l.bottledMl;
        return (
          <li><a href={`/admin/lots/${l.code}`} class="card-link flex flex-col gap-1">
            <span class="flex flex-wrap items-baseline gap-2"><span data-num class="text-lg font-bold">{l.code}</span><span class="text-sm text-muted">เก็บ {formatThaiDate(l.harvestedFrom)}{l.harvestedFrom !== l.harvestedTo && ` – ${formatThaiDate(l.harvestedTo)}`} · {l.hives} รัง</span></span>
            <span class="text-sm" data-num>{fmt(l.totalMl)} มล. · บรรจุแล้ว {fmt(l.bottles)} ขวด · ขายแล้ว {fmt(l.sold)} ขวด{left > 0 && <span class="text-honey-700"> · ยังไม่บรรจุ {fmt(left)} มล.</span>}</span>
          </a></li>
        );
      })}
    </ul>
  )}
</AdminLayout>
