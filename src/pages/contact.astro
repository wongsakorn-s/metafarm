---
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons.ts';
import PublicLayout from '../layouts/PublicLayout.astro';
import { businessLd } from '../lib/seo.ts';
import { site } from '../config/site.ts';
import { actionLabel, channelName, contactActions, type Channel } from '../lib/contact.ts';

export const prerender = false;

const c = Astro.locals.settings!.contact;
Astro.response.headers.set('Cache-Control', 'public, max-age=300');

// ช่องทางหลัก (เจ้าของเลือกในหลังบ้าน) = กรอบใหญ่ด้านบน · ช่องทางอื่นที่กรอกไว้ + เพจ Facebook = รายการด้านล่าง
const actions = contactActions(c);
const primary = actions[0];
const icon: Record<Channel, IconName> = { line: 'line', messenger: 'messenger', phone: 'phone' };
const tone: Record<Channel, string> = { line: 'text-brand-line', messenger: 'text-brand-messenger', phone: 'text-palm-700' };
const valueOf: Record<Channel, string> = { line: c.lineId, messenger: 'แชตกับเพจ MetaFarm', phone: c.phone };
const others = [
  ...actions.slice(1).map((a) => ({ icon: icon[a.channel], tone: tone[a.channel], label: channelName[a.channel], value: valueOf[a.channel], href: a.href, phone: a.channel === 'phone' })),
  ...(c.facebookUrl ? [{ icon: 'thumbs' as IconName, tone: 'text-brand-messenger', label: 'เพจ Facebook', value: 'ติดตามความรู้และภาพจากฟาร์ม', href: c.facebookUrl, phone: false }] : []),
];

const ext = (ch: Channel) => (ch === 'phone' ? {} : { rel: 'noopener' });
---

<PublicLayout title="ติดต่อเรา" description={`ติดต่อ ${site.name} สอบถามรังชันโรงขนเงิน น้ำผึ้ง และหลักสูตรอบรม ที่ ${site.address}`} active="contact" jsonLd={businessLd(site, c, Astro.url.origin)}>
  <PageHeader title="ติดต่อเรา" lead="สอบถามรังชันโรงขนเงิน น้ำผึ้ง หลักสูตรอบรม หรือนัดเข้าชมฟาร์ม" />

  {primary ? (
    <div class="mt-8">
      {/* "อยากถามเรื่องไหน" ตัดออกตามที่เจ้าของขอ (2026-10-10) — เหลือช่องทางหลัก + ช่องทางอื่น เต็มความกว้าง */}
      <section class="rounded-3xl bg-palm-50 p-5 sm:p-8" aria-labelledby="chat-h" data-contact-buttons>
        <div class="flex items-center gap-4" data-primary-channel={primary.channel}>
          <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-surface shadow-card"><Icon name={icon[primary.channel]} class:list={['size-7', tone[primary.channel]]} /></span>
          <div class="min-w-0">
            <p class="text-sm font-semibold text-palm-700">ช่องทางหลัก</p>
            <h2 id="chat-h" class="text-2xl font-bold text-palm-900">{channelName[primary.channel]}</h2>
            <p class="break-words text-muted">{valueOf[primary.channel]}</p>
          </div>
        </div>
        <p class="mt-4">สั่งซื้อ สอบถาม หรือนัดหมาย ติดต่อทางนี้ได้เลย</p>
        <a href={primary.href} {...ext(primary.channel)} data-channel={primary.channel} class="btn-primary mt-5 w-full font-semibold sm:w-auto">
          <Icon name={icon[primary.channel]} class="size-5" />{actionLabel(primary.channel)}
        </a>

        {others.length > 0 && (
          <>
            <h3 class="mt-8 text-sm font-semibold text-muted">ช่องทางอื่น</h3>
            <ul class="mt-2 grid gap-2 sm:grid-cols-2">
              {others.map((o) => (
                <li>
                  <a href={o.href} {...(o.phone ? {} : { rel: 'noopener' })} class="card-link flex h-full items-center gap-3 py-3">
                    <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-palm-50"><Icon name={o.icon} class:list={['size-5', o.tone]} /></span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm text-muted">{o.label}</span>
                      <span class="block break-words font-semibold">{o.value}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </section>

    </div>
  ) : (
    <p class="card mt-8 text-muted">ยังไม่ได้ตั้งช่องทางติดต่อ</p>
  )}

  <section class="mt-6 rounded-3xl border border-line bg-surface p-5 shadow-card sm:p-8" aria-labelledby="addr-h">
    <div class="flex flex-col gap-5 md:flex-row md:items-center">
      <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name="pin" class="size-7" /></span>
      <div class="min-w-0 flex-1">
        <h2 id="addr-h" class="text-xl font-bold text-palm-900">ที่ตั้งฟาร์ม</h2>
        <p class="mt-1 text-lg">{site.name} · {site.address}</p>
        <p class="mt-2 flex items-start gap-2 text-[0.9375rem] text-muted"><Icon name="info" class="mt-0.5 size-5 shrink-0" />ต้องการเข้าชมฟาร์มหรือรับสินค้าที่ฟาร์ม กรุณานัดล่วงหน้าก่อนมา</p>
      </div>
      {c.mapUrl && <a class="btn-ghost w-full shrink-0 md:w-auto" href={c.mapUrl} rel="noopener noreferrer"><Icon name="map" class="size-5" />เปิดแผนที่นำทาง</a>}
    </div>
  </section>
</PublicLayout>
