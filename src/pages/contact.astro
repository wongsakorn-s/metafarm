---
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons.ts';
import PublicLayout from '../layouts/PublicLayout.astro';
import { businessLd } from '../lib/seo.ts';
import { site } from '../config/site.ts';
import { lineChatUrl, telHref } from '../lib/settings.ts';
import { messengerBase } from '../lib/contact.ts';

export const prerender = false;

const c = Astro.locals.settings!.contact;
const line = lineChatUrl(c, 'สอบถามข้อมูล');
const tel = telHref(c.phone);
const messenger = messengerBase(c);
// ช่องทางหลัก (เจ้าของเลือกในหลังบ้าน) ขึ้นก่อน พร้อมป้าย "ช่องทางหลัก"
const PRIMARY_NOTE = 'ช่องทางหลัก — สั่งซื้อ สอบถาม นัดหมาย';
Astro.response.headers.set('Cache-Control', 'public, max-age=300');

const chat = [
  messenger && { key: 'messenger', icon: 'messenger', label: 'Messenger', value: 'แชตกับ MetaFarm', href: messenger, note: '' },
  line && { key: 'line', icon: 'line', label: 'LINE', value: c.lineId, href: line, note: '' },
  tel && { key: 'phone', icon: 'phone', label: 'โทรศัพท์', value: c.phone, href: tel, note: '' },
].filter(Boolean) as { key: string; icon: IconName; label: string; value: string; href: string; note: string }[];
chat.sort((a, b) => Number(b.key === c.primary) - Number(a.key === c.primary));
if (chat[0]) chat[0].note = PRIMARY_NOTE;
const channels = [
  ...chat,
  c.facebookUrl && { key: 'facebook', icon: 'thumbs', label: 'Facebook', value: 'เพจ MetaFarm', href: c.facebookUrl, note: 'ติดตามความรู้และภาพจากฟาร์ม' },
].filter(Boolean) as { icon: IconName; label: string; value: string; href: string; note: string }[];
---

<PublicLayout title="ติดต่อเรา" description={`ติดต่อ ${site.name} สอบถามรังชันโรงขนเงิน น้ำผึ้ง และหลักสูตรอบรม ที่ ${site.address}`} active="contact" jsonLd={businessLd(site, Astro.locals.settings!.contact, Astro.url.origin)}>
  <h1 class="text-3xl font-bold md:text-4xl">ติดต่อเรา</h1>
  <p class="mt-2 max-w-2xl text-lg text-muted">สอบถามรังชันโรงขนเงิน น้ำผึ้ง และหลักสูตรอบรม ได้ตามช่องทางด้านล่าง</p>

  <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {channels.map((ch) => (
      <li>
        <a href={ch.href} rel="noopener" class="card-link flex items-center gap-4">
          <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name={ch.icon} class="size-6" /></span>
          <span><span class="block text-sm text-muted">{ch.label}</span><span class="block text-lg font-semibold">{ch.value}</span>{ch.note && <span class="block text-sm text-muted">{ch.note}</span>}</span>
        </a>
      </li>
    ))}
  </ul>

  <section class="card mt-6 flex flex-col gap-4 md:flex-row md:items-center" aria-labelledby="addr-h">
    <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name="pin" class="size-6" /></span>
    <div class="flex-1">
      <h2 id="addr-h" class="text-lg font-semibold">ที่ตั้งฟาร์ม</h2>
      <p>{site.name} · {site.address}</p>
      <p class="hint">หากต้องการเข้าชมฟาร์มหรือรับสินค้าที่ฟาร์ม กรุณาติดต่อล่วงหน้า</p>
    </div>
    {c.mapUrl && <a class="btn-ghost shrink-0" href={c.mapUrl} rel="noopener noreferrer"><Icon name="map" class="size-5" />เปิดแผนที่</a>}
  </section>
</PublicLayout>
