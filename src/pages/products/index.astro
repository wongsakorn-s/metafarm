---
import PageHeader from '../../components/PageHeader.astro';
import Icon from '../../components/Icon.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import HiveCard from '../../components/HiveCard.astro';
import HowToOrder from '../../components/HowToOrder.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getDb } from '../../server/db.ts';
import { getPublicProducts, getSaleHives } from '../../server/public.ts';
import { priceRange } from '../../lib/products.ts';
import { site } from '../../config/site.ts';

export const prerender = false;

const db = getDb();
const [saleHives, products] = await Promise.all([getSaleHives(db), getPublicProducts(db)]);
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=120');
const queueMessage = 'สนใจจองคิวรังชันโรงขนเงินชุดถัดไป';
---

<PublicLayout title="สินค้า" description={`รังสมบูรณ์ชันโรงขนเงิน รังเปล่ารังไม้สัก และน้ำผึ้งชันโรง จาก ${site.name} จ.ระยอง`} active="products">
  <PageHeader title="สินค้า">รังชันโรงขนเงินและน้ำผึ้งชันโรงขนเงิน จาก {site.name}</PageHeader>

  <section class="mt-8" aria-labelledby="hives-h">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 id="hives-h" class="text-2xl font-bold"><Icon name="hive" class="inline-block size-[1.15em] align-[-0.2em]" /> รังสมบูรณ์ชันโรงขนเงิน</h2>
      {saleHives.length > 0 && <a class="inline-flex min-h-11 items-center text-palm-700 underline" href="/products/hives">ดูทั้งหมด ({saleHives.length} รัง) →</a>}
    </div>
    <p class="mt-1 text-muted">รังที่มีชันโรงพร้อมเลี้ยง ทุกรังมีสมุดพก เพื่อพัฒนาสายพันธุ์และส่งต่อที่มาให้ลูกค้า</p>
    {saleHives.length === 0 ? (
      <div class="mt-4 flex flex-col items-center gap-4 rounded-3xl border border-dashed border-palm-500/40 bg-palm-50/60 px-5 py-7 text-center md:flex-row md:text-left">
        <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-surface text-palm-700 shadow-card"><Icon name="hive" class="size-7" /></span>
        <div class="flex-1">
          <p class="text-lg font-semibold">ขณะนี้ยังไม่มีรังที่เปิดขาย</p>
          <p class="text-muted">รังชุดถัดไปกำลังเลี้ยงให้แข็งแรง ทักแชตหรือโทรจองคิวไว้ก่อนได้ หรือดูประวัติรังของฟาร์มในสมุดพก</p>
        </div>
        <div class="flex flex-wrap justify-center gap-2">
          <ContactButtons intent="queue" show="primary" message={queueMessage} />
          <a class="btn-ghost" href="/passport"><Icon name="passport" class="size-5" />ดูสมุดพกรัง</a>
        </div>
      </div>
    ) : (
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{saleHives.slice(0, 3).map((h, i) => <li><HiveCard hive={h} eager={i === 0} /></li>)}</ul>
    )}
  </section>

  <section class="mt-10" aria-labelledby="more-h">
    <h2 id="more-h" class="text-2xl font-bold">สินค้าอื่น ๆ</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {products.map((p, i) => (
        <li><ProductCard product={p} price={priceRange(p.variants.map((v) => v.priceThb))} variants eager={saleHives.length === 0 && i === 0} /></li>
      ))}
    </ul>
  </section>

  <div class="mt-10"><HowToOrder /></div>
</PublicLayout>
