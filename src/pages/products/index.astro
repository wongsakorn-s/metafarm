---
import PublicLayout from '../../layouts/PublicLayout.astro';
import HiveCard from '../../components/HiveCard.astro';
import HowToOrder from '../../components/HowToOrder.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import { getDb } from '../../server/db.ts';
import { getPublicProducts, getSaleHives } from '../../server/public.ts';
import { formatPrice, sizeLabel } from '../../lib/products.ts';
import { placeholder } from '../../lib/placeholders.ts';
import { site } from '../../config/site.ts';

export const prerender = false;

const db = getDb();
const [saleHives, products] = await Promise.all([getSaleHives(db), getPublicProducts(db)]);
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=120');
const range = (p: (typeof products)[number]) => {
  const prices = p.variants.map((v) => v.priceThb);
  const lo = Math.min(...prices), hi = Math.max(...prices);
  return lo === hi ? formatPrice(lo) : `${formatPrice(lo)} – ${formatPrice(hi)}`;
};
---

<PublicLayout title="สินค้า" description={`รังสมบูรณ์ชันโรงขนเงิน รังเปล่ารังไม้สัก และน้ำผึ้งชันโรง จาก ${site.name} จ.ระยอง`} active="products">
  <h1 class="text-3xl font-bold">สินค้า</h1>
  <p class="mt-2 max-w-2xl text-muted">รังชันโรงขนเงินและผลิตภัณฑ์จากฟาร์ม {site.name} สั่งซื้อทางไลน์</p>

  <section class="mt-8" aria-labelledby="hives-h">
    <div class="flex flex-wrap items-end justify-between gap-2">
      <h2 id="hives-h" class="text-2xl font-bold">🐝 รังสมบูรณ์ชันโรงขนเงิน</h2>
      {saleHives.length > 0 && <a class="text-palm-700 underline" href="/products/hives">ดูทั้งหมด ({saleHives.length} รัง) →</a>}
    </div>
    <p class="mt-1 text-muted">รังที่มีชันโรงพร้อมเลี้ยง ทุกรังมีสมุดพกให้ตรวจสอบประวัติ</p>
    {saleHives.length === 0 ? (
      <div class="card mt-4 text-muted">ขณะนี้ยังไม่มีรังที่เปิดขาย ทักไลน์สอบถามคิวรังชุดถัดไปได้</div>
    ) : (
      <ul class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{saleHives.slice(0, 3).map((h, i) => <li><HiveCard hive={h} eager={i === 0} /></li>)}</ul>
    )}
  </section>

  <section class="mt-10" aria-labelledby="more-h">
    <h2 id="more-h" class="text-2xl font-bold">สินค้าอื่น ๆ</h2>
    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {products.map((p, i) => (
        <li>
          <a href={`/products/${p.slug}`} class="card block overflow-hidden !p-0 transition hover:border-palm-500">
            <img src={p.imageKey ? `/img/${p.imageKey}` : p.category === 'honey' ? placeholder.honey : placeholder.hiveBox} alt="" loading={saleHives.length === 0 && i === 0 ? 'eager' : 'lazy'} width="800" height="450" class="aspect-[16/9] w-full bg-palm-50 object-cover" />
            <div class="p-4">
              <h3 class="text-lg font-bold">{p.name}</h3>
              <p class="text-xl font-bold text-palm-700">{range(p)}</p>
              <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-muted">
                {p.variants.map((v) => <span>{v.label}{sizeLabel(v.sizeMl) ? ` ${sizeLabel(v.sizeMl)}` : ''}</span>)}
                {p.variants.some((v) => v.priceIsSample) && <SampleBadge />}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="mt-10"><HowToOrder /></div>
</PublicLayout>
