---
import Icon from '../../components/Icon.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import HowToOrder from '../../components/HowToOrder.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import { getDb } from '../../server/db.ts';
import { getPublicProducts } from '../../server/public.ts';
import { formatPrice, orderMessage, pricePer100ml, SHIPPING_NOTE, stockLabel, variantName } from '../../lib/products.ts';
import { site } from '../../config/site.ts';
import { placeholder } from '../../lib/placeholders.ts';
import { photoSrcset, thumbUrl } from '../../lib/media.ts';
import NotFound from '../../components/NotFound.astro';
import { breadcrumbLd, productLd } from '../../lib/seo.ts';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const product = (await getPublicProducts(getDb(), slug))[0];
if (!product) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, max-age=60');

const image = product?.imageKey ? `/img/${product.imageKey}` : product?.category === 'honey' ? placeholder.honey : placeholder.hiveBox;
const cheapest = product ? Math.min(...product.variants.map((v) => v.priceThb)) : 0;
// ราคาตัวอย่างไม่ใส่ในคำอธิบาย (ผลค้นหา/การแชร์) — ไม่มีป้าย "ราคาตัวอย่าง" กำกับเหมือนบนหน้าเว็บ
const anySample = product?.variants.some((v) => v.priceIsSample) ?? false;
const jsonLd = product
  ? [
      productLd(
        { name: product.name, description: product.description, url: `/products/${product.slug}`, image, brand: site.name },
        product.variants.map((v) => ({ name: variantName(v.label, v.sizeMl, ' '), priceThb: v.priceThb, confirmed: !v.priceIsSample, inStock: v.inStock })),
        Astro.url.origin,
      ),
      breadcrumbLd([['หน้าแรก', '/'], ['สินค้า', '/products'], [product.name, `/products/${product.slug}`]], Astro.url.origin),
    ]
  : undefined;
---

{!product ? (
  <PublicLayout title="ไม่พบสินค้า" active="products" noindex>
    <NotFound icon="honey" title="ไม่พบสินค้านี้" href="/products" linkLabel="ดูสินค้าทั้งหมด" />
  </PublicLayout>
) : (
  <PublicLayout title={product.name} description={anySample ? (product.description ?? product.name) : `${product.description ?? product.name} ราคาเริ่มต้น ${formatPrice(cheapest)}`} lineMessage={orderMessage(product.name)} active="products" ogImage={product.imageKey ? image : undefined} jsonLd={jsonLd}>
    <p class="mb-2 text-sm text-muted"><a class="inline-flex min-h-11 items-center underline" href="/products">← สินค้า</a></p>
    <div class="grid gap-6 md:grid-cols-[1fr_1.1fr]" data-gallery>
      <div data-zoom-group>
        {product.photos.length ? (
          <>
            <a href={`/img/${product.photos[0]!.key}`} data-zoom data-caption={product.name} aria-label={`ดูรูปสินค้า ${product.name} ขยาย`} class="relative block overflow-hidden rounded-2xl bg-palm-50 shadow-card md:aspect-square" data-gallery-main data-zoom-index="0">
              <img src={`/img/${product.photos[0]!.key}`} srcset={photoSrcset(`/img/${product.photos[0]!.key}`)} sizes="(min-width: 768px) 45vw, 100vw" alt={product.name} class="aspect-[4/3] w-full object-cover transition-opacity duration-150 md:aspect-square" data-gallery-img />
              <span aria-hidden="true" class="pointer-events-none absolute bottom-2 right-2 flex items-center gap-1.5 rounded-full bg-black/55 px-2.5 py-1 text-xs font-medium text-white backdrop-blur">
                <Icon name="search" class="size-3.5" /><span data-gallery-counter>{product.photos.length > 1 ? `1/${product.photos.length}` : 'ขยาย'}</span>
              </span>
            </a>
            {product.photos.length > 1 && (
              <ul class="scroll-fade mt-3 -mx-1 flex gap-2 overflow-x-auto px-1 pb-1 sm:mx-0 sm:grid sm:grid-cols-5 sm:overflow-visible sm:p-0" data-gallery-thumbs>
                {product.photos.map((ph, i) => (
                  <li class="shrink-0 sm:w-auto">
                    <a
                      href={`/img/${ph.key}`}
                      data-gallery-thumb
                      data-index={i}
                      data-src={`/img/${ph.key}`}
                      data-srcset={photoSrcset(`/img/${ph.key}`)}
                      data-alt={`รูปสินค้า ${product.name} รูปที่ ${i + 1}`}
                      data-caption={product.name}
                      class:list={[
                        'block overflow-hidden rounded-xl transition-all duration-150 focus-visible:outline-2 focus-visible:outline-palm-600',
                        i === 0 ? 'ring-2 ring-palm-600 ring-offset-2 ring-offset-surface opacity-100' : 'opacity-70 hover:opacity-100'
                      ]}
                      aria-label={`ดูรูปสินค้า ${product.name} รูปที่ ${i + 1}`}
                      aria-current={i === 0 ? 'true' : 'false'}
                    >
                      <img src={thumbUrl(`/img/${ph.key}`)} width="160" height="160" alt="" loading="lazy" class="aspect-square w-[72px] rounded-xl bg-palm-50 object-cover transition-transform duration-(--duration-base) hover:scale-105 sm:w-full" />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </>
        ) : (
          <img src={image} alt="" class="aspect-[4/3] w-full rounded-2xl bg-palm-50 object-cover md:aspect-square" />
        )}
      </div>
      <section>
        <h1 class="text-3xl font-bold">{product.name}</h1>
        {product.description && <p class="mt-2 text-lg text-muted">{product.description}</p>}

        <ul class="mt-5 space-y-3">
          {product.variants.map((v) => {
            const msg = (orderMessage(product.name, { variant: variantName(v.label, v.sizeMl, ' '), price: v.priceThb, sample: v.priceIsSample }));
            const stock = stockLabel(v.inStock);
            return (
              <li class="card">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h2 class="text-lg font-semibold">{variantName(v.label, v.sizeMl)}</h2>
                  <p data-num class="text-2xl font-bold text-palm-700">{formatPrice(v.priceThb)} <span class="block text-right text-xs font-normal text-muted">{SHIPPING_NOTE}</span></p>
                </div>
                <div class="mt-1 flex flex-wrap items-center gap-2 text-sm">
                  <span class:list={['badge', stock.tone]}>{stock.text}</span>
                  {v.priceIsSample && <SampleBadge />}
                  {v.sizeMl && <span class="text-muted">≈ {pricePer100ml(v.priceThb, v.sizeMl).toLocaleString('th-TH')} บาท / 100 มล.</span>}
                  {v.harvestYearBe && <span class="text-muted">เก็บเกี่ยวปี {v.harvestYearBe}</span>}
                </div>
                <ContactButtons class="mt-3" intent="order" show="primary" message={msg} />
              </li>
            );
          })}
        </ul>
        <p class="mt-4 text-sm text-muted">ราคา{SHIPPING_NOTE} · สอบถามสต็อกก่อนสั่ง</p>
      </section>
    </div>
    <div class="mt-10"><HowToOrder buttons={false} message={orderMessage(product.name)} /></div>
  </PublicLayout>
)}
