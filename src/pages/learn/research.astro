---
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Article from '../../components/Article.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getLearn } from '../../lib/content.ts';
import { formatThaiDate } from '../../lib/thai-date.ts';

export const prerender = false;

const page = getLearn('research')!;
const { Content, frontmatter: fm } = page;
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

{/* หน้านี้ตั้งใจไม่มีปุ่มสั่งซื้อและตัวเลขเงิน เพื่อไม่ให้ดูเหมือนอ้างสรรพคุณของสินค้า (ตัวตรวจ check:leaks บังคับกฎนี้) */}
<PublicLayout title={fm.title} description={fm.description} active="honey">
  <Breadcrumbs items={[{ label: 'หน้าแรก', href: '/' }, { label: 'น้ำผึ้งชันโรง', href: '/honey' }, { label: String(fm.title) }]} />
  <h1 class="text-3xl font-bold leading-snug text-palm-900 md:text-4xl">{fm.title}</h1>
  <Article headings={page.getHeadings()}><Content /></Article>
  {fm.checkedOn && <p class="mt-8 text-sm text-muted">ตรวจอ้างอิงล่าสุด {formatThaiDate(String(fm.checkedOn).slice(0, 10))}</p>}
</PublicLayout>
