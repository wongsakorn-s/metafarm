---
import PublicLayout from '../../layouts/PublicLayout.astro';
import SampleBadge from '../../components/SampleBadge.astro';
import { getTraining } from '../../lib/content.ts';
import { formatPrice } from '../../lib/products.ts';
import { effectiveCourse, lineChatUrl } from '../../lib/settings.ts';

export const prerender = false;

const slug = Astro.params.slug ?? '';
const course = getTraining(slug);
if (!course) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
const fm = course?.frontmatter ?? {};
const settings = Astro.locals.settings!;
// ราคา/ระยะเวลาที่เจ้าของฟาร์มแก้ในหลังบ้านชนะค่าในไฟล์ Markdown
const eff = effectiveCourse({ priceThb: Number(fm.priceThb ?? 0), duration: String(fm.duration ?? ''), priceIsSample: fm.priceIsSample !== false }, settings.courses[slug]);
const line = course ? lineChatUrl(settings.contact, `สนใจหลักสูตร${fm.title}`) : null;
---

{!course ? (
  <PublicLayout title="ไม่พบหลักสูตร" active="training" noindex>
    <section class="mx-auto max-w-md py-10 text-center">
      <h1 class="text-2xl font-bold">ไม่พบหลักสูตรนี้</h1>
      <a class="btn-primary mt-5" href="/training">ดูหลักสูตรทั้งหมด</a>
    </section>
  </PublicLayout>
) : (
  <PublicLayout title={fm.title} description={fm.summary} active="training" lineMessage={`สนใจหลักสูตร${fm.title}`}>
    <p class="mb-2 text-sm text-muted"><a class="inline-flex min-h-11 items-center underline" href="/training">← อบรม</a></p>
    <h1 class="text-3xl font-bold md:text-4xl">{fm.title}</h1>
    <p class="mt-2 max-w-2xl text-lg text-muted">{fm.summary}</p>

    <dl class="card mt-5 grid max-w-md grid-cols-[auto_1fr] gap-x-4 gap-y-2">
      <dt class="text-muted">ระยะเวลา</dt><dd>{eff.duration}</dd>
      <dt class="text-muted">ค่าอบรม</dt><dd class="font-semibold text-palm-700">{formatPrice(eff.priceThb)} {eff.priceIsSample && <SampleBadge />}</dd>
      <dt class="text-muted">รอบอบรม</dt><dd>แจ้งทางไลน์</dd>
    </dl>
    {line && <a class="btn-primary mt-4" href={line} rel="noopener">💬 สอบถามและสมัครทางไลน์</a>}

    <div class="prose-mf mt-8"><course.Content /></div>
  </PublicLayout>
)}
