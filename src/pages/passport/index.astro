---
import PageHeader from '../../components/PageHeader.astro';
import HiveTile from '../../components/HiveTile.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getDb } from '../../server/db.ts';
import { getFarmStats, getSampleHives, hiveCategoryTitle, HIVE_CATEGORIES, listHivesByCategory, searchHiveCodes, type HiveCategory } from '../../server/public.ts';
import { site } from '../../config/site.ts';
import { normalizeHiveCode } from '../../lib/hive-code.ts';

export const prerender = false;

const db = getDb();
const stats = await getFarmStats(db);
const raw = (Astro.url.searchParams.get('code') ?? '').trim();
// พิมพ์ "a25" / "B 12" / "g-108" ก็หาเจอ · พิมพ์แค่เลข "12" = รังเลข 12 ทุกชุดตัวอักษร (เจอรังเดียวก็เปิดเลย)
const normalized = normalizeHiveCode(raw) ?? raw.toUpperCase().replace(/[\s-]+/g, '');

let matches: string[] = [];
if (normalized) {
  matches = await searchHiveCodes(db, normalized, 12);
  if (matches.includes(normalized)) return Astro.redirect(`/passport/${normalized}`, 302);
  if (/^\d+$/.test(normalized) && matches.length === 1) return Astro.redirect(`/passport/${matches[0]}`, 302);
}
// แตะตัวเลขหน้าแรก (?view=…) → รายการรังของหมวดนั้นทั้งหมด แทนตัวอย่างสุ่ม 8 รัง (เจ้าของขอ 2026-10-20)
const viewParam = Astro.url.searchParams.get('view') ?? '';
const view = (HIVE_CATEGORIES as readonly string[]).includes(viewParam) ? (viewParam as HiveCategory) : null;
const categoryHives = view ? await listHivesByCategory(db, view) : [];
const statusBadge = { active: ['ยังเลี้ยงอยู่', 'bg-palm-100 text-palm-900'], sold: ['ขายแล้ว', 'bg-honey-100 text-honey-700'], collapsed: ['รังล่ม', 'bg-slate-200 text-slate-700'] } as const;
// รังที่รูปและข้อมูลครบ สุ่มใหม่ทุกครั้ง (ไม่มีรังที่ครบ = ไม่แสดงส่วนนี้) — เฉพาะตอนไม่ได้เปิดด้วย ?view
const photoHives = view ? [] : await getSampleHives(db, 8);
// ไม่ cache: รังตัวอย่างสุ่มใหม่ทุกครั้งที่เปิดหน้า (รายการตามหมวดไม่สุ่ม แต่ก็ไม่ cache เพื่อให้ตัวเลขตรงกับหน้าแรกเสมอ)
Astro.response.headers.set('Cache-Control', 'no-cache');
---

<PublicLayout title="สมุดพกชันโรง" description={`ตรวจสอบประวัติรังชันโรงขนเงินของ ${site.name} ด้วยรหัสรัง: ที่มา สายพันธุ์รังแม่ และประวัติการดูแล`} active="passport">
  <section class="mx-auto max-w-xl text-center">
    <PageHeader center title="สมุดพกชันโรง" lead={`ทุกรังของ ${site.name} มีรหัสประจำรังและบันทึกประวัติ: ที่มา, นางพญา, สายพันธุ์รังแม่ และการดูแลต่าง ๆ`} />

    <form method="get" class="card mt-6 text-left" role="search">
      <label class="label" for="code">รหัสรัง</label>
      <div class="flex gap-2">
        <input class="field" id="code" name="code" inputmode="text" autocapitalize="characters" autocomplete="off" placeholder="เช่น A25 หรือ B12" value={raw} required />
        <button class="btn-primary shrink-0" type="submit">ค้นหา</button>
      </div>
      <p class="hint mt-2">พิมพ์รหัสที่ติดอยู่ที่รัง หรือสแกน QR บนรังเพื่อดูได้ทันที</p>
      {normalized && matches.length === 0 && <p class="error" role="alert">ไม่พบรหัส "{raw}" ลองตรวจตัวอักษรที่ติดอยู่ที่รังอีกครั้ง</p>}
      {matches.length > 0 && (
        <div class="mt-3">
          <p class="hint mb-2">รหัสที่ใกล้เคียง:</p>
          <ul class="flex flex-wrap gap-2">
            {matches.map((m) => <li><a class="inline-flex min-h-11 items-center rounded-xl bg-palm-50 px-3 font-semibold text-palm-700 hover:bg-palm-100" href={`/passport/${m}`}>{m}</a></li>)}
          </ul>
        </div>
      )}
    </form>
  </section>

  <nav aria-label="หมวดรัง" class="mx-auto mt-5 flex max-w-4xl flex-wrap justify-center gap-2 text-center lg:flex-nowrap">
      {([
        ['all', 'รังในทะเบียน', stats.total],
        ['bred', 'ขยายรังโดย MetaFarm', stats.bred],
        ['sold', 'ขายแล้ว', stats.sold],
        ['active', 'รังปัจจุบันในสวน', stats.active],
      ] as const).map(([key, label, n]) => (
        <a href={`/passport?view=${key}`} aria-current={view === key ? 'page' : undefined}
          class:list={['inline-flex min-h-11 items-center gap-2 rounded-full border px-4 text-sm font-medium', view === key ? 'border-palm-500 bg-palm-50 text-palm-900' : 'border-line bg-surface hover:bg-palm-50']}>
          {label} <span data-num class="font-bold text-palm-700">{n.toLocaleString('th-TH')}</span>
        </a>
      ))}
  </nav>

  {view && (
    <section class="mx-auto mt-10 max-w-5xl" aria-labelledby="category-h">
      <h2 id="category-h" class="text-center text-xl font-bold text-palm-700">{hiveCategoryTitle[view]} ({categoryHives.length})</h2>
      <p class="mt-1 text-center text-muted">กดที่รังเพื่อเปิดสมุดพก</p>
      <p class="mt-4 text-center"><a class="underline" href="/passport">← กลับไปค้นหาด้วยรหัสรัง</a></p>
      {categoryHives.length > 0 ? (
        <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 md:gap-4">
          {categoryHives.map((h) => (
            <li><HiveTile code={h.code} photoKey={h.key} badge={statusBadge[h.status as keyof typeof statusBadge]} /></li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-center text-muted">ยังไม่มีรังในหมวดนี้</p>
      )}
    </section>
  )}

  {photoHives.length > 0 && (
    <section class="mx-auto mt-10 max-w-4xl" aria-labelledby="examples">
      <h2 id="examples" class="text-center text-xl font-bold text-palm-700">ยังไม่มีรหัส? ลองดูรังในฟาร์ม</h2>
      <p class="mt-1 text-center text-muted">กดที่รูปเพื่อเปิดสมุดพกของรังนั้น</p>
      <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 md:gap-4">
        {photoHives.map((h) => (
          <li><HiveTile code={h.code} photoKey={h.key} hint /></li>
        ))}
      </ul>
    </section>
  )}

</PublicLayout>
