---
import Icon from '../../components/Icon.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getDb } from '../../server/db.ts';
import { getFarmStats, searchHiveCodes } from '../../server/public.ts';
import { site } from '../../config/site.ts';
import { normalizeHiveCode } from '../../lib/hive-code.ts';

export const prerender = false;

const db = getDb();
const raw = (Astro.url.searchParams.get('code') ?? '').trim();
// พิมพ์ "a25" / "B 12" / "g-108" ก็หาเจอ · พิมพ์แค่เลข "12" = รังเลข 12 ทุกชุดตัวอักษร (เจอรังเดียวก็เปิดเลย)
const normalized = normalizeHiveCode(raw) ?? raw.toUpperCase().replace(/[\s-]+/g, '');

let matches: string[] = [];
if (normalized) {
  matches = await searchHiveCodes(db, normalized, 12);
  if (matches.includes(normalized)) return Astro.redirect(`/passport/${normalized}`, 302);
  if (/^\d+$/.test(normalized) && matches.length === 1) return Astro.redirect(`/passport/${matches[0]}`, 302);
}
const stats = await getFarmStats(db);
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<PublicLayout title="สมุดพกชันโรง" description={`ตรวจสอบประวัติรังชันโรงขนเงินของ ${site.name} ด้วยรหัสรัง: ที่มา สายพันธุ์รังแม่ และประวัติการดูแล`} active="passport">
  <section class="mx-auto max-w-xl text-center">
    <h1 class="text-3xl font-bold text-palm-700"><Icon name="passport" class="inline-block size-[1.15em] align-[-0.2em]" /> สมุดพกชันโรง</h1>
    <p class="mt-2 text-muted">ทุกรังของ {site.name} มีรหัสประจำรังและบันทึกประวัติ: ที่มา, นางพญา, สายพันธุ์รังแม่ และการดูแลต่าง ๆ พิมพ์รหัสที่ติดอยู่ที่รัง หรือสแกน QR บนรังเพื่อดูได้ทันที</p>

    <form method="get" class="card mt-6 text-left" role="search">
      <label class="label" for="code">รหัสรัง</label>
      <div class="flex gap-2">
        <input class="field" id="code" name="code" inputmode="text" autocapitalize="characters" autocomplete="off" placeholder="เช่น A25 หรือ B12" value={raw} required autofocus />
        <button class="btn-primary shrink-0" type="submit">ค้นหา</button>
      </div>
      {normalized && matches.length === 0 && <p class="error" role="alert">ไม่พบรหัส "{raw}" ลองตรวจตัวอักษรที่ติดอยู่ที่รังอีกครั้ง</p>}
      {matches.length > 0 && (
        <div class="mt-3">
          <p class="hint mb-2">รหัสที่ใกล้เคียง:</p>
          <ul class="flex flex-wrap gap-2">
            {matches.map((m) => <li><a class="inline-flex min-h-11 items-center rounded-xl bg-palm-50 px-3 font-semibold text-palm-700 hover:bg-palm-100" href={`/passport/${m}`}>{m}</a></li>)}
          </ul>
        </div>
      )}
    </form>

    <dl class="mt-8 grid grid-cols-3 gap-3 text-center">
      <div class="card flex flex-col-reverse"><dt class="text-sm text-muted">รังในทะเบียน</dt><dd data-num class="text-2xl font-bold text-palm-700">{stats.total.toLocaleString('th-TH')}</dd></div>
      <div class="card flex flex-col-reverse"><dt class="text-sm text-muted">ยังเลี้ยงอยู่</dt><dd data-num class="text-2xl font-bold text-palm-700">{stats.active.toLocaleString('th-TH')}</dd></div>
      <div class="card flex flex-col-reverse"><dt class="text-sm text-muted">เพาะนางพญาเอง</dt><dd data-num class="text-2xl font-bold text-palm-700">{stats.queenBred.toLocaleString('th-TH')}</dd></div>
    </dl>
  </section>
</PublicLayout>
