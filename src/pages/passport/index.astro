---
import Icon from '../../components/Icon.astro';
import FarmStats from '../../components/FarmStats.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getDb } from '../../server/db.ts';
import { getFarmStats, getPhotoHives, searchHiveCodes } from '../../server/public.ts';
import { photoSrcset, thumbUrl } from '../../lib/media.ts';
import { site } from '../../config/site.ts';
import { normalizeHiveCode } from '../../lib/hive-code.ts';

export const prerender = false;

const db = getDb();
const raw = (Astro.url.searchParams.get('code') ?? '').trim();
// พิมพ์ "a25" / "B 12" / "g-108" ก็หาเจอ · พิมพ์แค่เลข "12" = รังเลข 12 ทุกชุดตัวอักษร (เจอรังเดียวก็เปิดเลย)
const normalized = normalizeHiveCode(raw) ?? raw.toUpperCase().replace(/[\s-]+/g, '');

let matches: string[] = [];
if (normalized) {
  matches = await searchHiveCodes(db, normalized, 12);
  if (matches.includes(normalized)) return Astro.redirect(`/passport/${normalized}`, 302);
  if (/^\d+$/.test(normalized) && matches.length === 1) return Astro.redirect(`/passport/${matches[0]}`, 302);
}
const [stats, photoHives] = await Promise.all([getFarmStats(db), getPhotoHives(db, 8)]);
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<PublicLayout title="สมุดพกชันโรง" description={`ตรวจสอบประวัติรังชันโรงขนเงินของ ${site.name} ด้วยรหัสรัง: ที่มา สายพันธุ์รังแม่ และประวัติการดูแล`} active="passport">
  <section class="mx-auto max-w-xl text-center">
    <h1 class="text-3xl font-bold text-palm-700"><Icon name="passport" class="inline-block size-[1.15em] align-[-0.2em]" /> สมุดพกชันโรง</h1>
    <p class="mt-2 text-muted">ทุกรังของ {site.name} มีรหัสประจำรังและบันทึกประวัติ: ที่มา, นางพญา, สายพันธุ์รังแม่ และการดูแลต่าง ๆ พิมพ์รหัสที่ติดอยู่ที่รัง หรือสแกน QR บนรังเพื่อดูได้ทันที</p>

    <form method="get" class="card mt-6 text-left" role="search">
      <label class="label" for="code">รหัสรัง</label>
      <div class="flex gap-2">
        <input class="field" id="code" name="code" inputmode="text" autocapitalize="characters" autocomplete="off" placeholder="เช่น A25 หรือ B12" value={raw} required />
        <button class="btn-primary shrink-0" type="submit">ค้นหา</button>
      </div>
      {normalized && matches.length === 0 && <p class="error" role="alert">ไม่พบรหัส "{raw}" ลองตรวจตัวอักษรที่ติดอยู่ที่รังอีกครั้ง</p>}
      {matches.length > 0 && (
        <div class="mt-3">
          <p class="hint mb-2">รหัสที่ใกล้เคียง:</p>
          <ul class="flex flex-wrap gap-2">
            {matches.map((m) => <li><a class="inline-flex min-h-11 items-center rounded-xl bg-palm-50 px-3 font-semibold text-palm-700 hover:bg-palm-100" href={`/passport/${m}`}>{m}</a></li>)}
          </ul>
        </div>
      )}
    </form>

  </section>

  {photoHives.length > 0 && (
    <section class="mx-auto mt-10 max-w-4xl" aria-labelledby="examples">
      <h2 id="examples" class="text-center text-xl font-bold text-palm-700">ยังไม่มีรหัส? ลองดูรังในฟาร์ม</h2>
      <p class="mt-1 text-center text-muted">กดที่รูปเพื่อเปิดสมุดพกของรังนั้น</p>
      <ul class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 md:gap-4">
        {photoHives.map((h) => (
          <li>
            <a href={`/passport/${h.code}`} class="group block overflow-hidden rounded-2xl border border-line bg-surface shadow-card">
              <img src={thumbUrl(`/img/${h.key}`)} srcset={photoSrcset(`/img/${h.key}`)} sizes="(min-width: 768px) 220px, 50vw" width="480" height="360" alt={`รังชันโรงขนเงิน ${h.code}`} loading="lazy" decoding="async"
                class="aspect-[4/3] w-full bg-palm-50 object-cover transition-transform duration-(--duration-base) group-hover:scale-105" />
              <span class="flex min-h-11 items-center justify-between gap-2 px-3 py-2">
                <span class="whitespace-nowrap font-semibold text-palm-700">รัง {h.code}</span>
                <span class="inline-flex shrink-0 items-center gap-1 text-sm text-muted"><Icon name="passport" class="size-4" /><span class="hidden md:inline">ดูสมุดพก</span></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <FarmStats stats={stats} class="mx-auto mt-10 max-w-xl" />
</PublicLayout>
