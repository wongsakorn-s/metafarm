---
import { isHiveCode, normalizeHiveCode } from '../../lib/hive-code.ts';
import Icon from '../../components/Icon.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getDb } from '../../server/db.ts';
import { getPublicHive } from '../../server/public.ts';
import { formatThaiDate } from '../../lib/thai-date.ts';
import { placeholder } from '../../lib/placeholders.ts';
import { GRID_COLS, photoSrcset, thumbUrl } from '../../lib/media.ts';
import { site } from '../../config/site.ts';
import NotFound from '../../components/NotFound.astro';
import { acquiredLabel, boxLabel, originText as originOf, speciesLabel } from '../../lib/labels.ts';
import { breadcrumbLd } from '../../lib/seo.ts';
import { posterKeyOf } from '../../lib/video.ts';

export const prerender = false;

const code = normalizeHiveCode(Astro.params.code) ?? (Astro.params.code ?? '').toUpperCase();
// /passport/a25 → /passport/A25 (URL เดียวต่อหนึ่งรัง ไม่ให้ Google เห็นหน้าซ้ำ)
if (isHiveCode(code) && Astro.params.code !== code) return Astro.redirect(`/passport/${code}`, 301);
const hive = isHiveCode(code) ? await getPublicHive(getDb(), code) : null;

if (!hive) {
  Astro.response.status = 404;
  Astro.response.headers.set('Cache-Control', 'public, max-age=60');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300');
}

const originText = hive ? originOf(hive.origin, hive.province, site.name) : '';
const totalMedia = (hive?.photos.length ?? 0) + (hive?.video ? 1 : 0);
const videoPoster = hive?.video?.key
  ? `/video/${posterKeyOf(hive.video.key)}`
  : hive?.video?.youtubeId
    ? `https://i.ytimg.com/vi/${hive.video.youtubeId}/hqdefault.jpg`
    : (hive?.photos[0] ? `/img/${hive.photos[0].key}` : placeholder.hive);

const statusBadge = hive && ({ active: ['ยังเลี้ยงอยู่', 'bg-palm-100 text-palm-900'], sold: ['ขายแล้ว', 'bg-honey-100 text-honey-700'], collapsed: ['รังล่ม', 'bg-slate-200 text-slate-700'] } as const)[hive.status as 'active'];

const eventLabel = { honey_harvest: ['honey', 'เก็บน้ำหวาน'], queen_cell_taken: ['queen', 'เก็บไข่นางพญา'], brood_split: ['brood', 'แยกไข่อ่อน/ตัวงานไปทำรังใหม่'], note: ['note', ''] } as const;
---

{!hive ? (
  <PublicLayout title="ไม่พบสมุดพก" active="passport" noindex>
    <NotFound title={`ไม่พบสมุดพกรัง ${code || ''}`} message="ตรวจสอบรหัสรังที่ติดอยู่ที่ตัวรัง (เช่น A25) แล้วลองใหม่" href="/passport" linkLabel="ค้นหารหัสรัง" />
  </PublicLayout>
) : (
  <PublicLayout
    title={`สมุดพกรัง ${hive.code}`}
    description={`ประวัติรังชันโรงขนเงิน ${hive.code} ของ ${site.name}: ${originText}${hive.acquiredOn ? ` · ได้มา ${formatThaiDate(hive.acquiredOn, hive.acquiredOnPrecision ?? 'day')}` : ''}`}
    lineMessage={`สอบถามเกี่ยวกับรัง ${hive.code}`}
    active="passport"
    canonical={`/passport/${hive.code}`}
    ogImage={hive.photos[0] ? `/img/${hive.photos[0].key}` : undefined}
    jsonLd={breadcrumbLd([['หน้าแรก', '/'], ['สมุดพกชันโรง', '/passport'], [`รัง ${hive.code}`, `/passport/${hive.code}`]], Astro.url.origin)}
  >
    <article>
      <p class="mb-2 text-sm text-muted"><a class="inline-flex min-h-11 items-center underline" href="/passport">← สมุดพกชันโรง</a></p>
      <header class="mb-5 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold text-palm-900">รัง {hive.code}</h1>
        {statusBadge && <span class:list={['badge text-sm', statusBadge[1]]}>{statusBadge[0]}</span>}
      </header>

      {/* คอม: รูปซ้าย (รูปหลักใหญ่ + รูปย่อ) · ข้อมูลขวา — เดิมรูปเดียววางกลางแถวโล่งครึ่งจอ
          มือถือ: เรียงลงตามปกติ */}
      <div class="grid gap-5 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-start" data-gallery>
        <section aria-label="รูปรัง" class="md:sticky md:top-24" data-zoom-group>
          {totalMedia > 0 ? (
            <>
              <div class="relative overflow-hidden rounded-2xl bg-palm-50 shadow-card aspect-[4/3]" data-gallery-stage>
                {hive.photos.length > 0 ? (
                  <a href={`/img/${hive.photos[0]!.key}`} data-zoom data-caption={`รัง ${hive.code}`} aria-label={`ดูรูปรัง ${hive.code} ขยาย`} class="relative block size-full" data-gallery-main data-zoom-index="0">
                    <img src={`/img/${hive.photos[0]!.key}`} srcset={photoSrcset(`/img/${hive.photos[0]!.key}`)} sizes="(min-width: 768px) 40vw, 100vw" width="800" height="600"
                      alt={hive.photos[0]!.alt && hive.photos[0]!.alt !== `รูปรัง ${hive.code}` ? hive.photos[0]!.alt : `รูปรัง ${hive.code} และสถานที่ตั้งในสวน`} loading="eager" fetchpriority="high" class="size-full object-cover transition-opacity duration-150" data-gallery-img />
                  </a>
                ) : null}

                {hive.video && (
                  <div
                    data-gallery-video
                    class:list={[
                      'absolute inset-0 size-full bg-black flex items-center justify-center',
                      hive.photos.length > 0 && 'hidden',
                    ]}
                  >
                    <VideoPlayer video={hive.video} title={`วิดีโอรัง ${hive.code}`} poster={videoPoster} fill />
                  </div>
                )}

                <button
                  type="button"
                  data-zoom
                  data-gallery-expand
                  data-zoom-index="0"
                  aria-label="ดูขยาย"
                  class="pointer-events-auto absolute bottom-2 right-2 z-10 flex min-h-11 items-center gap-1.5 rounded-full bg-black/60 px-3 py-2 text-xs font-medium text-white backdrop-blur transition-colors hover:bg-black/80 focus-visible:outline-2 focus-visible:outline-white"
                >
                  <Icon name="search" class="size-3.5" data-gallery-icon-search />
                  <Icon name="video" class="hidden size-3.5" data-gallery-icon-video />
                  <span data-gallery-counter>{totalMedia > 1 ? `1/${totalMedia}` : (hive.photos.length > 0 ? 'ขยาย' : 'วิดีโอ')}</span>
                </button>
              </div>

              {totalMedia > 1 && (
                <ul class:list={['scroll-fade mt-3 -mx-1 flex gap-2 overflow-x-auto px-1 pb-1 sm:mx-0 sm:grid sm:overflow-visible sm:p-0', GRID_COLS[totalMedia] ?? 'sm:grid-cols-6']} data-gallery-thumbs>
                  {hive.photos.map((ph, i) => (
                    <li class="shrink-0 sm:w-auto">
                      <a
                        href={`/img/${ph.key}`}
                        data-gallery-thumb
                        data-index={i}
                        data-src={`/img/${ph.key}`}
                        data-srcset={photoSrcset(`/img/${ph.key}`)}
                        data-caption={`รัง ${hive.code}`}
                        data-alt={ph.alt && ph.alt !== `รูปรัง ${hive.code}` ? ph.alt : (i === 0 ? `รูปรัง ${hive.code} และสถานที่ตั้งในสวน` : `รูปรัง ${hive.code} รูปที่ ${i + 1}`)}
                        aria-label={`ดูรูปรัง ${hive.code} รูปที่ ${i + 1}`}
                        aria-current={i === 0 ? 'true' : 'false'}
                        class:list={[
                          'block overflow-hidden rounded-xl transition-all duration-150 focus-visible:outline-2 focus-visible:outline-palm-600',
                          i === 0 ? 'ring-2 ring-palm-600 ring-offset-2 ring-offset-surface opacity-100' : 'opacity-70 hover:opacity-100'
                        ]}
                      >
                        <img src={thumbUrl(`/img/${ph.key}`)} width="160" height="160" alt="" loading="lazy" class="aspect-square w-[72px] rounded-xl bg-palm-50 object-cover transition-transform duration-(--duration-base) hover:scale-105 sm:w-full" />
                      </a>
                    </li>
                  ))}
                  {hive.video && (
                    <li class="shrink-0 sm:w-auto">
                      <a
                        href={hive.video.key ? `/video/${hive.video.key}` : `https://www.youtube.com/watch?v=${hive.video.youtubeId}`}
                        data-gallery-thumb
                        data-is-video="true"
                        data-index={hive.photos.length}
                        data-zoom-video={hive.video.key ? `/video/${hive.video.key}` : undefined}
                        data-src={videoPoster}
                        data-caption={`วิดีโอรัง ${hive.code}`}
                        data-alt={`วิดีโอรัง ${hive.code}`}
                        class:list={[
                          'group relative block overflow-hidden rounded-xl transition-all duration-150 focus-visible:outline-2 focus-visible:outline-palm-600',
                          hive.photos.length === 0 ? 'ring-2 ring-palm-600 ring-offset-2 ring-offset-surface opacity-100' : 'opacity-70 hover:opacity-100'
                        ]}
                        aria-label={`ดูวิดีโอรัง ${hive.code}`}
                        aria-current={hive.photos.length === 0 ? 'true' : 'false'}
                      >
                        <img src={videoPoster} width="160" height="160" alt="" loading="lazy" class="aspect-square w-[72px] rounded-xl bg-black object-cover transition-transform duration-(--duration-base) group-hover:scale-105 sm:w-full" />
                        <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/30 transition-colors group-hover:bg-black/20">
                          <span class="grid size-6 place-items-center rounded-full bg-black/60 text-white backdrop-blur sm:size-7">
                            <Icon name="video" class="ml-0.5 size-3.5 sm:size-4" />
                          </span>
                        </span>
                        <span class="pointer-events-none absolute bottom-1 right-1 rounded bg-black/75 px-1 py-0.5 text-[10px] font-medium leading-none text-white">
                          วิดีโอ
                        </span>
                      </a>
                    </li>
                  )}
                </ul>
              )}
            </>
          ) : (
            <div class="rounded-3xl border border-dashed border-line bg-surface p-4 text-center">
              <img src={placeholder.hive} alt="" width="800" height="600" class="mx-auto aspect-[4/3] w-full max-w-xs rounded-2xl" />
              <p class="hint">ยังไม่มีรูปของรังนี้</p>
            </div>
          )}
        </section>

        <div class="grid gap-5">
          <section class="card" aria-labelledby="facts-h">
            <h2 id="facts-h" class="mb-3 text-lg font-semibold">ข้อมูลรัง</h2>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
              <dt class="text-muted">สายพันธุ์</dt><dd>{speciesLabel(hive.species)}</dd>
              {originText && <><dt class="text-muted">ที่มา</dt><dd>{originText}</dd></>}
              {hive.boxType !== 'unknown' && <><dt class="text-muted">กล่องรัง</dt><dd>{boxLabel[hive.boxType]}</dd></>}
              {hive.acquiredOn && <><dt class="text-muted">{acquiredLabel(hive.origin)}</dt><dd>{formatThaiDate(hive.acquiredOn, hive.acquiredOnPrecision ?? 'day')}</dd></>}
              {hive.queenBornOn && <><dt class="text-muted">นางพญาเกิด</dt><dd>{formatThaiDate(hive.queenBornOn)}</dd></>}
            </dl>
            {hive.publicNote && <p class="mt-3 rounded-xl bg-honey-50 p-3 text-sm">{hive.publicNote}</p>}
          </section>

          <section class="card" aria-labelledby="line-h">
            <h2 id="line-h" class="mb-3 text-lg font-semibold">สายพันธุ์รัง</h2>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
              {/* กลับไปใช้ลิงก์ขีดเส้นใต้ธรรมดาเหมือน /products/hives/[code] — ปุ่มป้ายสีเขียว (min-h-11) ที่ลองเปลี่ยนไปก่อนหน้านี้สูงเกินแถวอื่นในการ์ดเดียวกัน ทำให้ส่วนบนดูเป็นปุ่มหนักๆ ส่วนล่าง (แยกขยายรัง/นางพญาเกิด) เป็นตัวหนังสือเฉยๆ ดูไม่สมดุล (เจ้าของส่งภาพหน้าจอมาให้ดู 2026-10-20 รอบ 2) */}
              <dt class="text-muted">ไข่นางพญาจาก</dt><dd>{hive.queenSource ? <a class="text-palm-700 underline" href={`/passport/${hive.queenSource}`}>รัง {hive.queenSource}</a> : <span class="text-muted">–</span>}</dd>
              <dt class="text-muted">ไข่อ่อนจาก</dt><dd>{hive.broodSource ? <a class="text-palm-700 underline" href={`/passport/${hive.broodSource}`}>รัง {hive.broodSource}</a> : <span class="text-muted">–</span>}</dd>
              <dt class="text-muted">รังลูก ({hive.children.length})</dt>
              <dd>{hive.children.length ? (
                <ul class="flex flex-wrap gap-x-3 gap-y-1">
                  {hive.children.map((c) => <li><a class="text-palm-700 underline" href={`/passport/${c.code}`}>รัง {c.code}</a></li>)}
                </ul>
              ) : <span class="text-muted">–</span>}</dd>
            </dl>
          </section>
        </div>
      </div>

      <section class="card mt-5" aria-labelledby="tl-h">
        <h2 id="tl-h" class="mb-3 text-lg font-semibold">ประวัติของรัง ({hive.events.length})</h2>
        {hive.events.length === 0 ? <p class="text-muted">ยังไม่มีประวัติที่บันทึกไว้</p> : (
          <ol class="divide-y divide-line">
            {hive.events.map((e) => (
              <li class="flex gap-3 py-3">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-palm-50 text-palm-700"><Icon name={eventLabel[e.type][0]} class="size-4" /></span>
                <div class="min-w-0 flex-1">
                  <p class="font-medium">{e.type === 'note' ? e.text : eventLabel[e.type][1]}
                    {e.targetCode && <span> → <a class="text-palm-700 underline" href={`/passport/${e.targetCode}`}>รัง {e.targetCode}</a></span>}</p>
                </div>
                <time class="shrink-0 text-sm text-muted" datetime={e.occurredOn}>{formatThaiDate(e.occurredOn, e.precision)}</time>
              </li>
            ))}
          </ol>
        )}
      </section>

      {/* ทางไปต่อสำหรับคนที่สแกน QR ที่รัง — ไม่บอกว่ารังนี้ขายอยู่หรือไม่ (for_sale เป็นข้อมูลภายใน ไม่แสดงในสมุดพก) */}
      <section class="card mt-5" aria-labelledby="next-h">
        <h2 id="next-h" class="font-semibold">อยากเลี้ยงชันโรงขนเงินแบบนี้?</h2>
        <p class="hint">รังที่ฟาร์มขายมีสมุดพกแบบนี้ทุกรัง · มีหลักสูตรอบรมการเลี้ยงและแยกขยายรัง</p>
        <div class="mt-3 grid gap-2 sm:grid-cols-2">
          <a class="btn-primary" href="/products">ดูสินค้าของฟาร์ม</a>
          <a class="btn-ghost" href="/training">หลักสูตรอบรม</a>
        </div>
      </section>

      <p class="mt-4 text-xs text-muted">ข้อมูลปรับปรุงล่าสุด {formatThaiDate(hive.updatedAt.slice(0, 10))} · บันทึกโดย {site.name}</p>
    </article>
  </PublicLayout>
)}
