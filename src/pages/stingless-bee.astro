---
import PageHeader from '../components/PageHeader.astro';
import Article from '../components/Article.astro';
import CreditPhoto from '../components/CreditPhoto.astro';
import Icon from '../components/Icon.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { getPage } from '../lib/content.ts';
import { learnPhotos as P } from '../lib/learn-photos.ts';

export const prerender = false;

const page = getPage('stingless-bee')!;
const { Content, frontmatter: fm } = page;
Astro.response.headers.set('Cache-Control', 'public, max-age=300');

// หน้านี้ห้ามมีคำว่าราคา/บาท (check:leaks)
const next = [
  { href: '/products/hives', icon: 'hive', title: 'รังชันโรงขนเงินพร้อมเลี้ยง', text: 'รังที่มีชันโรงอยู่แล้ว ดูประวัติแต่ละรังได้' },
  { href: '/products/hive-box', icon: 'wood', title: 'รังเปล่าไม้สัก', text: 'รังที่เราออกแบบเองสำหรับขนเงิน' },
  { href: '/training', icon: 'training', title: 'อบรมการขยายรัง', text: 'เรียนแยกรังและเพาะนางพญาที่ฟาร์ม' },
] as const;
const gallery = [P.beeGuards, P.beeNest, P.beeEntrance];
---

<PublicLayout title={fm.title} description={fm.description} active="stingless-bee" lineMessage="สนใจรังชันโรงขนเงิน">
  <Article headings={page.getHeadings()}>
    <Fragment slot="header">
      <PageHeader title={fm.title} sub="Tetragonula pagdeni Schwarz" lead={fm.lead} />
      <CreditPhoto photo={P.beePagdeni} priority sizes="(min-width: 1024px) 740px, 100vw" class="mt-6" />
    </Fragment>
    <Content />
  </Article>

  <section class="mt-14" aria-labelledby="pics-h">
    <h2 id="pics-h" class="text-2xl font-bold text-palm-900">ภาพชันโรงและรัง</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
      {gallery.map((ph) => <CreditPhoto crop photo={ph} sizes="(min-width: 1024px) 330px, (min-width: 640px) 33vw, 100vw" />)}
    </div>
  </section>

  <section class="mt-14" aria-labelledby="next-h">
    <h2 id="next-h" class="text-2xl font-bold text-palm-900">อยากเริ่มเลี้ยงชันโรงขนเงิน</h2>
    <ul class="mt-4 grid gap-3 md:grid-cols-3 md:gap-4">
      {next.map((n) => (
        <li>
          <a href={n.href} class="card-link flex h-full items-center gap-3 md:flex-col md:items-start">
            <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-palm-50 text-palm-700"><Icon name={n.icon} class="size-6" /></span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-palm-700">{n.title}</span>
              <span class="block text-[0.9375rem] text-muted">{n.text}</span>
            </span>
            <Icon name="chevron" class="size-5 shrink-0 text-palm-700 md:hidden" />
          </a>
        </li>
      ))}
    </ul>
  </section>
</PublicLayout>
