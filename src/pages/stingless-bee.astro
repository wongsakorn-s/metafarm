---
import PublicLayout from '../layouts/PublicLayout.astro';
import { getPage } from '../lib/content.ts';

export const prerender = false;

const page = getPage('stingless-bee')!;
const { Content, frontmatter: fm } = page;
Astro.response.headers.set('Cache-Control', 'public, max-age=300');
---

<PublicLayout title={fm.title} description={fm.description} active="stingless-bee" lineMessage="สนใจรังชันโรงขนเงิน">
  <h1 class="text-3xl font-bold md:text-4xl">{fm.title}</h1>
  <p class="mt-1 italic text-muted">Tetragonula pagdeni Schwarz</p>
  <div class="prose-mf mt-6"><Content /></div>
  <div class="mt-10 flex flex-wrap gap-3">
    <a class="btn-primary" href="/products/hives">🐝 ดูรังสมบูรณ์ที่เปิดขาย</a>
    <a class="btn-ghost" href="/passport">📒 สมุดพกชันโรง</a>
    <a class="btn-ghost" href="/training">🎓 อบรมการขยายรัง</a>
  </div>
</PublicLayout>
