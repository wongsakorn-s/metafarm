---
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { site } from '../config/site.ts';
import { GALLERY_CATEGORIES, galleryCategory } from '../lib/gallery.ts';
import { photoSrcset, thumbUrl } from '../lib/media.ts';
import { posterKeyOf } from '../lib/video.ts';
import { getDb } from '../server/db.ts';
import { getGallery } from '../server/public.ts';

// แกลเลอรี (เจ้าของฟาร์มขอ "Gallery" 2026-10-10 — ชื่อเมนูภาษาไทยให้เข้ากับเมนูอื่น): 4 หมวด · รูปจากหลังบ้าน /admin/gallery · หมวดที่ยังไม่มีรูป = กรอบรูปชั่วคราว
export const prerender = false;

const photos = await getGallery(getDb());
const sections = GALLERY_CATEGORIES.map((c) => ({ key: c, ...galleryCategory[c], photos: photos.filter((p) => p.category === c) }));
// สั้น: เจ้าของอัปโหลดแล้วกด "ดูหน้าแกลเลอรี" ต้องเห็นรูปใหม่ (เดิม 5 นาที เห็นหน้าเก่า)
Astro.response.headers.set('Cache-Control', 'public, max-age=60');
---

<PublicLayout title="แกลเลอรี" description={`ภาพจาก ${site.name}: ชันโรงขนเงินในสวนปาล์ม การส่งมอบรังและน้ำผึ้งชันโรง และห้องงานไม้ที่ทำรังไม้สัก`} active="gallery">
  <PageHeader title="แกลเลอรี" lead={`ภาพจากฟาร์ม ${site.name} ทั้งชันโรงของเรา การส่งมอบรังและน้ำผึ้งถึงลูกค้า และห้องงานไม้`} />

  <nav aria-label="หมวดรูป" class="mt-5 flex flex-wrap gap-2">
    {sections.map((s) => (
      <a href={`#${s.key}`} class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-surface px-4 font-medium hover:bg-palm-50">
        <Icon name={s.icon} class="size-5 text-palm-700" />{s.navLabel ?? s.label}
      </a>
    ))}
  </nav>

  {sections.map((s, si) => (
    <section id={s.key} class="mt-10 scroll-mt-20" aria-labelledby={`${s.key}-h`}>
      <h2 id={`${s.key}-h`} class="flex items-center gap-2 text-2xl font-bold"><Icon name={s.icon} class="size-6 text-palm-700" />{s.label}</h2>
      <p class="mt-1 text-muted">{s.hint}</p>
      {/* หมวดที่ยังไม่มีรูป: ข้อความสั้นกล่องเดียว (เดิมกรอบรูปว่าง 3 ช่อง ดูเหมือนเว็บเสีย — รีวิว UX 2026-10-18) */}
      {s.photos.length > 0 ? (
        <ul class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4" data-zoom-group>
          {s.photos.map((p, i) => (
            <li>
              <figure>
                {p.mediaType === 'video' ? (
                  <a href={`/video/${p.key}`} data-zoom data-zoom-video={`/video/${p.key}`} data-caption={p.caption ?? s.label} class="group relative block overflow-hidden rounded-2xl" aria-label={`ดูวิดีโอ: ${p.caption ?? s.label}`}>
                    <img src={`/video/${posterKeyOf(p.key)}`} width="800" height="600" loading={si === 0 && i < 2 ? 'eager' : 'lazy'} alt={p.caption ?? `${s.label} — ${site.name}`} class="aspect-[4/3] w-full bg-black object-cover transition-transform duration-(--duration-fast) group-hover:scale-[1.02]" />
                    <span class="pointer-events-none absolute inset-0 grid place-items-center bg-black/25 transition-colors group-hover:bg-black/35">
                      <span class="grid size-12 place-items-center rounded-full bg-white/90 text-palm-900 shadow-md backdrop-blur transition-transform group-hover:scale-110">
                        <Icon name="video" class="ml-0.5 size-6" />
                      </span>
                    </span>
                    <span class="pointer-events-none absolute bottom-2 left-2 rounded-full bg-black/60 px-2.5 py-0.5 text-xs font-semibold text-white backdrop-blur">วิดีโอ</span>
                  </a>
                ) : (
                  <a href={`/img/${p.key}`} data-zoom data-caption={p.caption ?? ''} class="block overflow-hidden rounded-2xl" aria-label={`ดูรูปขยาย: ${p.caption ?? s.label}`}>
                    <img src={thumbUrl(`/img/${p.key}`)} srcset={photoSrcset(`/img/${p.key}`)} sizes="(min-width: 768px) 33vw, 50vw" width="800" height="600"
                      loading={si === 0 && i < 2 ? 'eager' : 'lazy'} alt={p.caption ?? `${s.label} — ${site.name}`} class="aspect-[4/3] w-full bg-palm-50 object-cover transition-transform duration-(--duration-fast) hover:scale-[1.02]" />
                  </a>
                )}
                {p.caption && <figcaption class="mt-1 text-sm text-muted">{p.caption}</figcaption>}
              </figure>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 flex items-center gap-3 rounded-2xl border border-dashed border-line bg-surface px-4 py-5 text-muted">
          <Icon name="image" class="size-6 shrink-0 text-palm-700" />ยังไม่มีรูปในหมวดนี้ เรากำลังทยอยเพิ่มรูปจากฟาร์ม
        </p>
      )}
    </section>
  ))}
</PublicLayout>
