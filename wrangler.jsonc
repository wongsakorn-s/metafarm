{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "metafarm",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// D1 จริงบน Cloudflare (region APAC) — ในเครื่องยังใช้ .wrangler/state เหมือนเดิม (--local)
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "metafarm-db",
			"database_id": "bf382def-45df-4a0a-bcfb-193f4be3bfb2",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "metafarm-media"
		},
		{
			"bucket_name": "metafarm-backups",
			"binding": "metafarm_backups",
			"remote": true
		}
	]
}